vo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/wLrblAr2RRNaHJXJ6Gt1utNwyQAgpEUz.ogg"},{"description":"serina_cafe_monolog_2.ogg","category":"cafe","text":"我只是看着这个地方，就感觉心里暖暖的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/0yo9H3Q3xpwNQd0VrSV2zhN4aNFz5lLj.ogg"},{"description":"serina_cafe_monolog_3.ogg","category":"cafe","text":"在这种地方，患者应该也能更快痊愈吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/vb6JNILFu5QL39dUuXFKmHcCvHdgHsvX.ogg"},{"description":"serina_commonskill_b.ogg","category":"battle","text":"痛痛，痛痛，飞走啦~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/U3lAcg7bTeQgYOlaOAresT79v8PcpzUZ.ogg"},{"description":"serina_exskill_1.ogg","category":"battle","text":"哈...我已经为大家准备好啦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/oIC4mNXJRAaazMWw91cAhgpn9f7bKHsT.ogg"},{"description":"serina_exskill_2.ogg","category":"battle","text":"好嘞，补给送到啦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/6cDyPKC9yhdhUO0snMQ96vwO68fGEpC7.ogg"},{"description":"serina_exskill_3.ogg","category":"battle","text":"这是给大家的补给品！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/64go3w3rteHJIcltjHe0qPruxDK10gLc.ogg"},{"description":"serina_exskill_level_1.ogg","category":"battle","text":"请领取补给！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/Ld0wePbgDpU7Sn7j7zIU8bYYBLWQq5rI.ogg"},{"description":"serina_exskill_level_2.ogg","category":"battle","text":"请负伤的人先领！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/xJ7I72yxGKXLnfl6GfGgnV1elOSrywe1.ogg"},{"description":"serina_exskill_level_3.ogg","category":"battle","text":"请谨慎使用哦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/4Sel8QjcF5MJ7tV6TTJT6TueagV6brDW.ogg"},{"description":"serina_exweapon_get.ogg","category":"growup","text":"因为打针会疼就逃跑可不行哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/1GCrHuUsHx9gPNs65vzVdIpiEpr6HNzg.ogg"},{"description":"serina_formation_in_1.ogg","category":"formation","text":"请，请交给我吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/wSKppNCrnk8kzBqvpWjr371L96sauN8U.ogg"},{"description":"serina_formation_in_2.ogg","category":"formation","text":"我会尽全力的！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/gdzRmst4ZtQcGVyYS3ZZNxLZfUGYON8T.ogg"},{"description":"serina_gachaget.ogg","category":"growup","text":"有没有哪位受伤了呢？我会马上赶过去的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/jaIm6b4TAa5yvzc89QVkg6IBGv9uKOI9.ogg"},{"description":"serina_growup_1.ogg","category":"growup","text":"我感觉，自己更健康了！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/D2Lsii8pGUf06HiznqQn8F9uiVjS3Q1L.ogg"},{"description":"serina_growup_2.ogg","category":"growup","text":"真希望能和受病痛折磨的人分享这种力量。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/FnaKtkQDlpjRAKhGdnY6Kt7yqLLSyUIK.ogg"},{"description":"serina_growup_3.ogg","category":"growup","text":"为了受病痛折磨的人们，我要继续努力！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/ecGkh5mgurNOGDkggj0LJHoRJnTLVFz2.ogg"},{"description":"serina_growup_4.ogg","category":"growup","text":"我是不是也成长了一点点，嗯哼哼~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/sRDxZ8gg8cc5jEEpxuzkHA6uRuDcCQVU.ogg"},{"description":"serina_lobby_1.ogg","category":"lobby","text":"啊，您是新来的患者吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/04lsesXB4297tWRToF1beGYtoFp1IicZ.ogg"},{"description":"serina_lobby_2.ogg","category":"lobby","text":"您好像很累啊......我给您按摩一下肩膀吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/MbiijTG6WxFYrfUx8gpsDMgtLX08TJD3.ogg"},{"description":"serina_lobby_3.ogg","category":"lobby","text":"劳累是百病的根源！千万不要太勉强自己哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/NeZDW52cihWuVvwrryzAETXvDd0rB8HL.ogg"},{"description":"serina_lobby_4.ogg","category":"lobby","text":"一想到患者，我就会觉得心痛......","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/K2wqRLJCsnFESpntC0wx7ZM4ri0B9NsU.ogg"},{"description":"serina_lobby_5.ogg","category":"lobby","text":"不能饶了那些碰坏和平的坏蛋！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/9TwxQbxf2hXNOPXdEEglm94ZgDTWLKBS.ogg"},{"description":"serina_login_1.ogg","category":"lobby","text":"欢迎您，老师。您今天身体感觉还好吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/6wDJJMpO73jwFTVkbCXBcwpJ4kYd5lZE.ogg"},{"description":"serina_login_2.ogg","category":"lobby","text":"等您很久了，老师。 今天也要为了世界和平 一起加油哦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/irP7LZinawaIfZ1kq9rJRNCLsze3wscX.ogg"},{"description":"serina_relationship_up_1.ogg","category":"growup","text":"和老师在一起，就会感觉心灵得到了治愈......","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/uGNc3Z1ZJ9nMLG3OgHNpeqAgwSHTVxKO.ogg"},{"description":"serina_relationship_up_2.ogg","category":"growup","text":"嗯哼哼~好幸福啊~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/dGGXXKDA6lne01qEQTqIXlxKYpXB4u9T.ogg"},{"description":"serina_relationship_up_3.ogg","category":"growup","text":"我不能只当老师一个人的主治医师......不过，我会一直想着老师的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/GAbjZbCZzTa5LYHyIUKW03yp6lHwOKnf.ogg"},{"description":"serina_relationship_up_4.ogg","category":"growup","text":"让我们创造一个和平的世界吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/8nmh2ncDeOrCOTwRjXK41VNLGxoiG75d.ogg"},{"description":"serina_season_birthday.ogg","category":"lobby","text":"谢谢您祝我生日快乐。您问我想要什么生日礼物是吗？嗯哼哼~只要能看到老师的笑容，就已经足够了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/vidxoC3t2XbU17VNCYhS3jN81nEZA3r1.ogg"},{"description":"serina_season_birthday_player.ogg","category":"lobby","text":"老师，生日快乐！祝愿您今天一整天都充满幸福。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/gECMEnFt0aPVuMmn1D7QWvJSr0wMOnnu.ogg"},{"description":"serina_season_halloween.ogg","category":"lobby","text":"我收到了万圣节的糖果。糖果虽然甜甜的很好吃，但是吃太多，肯定会蛀牙的......","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/i6x5PSIfYuowEcC8zdFmoleTl84cWJuS.ogg"},{"description":"serina_season_newyear.ogg","category":"lobby","text":"恭祝新春快乐！请一定要注意新年不要感冒，记得多穿点衣服哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/wZjHb3qeqlR4hEdyHYKux0BAVOfA0Rta.ogg"},{"description":"serina_season_xmas.ogg","category":"lobby","text":"老师，圣诞快乐！今天是大好的日子，希望大家不要打架，可以度过和平的一天。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/J6XUnloE9r012gsnkAKtq9qBPpAJctiX.ogg"},{"description":"serina_title","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/bczoAlp7qFwOqYNErttdR3wg1MATuEi7.ogg"},{"description":"serina_season_chinesenewyear","category":"lobby","text":"老师，新春快乐！今天是大家尽情玩耍的日子，但也要注意安全，不要受伤哦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/rVj2K8FTpNSLM0F4c4P8HS5aUwjC9xWG.ogg"},{"description":"serina_season_midautumn","category":"lobby","text":"在这个团圆的日子里，我衷心地希望不再有人遭受病痛……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/QWDGhDE2V1HiRbLvBMu9WEcYOkgDroMV.ogg"},{"description":"serina_memoriallobby_1_1","category":"lobby","text":"唉……老师你也真是的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/original/cn/serina_memoriallobby_1_1.ogg"},{"description":"serina_memoriallobby_1_2","category":"lobby","text":"吓了我一跳……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/original/cn/serina_memoriallobby_1_2.ogg"},{"description":"serina_memoriallobby_2_1","category":"lobby","text":"……感觉好不可思议啊。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/original/cn/serina_memoriallobby_2_1.ogg"},{"description":"serina_memoriallobby_2_2","category":"lobby","text":"这时候应该怎么做呢？我没遇到过这种情况……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/original/cn/serina_memoriallobby_2_2.ogg"},{"description":"serina_memoriallobby_3_1","category":"lobby","text":"真的是……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/original/cn/serina_memoriallobby_3_1.ogg"},{"description":"serina_memoriallobby_3_2","category":"lobby","text":"呵呵……老师还是第一个……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/original/cn/serina_memoriallobby_3_2.ogg"},{"description":"serina_memoriallobby_4_1","category":"lobby","text":"不管那么多了，重要的是此刻的心情。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B9%AB%E8%A7%81%20%E8%8A%B9%E5%A8%9C/original/cn/serina_memoriallobby_4_1.ogg"},{"description":"serina_memoriallob