ivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/dybYb8RNYZJb9cXyB0eTeh4pNmODbHZa.ogg"},{"description":"CH0196_EventLogin_2","category":"event","text":"","text_original":"寒いときに何かを食べると、身体が温まるって言いますよね。<br/>ほら、たくさんのお節が私たちを待ってますよ～？","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/NXTgQvo6IuuwPPn6NYPxbIe0SQ6OATia.ogg"},{"description":"CH0196_EventLogin_Season_1","category":"event","text":"","text_original":"何か水々しい…<br/>違いますね、肉々しい…これでもなくて…<br/>はい！騒々しいことが起こってるみたいです。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/drnbTLYfQnB7IOd9AxyzBVDTenGjczaE.ogg"},{"description":"CH0196_EventLogin_Season_2","category":"event","text":"","text_original":"いろんな意味で、めちゃくちゃ★ですね。<br/>私は嫌いじゃないですけど、<br/>こういうの、苦手な方もいるかもしれません。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/bbVDl7v9Fyv2jbpYA1cQCjBTMaLwXyDD.ogg"},{"description":"CH0196_EventLogin_Season_End","category":"event","text":"","text_original":"お正月ムードも 落ち着きましたね。<br/>お節、と～っても 美味しかったです★","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/G1QfHlCJc8hLULxRlMv4HPo0U4gOxHff.ogg"},{"description":"CH0196_ExSkill_1","category":"battle","text":"","text_original":"あは、運転は慣れてるんですよ","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/ZSnwlkgu9lfdkBFSsXjF8bnEt4uRGDcF.ogg"},{"description":"CH0196_ExSkill_2","category":"battle","text":"","text_original":"あはは、楽しいですねー","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/BpNH8N9tLvBPgYgxk5Zd3SdvFw1Z3Rod.ogg"},{"description":"CH0196_ExSkill_3","category":"battle","text":"","text_original":"うーん、走りましょうかー","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/GAHEazPV6MeLtxg7ykKjD5oCBUgBS6Dv.ogg"},{"description":"CH0196_ExSkill_Level_1","category":"battle","text":"","text_original":"あら?もったいないですね。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/50k4jCZUf5kmJpkUhBNl3zZGT4wFw4dT.ogg"},{"description":"CH0196_ExSkill_Level_2","category":"battle","text":"","text_original":"安全第一ですよー","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/P9cgszTivB7bIGsttlZDJeU62oHLj1zh.ogg"},{"description":"CH0196_ExSkill_Level_3","category":"battle","text":"","text_original":"緊急停止! 何でもないですよー","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/74OztsgC5nW1XrdC6F1Ig5b3Mcd8I5gd.ogg"},{"description":"CH0196_ExWeapon_Get","category":"growup","text":"","text_original":"わあ～！ありがとうございます★ これでぜ～んぶ、吹き飛ばせちゃいます！ フフッ……大丈夫ですよ、先生。 ちゃんと手加減しますから★","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/Zr5gihhV414pFOML48K1Iw6kbIsRWRE4.ogg"},{"description":"CH0196_Gachaget","category":"growup","text":"","text_original":"年の暮れ……そして新年。 言葉の響きに胸が躍りますね。 そこに美味しいお料理があれば、言うことなしです★","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/WlryjE8OL48AygwQLfeMZQZ5CBrbErPy.ogg"},{"description":"CH0196_Growup_1","category":"growup","text":"","text_original":"私がどこまで食べられるか、いえ、どこまで成長できるか、見守っていてくださいね。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/8IRCHjVDzjzRMjmff5TUKuui6x5hkWYh.ogg"},{"description":"CH0196_Growup_2","category":"growup","text":"","text_original":"まだまだ食べられますよー。新年は美味しいものがいっぱいですからね。味わわないともったいないです。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/TRJjDjlzDVERSgid3GcXVwC4idZWrQXP.ogg"},{"description":"CH0196_Growup_3","category":"growup","text":"","text_original":"ん?この先、どんなスペシャルメニューに出会えるのでしょう。楽しみですね、先生。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/kGUdw1xbIabMGsllzUvrQ4GiCBRqUhva.ogg"},{"description":"CH0196_Growup_4","category":"growup","text":"","text_original":"先生といると、たーくさん新鮮な体験ができるんです。でも、もーっと新しい体験も…してみたいかも?","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/i21KmHcMvI7wvlBA9vBJScFxTTCHcw83.ogg"},{"description":"CH0196_Lobby_1","category":"lobby","text":"","text_original":"どうでしょう～？私の着物姿。<br/>可愛いって言いたくなったり…… しませんか～？","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/Wm0q7aI46Ou1pSnqj6RWynEhR69iSq20.ogg"},{"description":"CH0196_Lobby_2","category":"lobby","text":"","text_original":"今なら！私とのデートが！ なんと0円！お買い得ですよ～！<br/>……あ、サボろうとしてるんじゃ ないかって疑ってますね？<br/>私をなんだと思ってるんですか？ ……正解です★","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/5X6dVXUGf7Vla8QkHe6yD4z1wNlUvXNl.ogg"},{"description":"CH0196_Lobby_3","category":"lobby","text":"","text_original":"フフッ、先生のそばにいると、 ついはしゃいでしまいます。 どうしてでしょうね～？","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/SER7bdo9f42aoynSJA8oMmTcvIWkGczc.ogg"},{"description":"CH0196_Lobby_4","category":"lobby","text":"","text_original":"私、先生に期待しても、 いいですか～？  ……あらま、二つ返事だなんて。  とんでもないことを、期待しちゃ うかもしれないのに…？フフッ★","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/HjWm8YlKmKjV9XgmRU6tBJLmTywbsNyY.ogg"},{"description":"CH0196_Lobby_5","category":"lobby","text":"","text_original":"え？何をしてるの、って？  ご覧の通り、先生に 寄りかかってるんですよ～？  フフッ、嫌です、離れません、 このままがいいです★","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/HvGhEl7Ee3iUQo6nQRBXB7ajtPuktfeE.ogg"},{"description":"CH0196_LogIn_1","category":"lobby","text":"","text_original":"あら★いらしたんですね、先生。<br/>それでは、 今から食べたい 物をお伝えします～","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/yRNfRzb0HuDOB3J63K8PVLFWRh6ingOJ.ogg"},{"description":"CH0196_LogIn_2","category":"lobby","text":"","text_original":"おかえりなさい、先生★<br/>ずーっと、先生のこと待ってました。<br/>いつから、ですか？<br/>それは秘密です★","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/bIMii4TPbTun8Pg7GPOdpQ1o3cDUnuh9.ogg"},{"description":"CH0196_MemorialLobby_1_1","category":"lobby","text":"","text_original":"ふぅ……思ったより、力が要りますね。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/ymUyaJkKgLUriswMNesHt29Uo34BfuqA.ogg"},{"description":"CH0196_MemorialLobby_1_2","category":"lobby","text":"","text_original":"大丈夫ですよ、先生。まだいけます。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/I9CG25DjZztjCNiYtoictslY6NQ4kEVh.ogg"},{"description":"CH0196_MemorialLobby_2","category":"lobby","text":"","text_original":"気遣ってくださって嬉しいです……でもやっぱり、楽しみで仕方がないんです。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/yYBWVH1pPNnnMkfO6fpLAMC3xWbsJp6P.ogg"},{"description":"CH0196_MemorialLobby_3_1","category":"lobby","text":"","text_original":"どんなお餅ができるのか。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/se0rw6wdnmkbSeO0Dlh33rJXU6zpuNrp.ogg"},{"description":"CH0196_MemorialLobby_3_2","category":"lobby","text":"","text_original":"それでどんな料理が作れるのか……","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/GCrpHu4vk5Mzk9Ay9GZCCDQCra0rgMH1.ogg"},{"description":"CH0196_MemorialLobby_4","category":"lobby","text":"","text_original":"……それを、先生と一緒に食べられると思うと……","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/StcpAKnB03xg24b3Cw4oW5Ae8d3tGxAH.ogg"},{"description":"CH0196_MemorialLobby_5_1","category":"lobby","text":"","text_original":"……ねえ、先生。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/wuhIqvhx3uiPhQ48DLDy2qMfHpgfwquk.ogg"},{"description":"CH0196_MemorialLobby_5_2","category":"lobby","text":"","text_original":"お餅ができたら、一番に食べてほしいです。いいですよね？","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/iyLoVWrVm80wI6hYWIjQlcunFgSyBIh7.ogg"},{"description":"CH0196_Relationship_Up_1","category":"growup","text":"","text_original":"先生、どこか行きたい場所はありますか? 運転でしたら、私にお任せください。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/eaBufgnirGpkwfzqYqcMoT7QE0EpNZ9B.ogg"},{"description":"CH0196_Relationship_Up_2","category":"growup","text":"","text_original":"食事は、生きる上で最も重要と言っても過言ではありません。でも、それよりも重要なものだって、世の中には……あるのかなぁ？ないのかなぁ？うふふっ。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/oSb5fHKovnQy0NJl9Rr3vaxGA209lZ46.ogg"},{"description":"CH0196_Relationship_Up_3","category":"growup","text":"","text_original":"せっかくの晴れ着ですから、先生に見てもらいたい気持ちが、あったり、なかったり？うふふ。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/rZn8mtvMkhaIQOBw0yDGMjt8KxNc9FQb.ogg"},{"description":"CH0196_Relationship_Up_4","category":"growup","text":"","text_original":"わかってます。先生が生徒を大切に思うのは、当たり前のこと。でも、先生、実は私、普通ってあんまり好きじゃないんです。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/Y0g9hGCQ3dttoQfOIMCa4HdxALNZtMut.ogg"},{"description":"CH0196_Season_Birthday","category":"lobby","text":"","text_original":"誕生日お祝い、ありがとう ございます、先生。  では祝ってくださったついでに～ ホールケーキをもう3個、 いただいてもいいですか～？","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/P2SEk3MjG5GZZ2uFD65o1Guh2Orhrd7b.ogg"},{"description":"CH0196_Season_Birthday_Player","category":"lobby","text":"","text_original":"誕生日ですね、先生！ 自分のことのように嬉しいです！  あら？違いますよ、 決してバースデーケーキが 楽しみだからでは……  ……あります★","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/kJL0ywdcyLHP0PzchhwDuflTt8fhH4i3.ogg"},{"description":"CH0196_Season_Halloween","category":"lobby","text":"","text_original":"お菓子をもらったら、 イタズラしちゃ いけないんですか？  ……別にそんな決まりはない？  今の話…… 本気にしちゃいますよ……？  ふふふ……★","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/PUiLbV6IuqvafpZ6lg8ZFKIKuTwq1hM3.ogg"},{"description":"CH0196_Season_NewYear","category":"lobby","text":"","text_original":"新年明けまして おめでとうございます～★  さあ、お節を食べに 行きましょう！  運転は私がしますから。 先生、急いでください！","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/TQfGEvvQEhd4sDLiRxRpKL7MtXDC08WF.ogg"},{"description":"CH0196_Season_Xmas","category":"lobby","text":"","text_original":"クリスマス…… 大晦日……年明け……  フフッ、私の大好きな シーズンです。  だって、美味しいものが いっぱいなんですもの！","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/d10B44bCqFG9E6tJePiQr3cO3Nsvoamj.ogg"},{"description":"CH0196_Title","category":"lobby","text":"","text_original":"ブルーアーカイブ、うふッ。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/zZj6NCALFnxUOqN2VSI9iOgcd04Gz9I0.ogg"},{"description":"SM019601_CommonSkill","category":"battle","text":"","text_original":"いつものお願いします！","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/34HvvsVSEil3gblozoosPSyRDa48GJQJ.ogg"},{"description":"ch0196_formation_in_2","category":"formation","text":"","text_original":"楽しみにしていてください、フフッ。","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/jp/ch0196_formation_in_2.ogg"},{"description":"ch0196_formation_in_1","category":"formation","text":"","text_original":"ワクワク、してますか～？","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/jp/ch0196_formation_in_1.ogg"}],"voice_cn":[{"description":"ch0196_cafe_monolog_1","category":"cafe","text":"今天的每日菜单是什么呢~？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_cafe_monolog_1.ogg"},{"description":"ch0196_cafe_monolog_2","category":"cafe","text":"享用特别的菜肴，度过美好的时光……多么美妙啊★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_cafe_monolog_2.ogg"},{"description":"ch0196_cafe_monolog_3","category":"cafe","text":"病毒式传播的力量太惊人了。光是看一看都能看饿呢。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_cafe_monolog_3.ogg"},{"description":"ch0196_cafe_monolog_4","category":"cafe","text":"评论数比评分更重要哦？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_cafe_monolog_4.ogg"},{"description":"ch0196_cafe_monolog_5","category":"cafe","text":"我可不是一直只想着吃哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_cafe_monolog_5.ogg"},{"description":"ch0196_commonskill","category":"battle","text":"来一发特别的吧~？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_commonskill.ogg"},{"description":"ch0196_eventlobby_1","category":"event","text":"出什么事了吗，老师？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_eventlobby_1.ogg"},{"description":"ch0196_eventlobby_2","category":"event","text":"哎呀，您这是在和我开玩笑吗？老师~？真的没关系吗？我的反击……可能会有点特别哦？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_eventlobby_2.ogg"},{"description":"ch0196_eventlobby_3","category":"event","text":"老师，很无聊吗？我可以给老师解闷哦，怎么样……？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_eventlobby_3.ogg"},{"description":"ch0196_eventlobby_4","category":"event","text":"都是老师在逗我，不公平。嘿，抓到您了★现在我再也不会放开您咯~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_eventlobby_4.ogg"},{"description":"ch0196_eventlogin_1","category":"event","text":"哇！老师！您已经许过新年愿望了吗？如果还没有的话……要不要和我一起呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_eventlogin_1.ogg"},{"description":"ch0196_eventlogin_2","category":"event","text":"不是说天冷的时候吃点东西，身体就会变暖嘛。来吧，有很多御节料理在等着我们呢~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_eventlogin_2.ogg"},{"description":"ch0196_eventlogin_season_1","category":"event","text":"怎么好像发生了什么新鲜的……不对，很美味的……也不对……啊！是很热闹的事情。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_eventlogin_season_1.ogg"},{"description":"ch0196_eventlogin_season_2","category":"event","text":"从各种方面来看，都是一件乒哩乓啷★的事情呢。虽然我不介意，但应该会有人觉得很难办吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_eventlogin_season_2.ogg"},{"description":"ch0196_eventlogin_season_end","category":"event","text":"新年的氛围快过去啦。御节料理真是太好吃了★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_eventlogin_season_end.ogg"},{"description":"ch0196_exskill_1","category":"battle","text":"呵呵呵。我开车可是很熟练的哦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_exskill_1.ogg"},{"description":"ch0196_exskill_2","category":"battle","text":"呵呵。好开心哪~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_exskill_2.ogg"},{"description":"ch0196_exskill_3","category":"battle","text":"嗯~要跑跑看吗~？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_exskill_3.ogg"},{"description":"ch0196_exskill_level_1","category":"battle","text":"哎呀？好可惜啊……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_exskill_level_1.ogg"},{"description":"ch0196_exskill_level_2","category":"battle","text":"安全第一哦~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_exskill_level_2.ogg"},{"description":"ch0196_exskill_level_3","category":"battle","text":"紧急停车！什么事都没发生哦？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_exskill_level_3.ogg"},{"description":"ch0196_exweapon_get","category":"growup","text":"哇~！谢谢您★有了它，就能把一切都解决掉了！呵呵……没关系的，老师，我会掌握好分寸的★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_exweapon_get.ogg"},{"description":"ch0196_gachaget","category":"growup","text":"年末……还有新年。光是想到这些词我就心潮澎拜呢。如果还有美味的菜肴，就再好不过了★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_gachaget.ogg"},{"description":"ch0196_growup_1","category":"growup","text":"我能吃下多少……不。是能成长到什么程度，就请老师来见证了★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_growup_1.ogg"},{"description":"ch0196_growup_2","category":"growup","text":"我还吃得下哦~因为新年有很多好吃的！如果不尝尝看就太可惜了★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_growup_2.ogg"},{"description":"ch0196_growup_3","category":"growup","text":"呵呵……今年的特色菜单是什么呢？我可以期待一下吗，老师？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_growup_3.ogg"},{"description":"ch0196_growup_4","category":"growup","text":"和老师在一起，可以获得很多新奇的体验。不过，老师不想再尝试一点……更新的体验吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_growup_4.ogg"},{"description":"ch0196_lobby_1","category":"lobby","text":"我穿和服怎么样~？会不会……想夸我可爱呢~？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_lobby_1.ogg"},{"description":"ch0196_lobby_2","category":"lobby","text":"就是现在！和我约会竟然只需0元！很划算哦~！……啊，老师该不会在怀疑我想摸鱼吧？您是怎么看我的啊？……回答正确★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_lobby_2.ogg"},{"description":"ch0196_lobby_3","category":"lobby","text":"嘿嘿，只要待在老师身边，我不知不觉就会变得快乐起来了。为什么会这样呢~？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_lobby_3.ogg"},{"description":"ch0196_lobby_4","category":"lobby","text":"我可以对老师抱有期待吗~？……哎呀，居然答应得这么快。我说不定会期待一些不切实际的事情哦……？呵呵★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_lobby_4.ogg"},{"description":"ch0196_lobby_5","category":"lobby","text":"嗯？您问我在做什么？应该能看出来吧？我在靠着老师呀~呵呵，不要，我就不起来，这样可舒服了★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_lobby_5.ogg"},{"description":"ch0196_login_1","category":"lobby","text":"哎呀★老师来啦。那我就告诉您我现在想吃什么吧~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_login_1.ogg"},{"description":"ch0196_login_2","category":"lobby","text":"欢迎老师★我一直在等您呢。问我从什么时候开始等的？这可是秘密哦★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_login_2.ogg"},{"description":"ch0196_memoriallobby_1_1","category":"lobby","text":"啊，没想到是个体力活呐。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_memoriallobby_1_1.ogg"},{"description":"ch0196_memoriallobby_1_2","category":"lobby","text":" 没关系哒，老师，我还能坚持！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_memoriallobby_1_2.ogg"},{"description":"ch0196_memoriallobby_2","category":"lobby","text":"谢谢老师关心我，我很开心！但是，我还是太期待了，实在忍不住呢★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_memoriallobby_2.ogg"},{"description":"ch0196_memoriallobby_3_1","category":"lobby","text":"会做出什么样的年糕呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_memoriallobby_3_1.ogg"},{"description":"ch0196_memoriallobby_3_2","category":"lobby","text":"用年糕又能做出什么样的食物呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_memoriallobby_3_2.ogg"},{"description":"ch0196_memoriallobby_4","category":"lobby","text":"一想到，能和老师一起品尝……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_memoriallobby_4.ogg"},{"description":"ch0196_memoriallobby_5_1","category":"lobby","text":"您知道吗，老师？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_memoriallobby_5_1.ogg"},{"description":"ch0196_memoriallobby_5_2","category":"lobby","text":"等年糕做好了，我希望老师能第一个品尝，可以吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_memoriallobby_5_2.ogg"},{"description":"ch0196_relationship_up_1","category":"growup","text":"老师，有想去的地方吗~？开车可以交给我哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_relationship_up_1.ogg"},{"description":"ch0196_relationship_up_2","category":"growup","text":"把饮食当做人生的头等大事也不为过。不过，要说世上比这更重要的东西…………是有呢？还是没有呢？呵呵。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_relationship_up_2.ogg"},{"description":"ch0196_relationship_up_3","category":"growup","text":"难得穿上新衣服，有点想让老师看看……好像又不希望？呵呵。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_relationship_up_3.ogg"},{"description":"ch0196_relationship_up_4","category":"growup","text":"我知道，老师重视学员再正常不过了……可是老师，我其实不怎么喜欢“平凡”哦★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_relationship_up_4.ogg"},{"description":"ch0196_season_birthday","category":"lobby","text":"谢谢老师的生日祝福。那么趁着为我庆生~可以拜托老师再给我买三个大蛋糕吗~？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_season_birthday.ogg"},{"description":"ch0196_season_birthday_player","category":"lobby","text":"老师，今天是您的生日诶！我就像自己过生日一样高兴！哎呀？没有哦，我绝对不是因为期待生日蛋糕才…………才怪啦★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_season_birthday_player.ogg"},{"description":"ch0196_season_chinesenewyear","category":"lobby","text":"新春快乐哦，老师！穿着这样的衣服，总觉得胃口比平时更好了呢~！走，我们去逛庙会吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_season_chinesenewyear.ogg"},{"description":"ch0196_season_halloween","category":"lobby","text":"为什么给了糖就不可以捣蛋呢？嗯？您说并没有规定不可以？这句话……您会负责吧……？呵呵呵……★","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_season_halloween.ogg"},{"description":"ch0196_season_midautumn","category":"lobby","text":"老师，中秋快乐！唔~今年想要尝试不太一样的东西呢~桂花酒酿怎么样？里面加了好多好多圆子的那种！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_season_midautumn.ogg"},{"description":"ch0196_season_newyear","category":"lobby","text":"新年快乐~★来，我们去吃御节料理吧！我来开车。老师，请抓紧时间哦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_season_newyear.ogg"},{"description":"ch0196_season_xmas","category":"lobby","text":"圣诞节……年末……年初……呵呵，这个季节我非常喜欢。因为有很多好吃的！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_season_xmas.ogg"},{"description":"ch0196_title","category":"lobby","text":"Blue Archive","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/cn/ch0196_title.ogg"}],"voice_kr":[{"description":"CH0196_Title","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/CH0196_Title.ogg"},{"description":"ch0196_cafe_monolog_1","category":"cafe","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/ch0196_cafe_monolog_1.ogg"},{"description":"ch0196_cafe_monolog_2","category":"cafe","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/ch0196_cafe_monolog_2.ogg"},{"description":"ch0196_cafe_monolog_3","category":"cafe","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%B3%84%E6%B8%8A%20%E6%98%8E%E9%87%8C/%E6%AD%A3%E6%9C%88/ch0196_cafe_monolog_3.ogg"},{"des