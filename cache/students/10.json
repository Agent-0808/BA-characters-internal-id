iki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/riS9P1ZuO0Gu6XcSSDULvZ2aVuUJUT5s.ogg"},{"description":"airi_season_birthday","category":"lobby","text":"老师～今天是我的生日！一起去吃冰淇淋吧！ 嗯？礼物？ 不用啦～老师就是我的礼物嘛！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/aNopxWbLtjCfFBqjIYI6MVjbC1IZ8oO0.ogg"},{"description":"airi_season_birthday_player","category":"lobby","text":"老师，祝您生日快乐！ 为了这一天！我可是特意为您预约了好吃的甜品店呢！ 来吧来吧，快走吧！老师！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/m3ajxOcTNHF5Bw42rGzZnV1t6lWVo8C7.ogg"},{"description":"airi_season_halloween","category":"lobby","text":"诶嘿嘿，今天是万圣节诶。 一起打扮成妖怪，然后去要糖果吧？ 哼~不给糖，就捣蛋~","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/bIouQxIAfq5oll9M1EciHuvtFnzHuqDr.ogg"},{"description":"airi_season_newyear","category":"lobby","text":"老师～祝您新年快乐～ 为了美味的甜点！今年也一起加油吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/ryNs2u5zmUnP4unFApGLCUSmkHvvrf42.ogg"},{"description":"airi_season_xmas","category":"lobby","text":"哇——老师～！圣诞节到咯！ 这种日子就适合吃冰淇淋对吧！我们一起去买吧？","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/JTmVu371eTJ4QddkI7kRn1V2WFRouDn7.ogg"},{"description":"airi_season_chinesenewyear","category":"lobby","text":"虽然外面有些冷，但老师要不要和我一起吃薄荷巧克力冰淇淋呀？毕竟今天可是新年呀！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/Zm8g9UvgD85QBVkbzrcvgmGw0IfJ3gTl.ogg"},{"description":"airi_season_midautumn","category":"lobby","text":"老师，今晚的月亮很圆很白呢！就像甜品一样，让人很有食欲！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/QxfyBFabu07btFCJjLQe5n4WFClMI3dw.ogg"},{"description":"airi_memoriallobby_0","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_0.ogg"},{"description":"airi_memoriallobby_1_1","category":"lobby","text":"非常感谢您…… 连我的份也一起买了，老师。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_1_1.ogg"},{"description":"airi_memoriallobby_1_2","category":"lobby","text":"甜……甜甜的好好吃啊！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_1_2.ogg"},{"description":"airi_memoriallobby_2_1","category":"lobby","text":"平常都是在咖啡厅 吃冰淇淋，感觉好久好久 没在外面吃了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_2_1.ogg"},{"description":"airi_memoriallobby_2_2","category":"lobby","text":"而且还是跟老师一起， 诶嘿嘿。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_2_2.ogg"},{"description":"airi_memoriallobby_3_1","category":"lobby","text":"不，没有， 完全没有啦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_3_1.ogg"},{"description":"airi_memoriallobby_3_2","category":"lobby","text":"反而有种很怀念的感觉， 好开心。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_3_2.ogg"},{"description":"airi_memoriallobby_4_1","category":"lobby","text":"不仅开心，而且……","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_4_1.ogg"},{"description":"airi_memoriallobby_4_2","category":"lobby","text":"感觉真安静啊…… 周围也没有什么人……","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_4_2.ogg"},{"description":"airi_memoriallobby_4_3","category":"lobby","text":"不知道该不该说， 我感觉心在怦怦乱跳……","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_4_3.ogg"},{"description":"airi_memoriallobby_4_4","category":"lobby","text":"……没，没， 没有没有！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_4_4.ogg"},{"description":"airi_memoriallobby_4_5","category":"lobby","text":"请您当我 什么都没说吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_4_5.ogg"},{"description":"airi_memoriallobby_4_6","category":"lobby","text":"哈哈，啊哈哈……","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_4_6.ogg"},{"description":"airi_memoriallobby_5_1","category":"lobby","text":"……谢谢您，老师。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_5_1.ogg"},{"description":"airi_memoriallobby_5_2","category":"lobby","text":"多亏有老师在， 今天真的好幸福。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/cn/airi_memoriallobby_5_2.ogg"}],"voice_kr":[{"description":"airi_exskill_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/airi_exskill_1.ogg"},{"description":"airi_exskill_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/airi_exskill_2.ogg"},{"description":"airi_exskill_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/airi_exskill_3.ogg"},{"description":"airi_exskill_level_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A0%97%E6%9D%91%20%E7%88%B1%E8%8E%89/original/airi_exskill_leve