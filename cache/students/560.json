p/ch0318_battle_damage_1.ogg"},{"description":"ch0318_battle_damage_2","category":"battle","text":"救命……！","text_original":"助けて……！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_damage_2.ogg"},{"description":"ch0318_battle_damage_3","category":"battle","text":"疼。","text_original":"痛。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_damage_3.ogg"},{"description":"ch0318_battle_defense_1","category":"battle","text":"呵、呵呵呵，就、就这种程度的攻击……！","text_original":"ふ、ふふっ、こ、この程度……！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_defense_1.ogg"},{"description":"ch0318_battle_in_1","category":"battle","text":"好，去采购点“胜利”吧！","text_original":"さあ、「勝利」を仕入れに行きますよ！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_in_1.ogg"},{"description":"ch0318_battle_in_2","category":"battle","text":"补给包在我身上吧。","text_original":"補給はお任せあれ。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_in_2.ogg"},{"description":"ch0318_battle_move_1","category":"battle","text":"走，出发吧！","text_original":"さあ、行きましょう！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_move_1.ogg"},{"description":"ch0318_battle_move_2","category":"battle","text":"放轻松放轻松~","text_original":"リラックスリラックス～","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_move_2.ogg"},{"description":"ch0318_battle_recovery_1","category":"battle","text":"感谢您的惠顾……！","text_original":"お取引、ありがとうございます……！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_recovery_1.ogg"},{"description":"ch0318_battle_retire","category":"battle","text":"啊~累死了……","text_original":"もう〜疲れた...","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_retire.ogg"},{"description":"ch0318_battle_shout_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_shout_1.ogg"},{"description":"ch0318_battle_shout_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_shout_2.ogg"},{"description":"ch0318_battle_shout_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_shout_3.ogg"},{"description":"ch0318_battle_tacticalaction_1_b","category":"battle","text":"呵！","text_original":"ふっ！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_tacticalaction_1_b.ogg"},{"description":"ch0318_battle_victory_1","category":"battle","text":"顺利的交易呢。","text_original":"スムーズなお取引でしたね。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_victory_1.ogg"},{"description":"ch0318_battle_victory_2","category":"battle","text":"之后麻烦给个好评哦。","text_original":"後で高評価の方、よろしくお願いしますよ。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_battle_victory_2.ogg"},{"description":"ch0318_cafe_monolog_1","category":"cafe","text":"诶，这看上去是个不错的碰头地点呢。","text_original":"へぇ、打ち合わせ場所に良さそうだね。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_cafe_monolog_1.ogg"},{"description":"ch0318_cafe_monolog_2","category":"cafe","text":"屏幕放哪里好呢……","text_original":"スクリーンを設置するならどこがいいかな……。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_cafe_monolog_2.ogg"},{"description":"ch0318_cafe_monolog_3","category":"cafe","text":"（这的咖啡，用的豆子相当不错呢……要不也进点货看看？）","text_original":"（ここのコーヒー、中々いい豆を使ってるね……これも仕入れてみようかな？）","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_cafe_monolog_3.ogg"},{"description":"ch0318_cafe_monolog_4","category":"cafe","text":"话说……老师不来吗？","text_original":"ところで……先生は来ないのかな。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_cafe_monolog_4.ogg"},{"description":"ch0318_cafe_monolog_5","category":"cafe","text":"（那是……舍监队！？怎么办……要逃吗！？）","text_original":"（あれは……寮監隊！？どうしよう……逃げる！？）","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_cafe_monolog_5.ogg"},{"description":"ch0318_commonskill","category":"battle","text":"呵呵，好货色还真不少。","text_original":"ふふ、いい物揃ってますよ？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_commonskill.ogg"},{"description":"ch0318_eventlobby_1","category":"event","text":"对，特殊交易部的接待负责人就是我。","text_original":"ええ、特殊交易部の窓口担当は私です。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventlobby_1.ogg"},{"description":"ch0318_eventlobby_2","category":"event","text":"接触客户、接下委托、让客户心满意足……这就是我的职责。","text_original":"接触し、依頼につなげて、お客様に満足を提供する……。それが、私の役割です。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventlobby_2.ogg"},{"description":"ch0318_eventlobby_3","category":"event","text":"要是没有美代和小律的支援，我也不过是艺术院的一个普通学生罢了。","text_original":"ミヨとリッちゃんのサポートがなかったら、私なんてただの一芸術学院生にすぎませんから。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventlobby_3.ogg"},{"description":"ch0318_eventlobby_4","category":"event","text":"……艺术，还真是难懂呢。","text_original":"……芸術って、難しいんですよね。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventlobby_4.ogg"},{"description":"ch0318_eventlogin_1","category":"event","text":"我是特殊交易部的营业室长，若狭冬！","text_original":"特殊交易部の営業室長！若狭フユです！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventlogin_1.ogg"},{"description":"ch0318_eventlogin_2","category":"event","text":"要是有什么想要的东西，请随时和我商量。","text_original":"なにか欲しいものがありましたら、お気軽にご相談ください。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventlogin_2.ogg"},{"description":"ch0318_eventlogin_season_1","category":"event","text":"呵，呵呵……和往常一样呢。没问题的。","text_original":"ふ、ふふ……いつも通りですね。問題ありません。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventlogin_season_1.ogg"},{"description":"ch0318_eventlogin_season_2","category":"event","text":"（为什么……？哪里搞错了吗……？）（完蛋了吗？对吧？果然已经完蛋了吧！？）","text_original":"（どうして……？どこで間違えちゃったの……？）（もう終わり？そうだよね？やっぱ終わりだよね！？）","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventlogin_season_2.ogg"},{"description":"ch0318_eventlogin_season_end","category":"event","text":"呵……呵呵……这种委托，暂时先不接了吧……。","text_original":"ふ……ふふ……この手の依頼、しばらくはやめとこうかな……。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventlogin_season_end.ogg"},{"description":"ch0318_eventshop_1","category":"event","text":"想要这里没有的东西吗……？……要不去别处详谈吧。","text_original":"ここには無いものが欲しい……？……お話はあちらで伺いましょうか。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventshop_1.ogg"},{"description":"ch0318_eventshop_2","category":"event","text":"哈哈！就算戳我也不会给您降价的哦？","text_original":"ははっ！つっついても、安くなりませんよ？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventshop_2.ogg"},{"description":"ch0318_eventshop_buy_1","category":"event","text":"真不愧是老师，眼光真好。","text_original":"さすが先生。お目が高いですね。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventshop_buy_1.ogg"},{"description":"ch0318_eventshop_buy_2","category":"event","text":"那个可是我的推荐款哦。","text_original":"それ、私のイチオシなんです。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventshop_buy_2.ogg"},{"description":"ch0318_eventshop_buy_3","category":"event","text":"本店不支持退换货，敬请谅解。","text_original":"返品交換はできませんので。ご了承ください。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventshop_buy_3.ogg"},{"description":"ch0318_eventshop_buy_4","category":"event","text":"不错的选择。要帮您打包吗？","text_original":"ナイスチョイスです。こちら、お包みしますか？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventshop_buy_4.ogg"},{"description":"ch0318_eventshop_end","category":"event","text":"这里暂时还没问题哦，请慢慢挑吧。","text_original":"まだしばらくは大丈夫ですよ。ごゆっくりどうぞ。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventshop_end.ogg"},{"description":"ch0318_eventshop_login_1","category":"event","text":"库存很充足哦，请随意挑选。","text_original":"在庫は十分ありますよ。どうぞ、心ゆくまで見て行ってください。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventshop_login_1.ogg"},{"description":"ch0318_eventshop_login_2","category":"event","text":"找到想要的了吗？","text_original":"欲しいものは見つかりましたか？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_eventshop_login_2.ogg"},{"description":"ch0318_exskill_1","category":"battle","text":"嘘——，刚刚那个是商业机密哦？","text_original":"しーっ、今見たものは企業秘密ですよ？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_exskill_1.ogg"},{"description":"ch0318_exskill_2","category":"battle","text":"怎样？看着不错吧？","text_original":"どうです？カッコよかったでしょう？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_exskill_2.ogg"},{"description":"ch0318_exskill_3","category":"battle","text":"好了，趁还没被发现赶紧溜吧！","text_original":"さあ、バレないうちにずらかりますよ！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_exskill_3.ogg"},{"description":"ch0318_exskill_level_1","category":"battle","text":"您的子弹到货了！","text_original":"弾丸、お届けにあがりました！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_exskill_level_1.ogg"},{"description":"ch0318_exskill_level_2","category":"battle","text":"送货要又快又稳！","text_original":"お届けは迅速かつ丁寧に！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_exskill_level_2.ogg"},{"description":"ch0318_exskill_level_3","category":"battle","text":"不论对方是谁都是我的顾客！我给您送货来了！","text_original":"どんな相手だろうとお客様ですから！お届けに参りました！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_exskill_level_3.ogg"},{"description":"ch0318_exweapon_get","category":"growup","text":"接受投资，就要提供超额的回报。这就是生意！所以……在我能报答您之前，请一直陪在我身边，老师。","text_original":"受けた投資にはそれ以上のリターンを。それがビジネスですからね！なので……いつか恩返しできるその時まで、そばにいてください、先生。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_exweapon_get.ogg"},{"description":"ch0318_formation_in_1","category":"formation","text":"嗯，保证不会让您后悔的。","text_original":"ええ、後悔はさせませんとも。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_formation_in_1.ogg"},{"description":"ch0318_formation_in_2","category":"formation","text":"您想要的商品是……“胜利”，对吧？","text_original":"お求めの品は……「勝利」、ですかね？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_formation_in_2.ogg"},{"description":"ch0318_formation_select","category":"formation","text":"呵呵......呜哇等等......呼。","text_original":"ふふっ……うあぁっとと！……ふぅ。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_formation_select.ogg"},{"description":"ch0318_gachaget","category":"growup","text":"哦呀……眼光真不错呢，这位客人……不对，老师！……抱歉还没做介绍呢，我是狂猎艺术学院二年级的若狭冬，今后请多指教！","text_original":"おや…お目が高いですね、お客様……いえ、先生！……申し遅れました。ワイルドハント芸術学院2年、若狭フユです。以後、お見知りおきを！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_gachaget.ogg"},{"description":"ch0318_growup_1","category":"growup","text":"到底是从哪里弄来这些……！非常感谢，老师！","text_original":"一体、どこでこんなものを……！ありがとうございます、先生！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_growup_1.ogg"},{"description":"ch0318_growup_2","category":"growup","text":"诶，投资……这么多！？呵呵，我绝不会让您失望的！","text_original":"えっ、投資……こんなに！？ふふっ、失望はさせませんよ！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_growup_2.ogg"},{"description":"ch0318_growup_3","category":"growup","text":"为我做到这种地步……？……您莫非，有什么非得到不可的东西？","text_original":"私にここまで……？……なにか、どうしても欲しいモノでもあるんですか？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_growup_3.ogg"},{"description":"ch0318_growup_4","category":"growup","text":"非常感谢。我一定不负您的期待……！","text_original":"ありがとうございます。ご期待には、必ず……！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_growup_4.ogg"},{"description":"ch0318_lobby_1","category":"lobby","text":"嗯，这就是内勤的工作啊……","text_original":"ふむ、これが内勤の仕事ですか……。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_lobby_1.ogg"},{"description":"ch0318_lobby_2","category":"lobby","text":"如何？特殊交易部的顾问席位，随时为您留着哦？","text_original":"どうです？特殊交易部顧問の椅子は、いつでも空けてありますよ？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_lobby_2.ogg"},{"description":"ch0318_lobby_3","category":"lobby","text":"这里真舒适啊……嗯，真是间不错的办公室。要是能当我们的据点的话……不过不行吧？","text_original":"ここは快適で……ええ。いいオフィスです。……私たちの拠点にしたら……ダメですよねぇ？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_lobby_3.ogg"},{"description":"ch0318_lobby_4","category":"lobby","text":"真让人安心啊……稍微放松一下也……呜啊～","text_original":"落ち着きますねぇ……ちょっとくらい肩の力を抜いても……ふわぁ。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_lobby_4.ogg"},{"description":"ch0318_lobby_5","category":"lobby","text":"真是的……再这样戳我的话……我就挤过来了哦！紧紧贴在一起的话，你就没法恶作剧了吧？","text_original":"もう……そんなにつっつくなら……隙間を埋めちゃいますよ？ぴったりくっついたら、イタズラできませんよね？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_lobby_5.ogg"},{"description":"ch0318_login_1","category":"lobby","text":"等您好久了，老师！","text_original":"お待ちしてましたよ、先生！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_login_1.ogg"},{"description":"ch0318_login_2","category":"lobby","text":"来，请坐。来谈谈生意吧。","text_original":"さあ、おかけください。ビジネスの話と参りましょう。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_login_2.ogg"},{"description":"ch0318_memoriallobby_1_1","category":"lobby","text":"这里是，荧幕的背面。","text_original":"ここは、スクリーンの裏側です。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_1_1.ogg"},{"description":"ch0318_memoriallobby_1_2","category":"lobby","text":"也就是，舞台的背面……。","text_original":"つまり、舞台裏……。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_1_2.ogg"},{"description":"ch0318_memoriallobby_2_1","category":"lobby","text":"是只有作家才能自由进出的空间。","text_original":"作家だけが出入りできる空間です。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_2_1.ogg"},{"description":"ch0318_memoriallobby_2_2","category":"lobby","text":"进入这里的唯一方法……就是得到身为作家的我的许可。","text_original":"ここに入る唯一の方法は……作家である私に許可を取ること。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_2_2.ogg"},{"description":"ch0318_memoriallobby_3_1","category":"lobby","text":"所以，现在这里——","text_original":"だから、ここは今――","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_3_1.ogg"},{"description":"ch0318_memoriallobby_3_2","category":"lobby","text":"只有老师和我两人……独处……","text_original":"先生と私、二人……きりの……。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_3_2.ogg"},{"description":"ch0318_memoriallobby_4_1","category":"lobby","text":"啊！不对不对不对！我，不是那个意思！","text_original":"って！いやいやいや！そ、そうじゃなくてですね！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_4_1.ogg"},{"description":"ch0318_memoriallobby_4_2","category":"lobby","text":"总之！我做了份便当带过来……","text_original":"とにかく！お弁当を作ってきたんですけど……。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_4_2.ogg"},{"description":"ch0318_memoriallobby_5_1","category":"lobby","text":"那个，如果您不介意的话……","text_original":"えっと、もし、よろしければ……。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_5_1.ogg"},{"description":"ch0318_memoriallobby_5_2","category":"lobby","text":"……要和我，一起吃吗？","text_original":"……一緒に、食べませんか？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_memoriallobby_5_2.ogg"},{"description":"ch0318_relationship_up_1","category":"growup","text":"媒体、艺术……要不要让我来教教您这些呢？","text_original":"メディアに、芸術……私なりに教えて差し上げましょうか？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_relationship_up_1.ogg"},{"description":"ch0318_relationship_up_2","category":"growup","text":"真奇怪呢。和老师聊天时，不知不觉就会忘记时间。","text_original":"おかしいですよね。先生としゃべっていると、つい時間を忘れちゃうんです。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_relationship_up_2.ogg"},{"description":"ch0318_relationship_up_3","category":"growup","text":"那个……老师喜欢看电影吗？诶……啊，不是，我没别的意思！","text_original":"あの……映画はお好きですか？えっ……あ、いえ、他意は無いんですが……！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_relationship_up_3.ogg"},{"description":"ch0318_relationship_up_4","category":"growup","text":"明明随时都能见到老师……但不知为何，我却总想着要把您留在手边……","text_original":"いつでも会えるのに……。なぜでしょう。手元に置いておきたい、と思ってしまうのは……。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_relationship_up_4.ogg"},{"description":"ch0318_season_birthday","category":"lobby","text":"生日礼物……我想要的东西吗……。我倒是不需要什么东西……我，能占用老师一天的时间吗？","text_original":"誕生日プレゼント……私の欲しいモノ、ですか……。モノはいらないので……一日、先生のお時間をいただけませんか？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_season_birthday.ogg"},{"description":"ch0318_season_birthday_player","category":"lobby","text":"生日快乐！老师！我做了个庆生视频……要、要一起看看吗……？","text_original":"ハッピーバースデー！先生！お祝いの動画を作ってきたのですが……い、一緒に観ませんか……？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_season_birthday_player.ogg"},{"description":"ch0318_season_halloween","category":"lobby","text":"请稍等一下，老师。正好，我刚弄到了新鲜的南瓜！","text_original":"少々お待ちください、先生。ちょうど、新鮮なカボチャを手に入れましたので！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_season_halloween.ogg"},{"description":"ch0318_season_newyear","category":"lobby","text":"新年快乐，老师。……咦？啊，这个吗？是昨天的录像。电视里放的除夕钟声，总共108下。那么……该怎么把它变成艺术呢。","text_original":"明けましておめでとうございます、先生。……はい？ああ、これですか？昨日の録画データです。テレビでやってた、除夜の鐘の。締めて108回分。さて……これをどう芸術にしましょうかね。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_season_newyear.ogg"},{"description":"ch0318_season_xmas","category":"lobby","text":"我正好进货了圣诞服……。您、您好奇吗……？","text_original":"ちょうど、仕入れてきたサンタ服があるんですけど……。き、気になりますか……？","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_season_xmas.ogg"},{"description":"ch0318_tactic_defeat_1","category":"battle","text":"呜……对不起……","text_original":"はうぅぅ...ごめんなさい...","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_tactic_defeat_1.ogg"},{"description":"ch0318_tactic_defeat_2","category":"battle","text":"对不起刚刚我得意忘形了……","text_original":"調子こいですみません","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_tactic_defeat_2.ogg"},{"description":"ch0318_tactic_in_1","category":"battle","text":"那么，开始市场调研吧。","text_original":"さて、市場調査といきますか。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_tactic_in_1.ogg"},{"description":"ch0318_tactic_in_2","category":"battle","text":"要有什么东西才能赢呢……","text_original":"どんなモノがあれば勝てるかな……。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_tactic_in_2.ogg"},{"description":"ch0318_tactic_victory_1","category":"battle","text":"呵呵，不出所料。","text_original":"ふふ、予想通りです。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_tactic_victory_1.ogg"},{"description":"ch0318_tactic_victory_2","category":"battle","text":"您的“胜利”到货了。啊，印章请盖在这里。","text_original":"「勝利」をお届けに参りました。あ、ハンコはこちらに。","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/ch0318_tactic_victory_2.ogg"},{"description":"CH0318_Title","category":"lobby","text":"这里是蔚蓝档案！","text_original":"ブルーアーカイブ！ですよ～！","file":"//static.kivo.wiki/voices/students/%E8%8B%A5%E7%8B%AD%20%E5%86%AC%E4%BC%98/original/jp/CH0318_Title.ogg"}],"voice_cn":[],"voice_kr":[],"gift_data":[{"id":83,"favorability":60},{"id":17,"favorability":40},{"id":27,"favorability":40},{"id":31,"favorability":40},{"id":85,"favorability":240}],"furniture":[1800],"character_datas":[{"character_id":10128,"dev_name":"CH0318","combat_style":"default","type":"Support","attack_attribute":"Vibration","defensive_attributes":"Special","is_groupc_control":false,"team_position":"MIDDLE","battlefield_position":"STRIKER","rarity":3,"limited":false,"outdoor_adaptability":"D","indoor_adaptability":"B","street_adaptability":"S","favorite_equipment":0,"weapons":{"name":"亲切的引诱","name_cn":""}}],"info_declare_uuid":"7142f997-4613-47e9-84f1-fc5c159a0d6a","skill_declare_uuid":"8d9084c0-10c9-419d-8ba1-6017199fd1ea","supplementary_uuid":"a8b6ea10-6242-4119-8c80-4eb2014be4c6","supplementary_declare_uuid":"719e24f3-19bd-4335-9b65-c2c063f5d041","created_at":1758352938,"updated_at":1768589019},"message":"OK","success":true,"time":1768764537,"version":"1.0.0-beta.42"}