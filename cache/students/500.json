E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Battle_Recovery_1.ogg"},{"description":"CH0275_Battle_Retire","category":"battle","text":"演出，还没……","text_original":"ステージは、まだ…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Battle_Retire.ogg"},{"description":"CH0275_Battle_Shout_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Battle_Shout_1.ogg"},{"description":"CH0275_Battle_Shout_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Battle_Shout_2.ogg"},{"description":"CH0275_Battle_Shout_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Battle_Shout_3.ogg"},{"description":"CH0275_Battle_TacticalAction_1","category":"battle","text":"哈！","text_original":"はっ！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Battle_TacticalAction_1.ogg"},{"description":"CH0275_Battle_Victory_1","category":"battle","text":"真是场精彩的演出。","text_original":"素晴らしいステージでした。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Battle_Victory_1.ogg"},{"description":"CH0275_Battle_Victory_2","category":"battle","text":"让柔和的旋律回荡在这会场！","text_original":"会場にやわらかな旋律を！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Battle_Victory_2.ogg"},{"description":"CH0275_Cafe_monolog_1","category":"cafe","text":"这里……","text_original":"ここは…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Cafe_monolog_1.ogg"},{"description":"CH0275_Cafe_monolog_2","category":"cafe","text":"我挺喜欢的。","text_original":"大変気に入りました。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Cafe_monolog_2.ogg"},{"description":"CH0275_Cafe_monolog_3","category":"cafe","text":"虽然我想练习一下舞蹈……","text_original":"振り付けの練習をしたいのですが…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Cafe_monolog_3.ogg"},{"description":"CH0275_Cafe_monolog_4","category":"cafe","text":"呵呵，观众真多啊……","text_original":"ふふ、オーディエンスがたくさんいますね…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Cafe_monolog_4.ogg"},{"description":"CH0275_Cafe_monolog_5","category":"cafe","text":"为了不辜负大家的期待，必须勤加练习……！","text_original":"ご期待に応えられるよう、練習しなければ…！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Cafe_monolog_5.ogg"},{"description":"CH0275_CommonSkill","category":"battle","text":"随着节奏律动吧！","text_original":"リズムに乗って！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_CommonSkill.ogg"},{"description":"CH0275_EventLobby_1","category":"event","text":"老师……您有什么事吗？","text_original":"先生……なにか御用でしょうか？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_EventLobby_1.ogg"},{"description":"CH0275_EventLobby_2","category":"event","text":"这也是……粉丝福利吗？","text_original":"これもファンサービス…なのでしょうか？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_EventLobby_2.ogg"},{"description":"CH0275_EventLobby_3","category":"event","text":"只要老师觉得开心，那便足够了。","text_original":"先生に楽しんでいただけたのなら、それで十分です。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_EventLobby_3.ogg"},{"description":"CH0275_EventLobby_4","category":"event","text":"啊，啊——，啊——。……为了能随时开嗓，我刚刚在做发声练习。","text_original":"あ、あ―、あ―。……いつでも歌えるよう、発声練習をしておりました。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_EventLobby_4.ogg"},{"description":"CH0275_EventLogin_1","category":"event","text":"您好，老师。您是来看我……不是，看演出的吧？","text_original":"こんにちは、先生。私…ではなく、ステージを見に来られたのですよね。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_EventLogin_1.ogg"},{"description":"CH0275_EventLogin_2","category":"event","text":"等您很久了，老师。座位已经为您准备好了，请坐吧。","text_original":"お待ちしておりました、先生。お席をご用意しております。どうぞおかけください。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_EventLogin_2.ogg"},{"description":"CH0275_EventLogin_Season_1","category":"event","text":"演出还要继续哦，集中精神！","text_original":"ステージは続いておりますよ、集中してください！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_EventLogin_Season_1.ogg"},{"description":"CH0275_EventLogin_Season_2","category":"event","text":"请您听到最后吧。","text_original":"最後まで、聞いていってくださいね。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_EventLogin_Season_2.ogg"},{"description":"CH0275_EventLogin_Season_End","category":"event","text":"呵呵，真是场精彩的演出。","text_original":"ふふ、とても素敵なステージでした。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_EventLogin_Season_End.ogg"},{"description":"CH0275_ExSkill_1","category":"battle","text":"献上我们的歌声！","text_original":"私たちの歌声を届けます！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_ExSkill_1.ogg"},{"description":"CH0275_ExSkill_2","category":"battle","text":"来，开始吧！","text_original":"さあ、参りましょう！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_ExSkill_2.ogg"},{"description":"CH0275_ExSkill_3","category":"battle","text":"开始最后的冲刺吧！","text_original":"ラストスパート、いきましょう！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_ExSkill_3.ogg"},{"description":"CH0275_ExSkill_Level_1","category":"battle","text":"哈——！","text_original":"はああっ！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_ExSkill_Level_1.ogg"},{"description":"CH0275_ExSkill_Level_2","category":"battle","text":"上吧！","text_original":"参ります！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_ExSkill_Level_2.ogg"},{"description":"CH0275_ExSkill_Level_3","category":"battle","text":"大家一起来吧！","text_original":"皆様ご一緒に！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_ExSkill_Level_3.ogg"},{"description":"CH0275_ExWeapon_Get","category":"growup","text":"这种关系……就像偶像与经纪人一样呢。老师在背后支持，我则站上舞台。若真是这样就好了……可惜呢。","text_original":"この関係……まるで、アイドルとマネージャーのようですね。先生が支援し、私が表舞台に立つ。本当にそうなら、よかったのですが……残念です。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_ExWeapon_Get.ogg"},{"description":"CH0275_Formation_In_1","category":"formation","text":"这事就包在我身上吧！","text_original":"この件は私にお任せください。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Formation_In_1.ogg"},{"description":"CH0275_Formation_In_2","category":"formation","text":"我保证，会为您呈现精准的表演。","text_original":"正確なパフォーマンスを、お約束いたします。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Formation_In_2.ogg"},{"description":"CH0275_Formation_Select","category":"formation","text":"呵呵，在叫我吗？","text_original":"ふふ、お呼びでしょうか？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Formation_Select.ogg"},{"description":"CH0275_Gachaget","category":"growup","text":"我是救护骑士团……不，是Antique·Seraphim的成员，苍森美弥。请多多指教。","text_original":"救護騎士団……いえ、アンティーク・セラフィムのメンバー。蒼森ミネと申します。どうぞよろしくお願いいたします。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Gachaget.ogg"},{"description":"CH0275_Growup_1","category":"growup","text":"感谢您的支持，老师。这份心意，我确实收到了。","text_original":"ご支援ありがとうございます、先生。たしかに、受け取りました。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Growup_1.ogg"},{"description":"CH0275_Growup_2","category":"growup","text":"老师的支持……我由衷感激。这样的机会并不多见，感觉很奇妙。","text_original":"先生からの支援……感謝いたします。あまりこういう機会がないので、とても不思議な感覚です。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Growup_2.ogg"},{"description":"CH0275_Growup_3","category":"growup","text":"为了呈现更精彩的演出，我会全力以赴的！","text_original":"より良いステージをお届けできるよう、尽力いたしますね。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Growup_3.ogg"},{"description":"CH0275_Growup_4","category":"growup","text":"这是……呵呵。还请期待我今后的表现吧。","text_original":"これは……ふふ。今後に期待していてくださいね。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Growup_4.ogg"},{"description":"CH0275_Lobby_1","category":"lobby","text":"穿着这身衣服值日，感觉有点奇怪呢……","text_original":"なんだかこの格好で当番をするのは不思議な気分ですね…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Lobby_1.ogg"},{"description":"CH0275_Lobby_2","category":"lobby","text":"您看起来很累了……要不要听一首提神醒脑的歌呢？","text_original":"お疲れのご様子ですね…疲労回復の歌など、いかがでしょうか？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Lobby_2.ogg"},{"description":"CH0275_Lobby_3","category":"lobby","text":"虽然平时总是我在向老师学习……","text_original":"いつも先生から教えていただいてばかりの私ですが…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Lobby_3.ogg"},{"description":"CH0275_Lobby_4","category":"lobby","text":"但如果是唱歌与舞蹈的话，我也许能教您一些。","text_original":"ダンスと歌でしたら、お教えできるかもしれません。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Lobby_4.ogg"},{"description":"CH0275_Lobby_5","category":"lobby","text":"如果有什么要求的话，请尽管说。这也是粉丝福利的一环。","text_original":"何かご要望がありましたら、何なりとお申し付けください。これもファンサービスの一環、です。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Lobby_5.ogg"},{"description":"CH0275_LogIn_1","category":"lobby","text":"欢迎回来，老师。我有些事想和您商量，您有时间吗？","text_original":"おかえりなさい、先生。ご相談したいことがあるのですが、少しお時間、よろしいでしょうか？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_LogIn_1.ogg"},{"description":"CH0275_LogIn_2","category":"lobby","text":"来得正好呢。我刚刚才结束彩排。","text_original":"ちょうど良いところにいらっしゃいましたね。さきほど、リハーサルが終了いたしました。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_LogIn_2.ogg"},{"description":"CH0275_MemorialLobby_1_1","category":"lobby","text":"这，这个……那个……","text_original":"こ、これは…その…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_1_1.ogg"},{"description":"CH0275_MemorialLobby_1_2","category":"lobby","text":"虽然和我想的……有点不太一样……！","text_original":"想定していたものと…違う気がするのですが…！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_1_2.ogg"},{"description":"CH0275_MemorialLobby_2_1","category":"lobby","text":"不，不是！倒也不是……讨厌……","text_original":"い、いえ！嫌というわけでは…ないのですが…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_2_1.ogg"},{"description":"CH0275_MemorialLobby_2_2","category":"lobby","text":"但，但是！也不能说是喜欢……！","text_original":"で、ですが！好きというわけでもないです…！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_2_2.ogg"},{"description":"CH0275_MemorialLobby_3_1","category":"lobby","text":"确实，我自己是喜欢可爱的东西……","text_original":"たしかに、私自身はかわいいものが好きですが…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_3_1.ogg"},{"description":"CH0275_MemorialLobby_3_2","category":"lobby","text":"但“可爱”的东西是自己……","text_original":"「かわいい」の対象が自分というのは…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_3_2.ogg"},{"description":"CH0275_MemorialLobby_4_1","category":"lobby","text":"那，那种……那种状况……","text_original":"そ、その…そういう状況を…","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_4_1.ogg"},{"description":"CH0275_MemorialLobby_4_2","category":"lobby","text":"我没料想到……","text_original":"想定していたわけでは…！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_4_2.ogg"},{"description":"CH0275_MemorialLobby_5_1","category":"lobby","text":"您，您在捉弄我对吧，老师？","text_original":"か、からかっていますよね、先生？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_5_1.ogg"},{"description":"CH0275_MemorialLobby_5_2","category":"lobby","text":"别，别说那种话了……！","text_original":"そ、そんな言葉を言わないでください…！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_5_2.ogg"},{"description":"CH0275_MemorialLobby_5_3","category":"lobby","text":"我……我该怎么办啊……！","text_original":"わ、私……どうすれば……！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_MemorialLobby_5_3.ogg"},{"description":"CH0275_Relationship_Up_1","category":"growup","text":"那个……总感觉和老师有点距离感。如果您不介意的话……能再靠近一点吗？","text_original":"その……先生との距離を感じてしまって。そういうつもりではないのでしたら……もう少し、近づいていただけますか？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Relationship_Up_1.ogg"},{"description":"CH0275_Relationship_Up_2","category":"growup","text":"虽然穿着平时不会穿的衣服，但不知为何却感觉很心安。这是为什么呢……？","text_original":"普段と違う衣装なのに、何故だか心が落ち着くのです。どうしてでしょう……？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Relationship_Up_2.ogg"},{"description":"CH0275_Relationship_Up_3","category":"growup","text":"若是有什么我能做的，请随时吩咐。","text_original":"何かできることがありましたら、何なりと。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Relationship_Up_3.ogg"},{"description":"CH0275_Relationship_Up_4","category":"growup","text":"心跳得好快……肯定是因为演出要开始了对吧……","text_original":"この胸の高鳴り……きっと本番が近いからなのだと、思います……。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Relationship_Up_4.ogg"},{"description":"CH0275_Season_Birthday","category":"lobby","text":"您还记得啊。那个……作为我的生日礼物……能不能和您一起出去走走？","text_original":"…覚えていてくださったのですね。その…誕生日プレゼントとして…一緒にお出かけしませんか？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Season_Birthday.ogg"},{"description":"CH0275_Season_Birthday_Player","category":"lobby","text":"生日快乐，老师。我为您献上一首祝福的歌曲如何？","text_original":"お誕生日、おめでとうございます、先生。お祝いに一曲、歌ってもよろしいでしょうか。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Season_Birthday_Player.ogg"},{"description":"CH0275_Season_Halloween","category":"lobby","text":"这，这身打扮，不是为那种场合准备的……不过，说是变装的话，好像也没错。","text_original":"こ、この格好は、そういうつもりでは……ですが、仮装と言われたらそうかもしれません。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Season_Halloween.ogg"},{"description":"CH0275_Season_NewYear","category":"lobby","text":"新年快乐，老师。愿今年在舞台上见到您的日子，多过在救护现场相见的日子。","text_original":"明けましておめでとうございます、先生。今年は救護の場ではなく、ステージでお会いする日が多くなるよう祈っております。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Season_NewYear.ogg"},{"description":"CH0275_Season_Xmas","category":"lobby","text":"圣诞节……是唱颂歌的日子，对吧？","text_original":"聖なる日…キャロルを歌う日、で間違いないでしょうか？","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Season_Xmas.ogg"},{"description":"CH0275_Tactic_Defeat_1","category":"battle","text":"是我的过错。","text_original":"私の落ち度です。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Tactic_Defeat_1.ogg"},{"description":"CH0275_Tactic_Defeat_2","category":"battle","text":"究竟，是从哪里开始出错了……。","text_original":"一体、どこから間違ってしまったのでしょう。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Tactic_Defeat_2.ogg"},{"description":"CH0275_Tactic_In_1","category":"battle","text":"让我们献上一段难忘的时光。","text_original":"心に残るひとときを、お届けしましょう。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Tactic_In_1.ogg"},{"description":"CH0275_Tactic_In_2","category":"battle","text":"呵呵，敬请期待吧。","text_original":"ふふっ、ご期待ください。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Tactic_In_2.ogg"},{"description":"CH0275_Tactic_Victory_1","category":"battle","text":"如何？我很期待您的感想哦。","text_original":"いかがでしょうか？感想をお待ちしております。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Tactic_Victory_1.ogg"},{"description":"CH0275_Tactic_Victory_2","category":"battle","text":"呼……终于顺利唱完了。","text_original":"ふぅ……無事歌い切ることができました。","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Tactic_Victory_2.ogg"},{"description":"CH0275_Title","category":"lobby","text":"蔚蓝档案！","text_original":"ブルーアーカイブ！","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/jp/CH0275_Title.ogg"}],"voice_cn":[],"voice_kr":[{"description":"ch0275_battle_buffed_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/kr/ch0275_battle_buffed_1.ogg"},{"description":"ch0275_battle_buffself_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/kr/ch0275_battle_buffself_1.ogg"},{"description":"ch0275_battle_covered_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/kr/ch0275_battle_covered_1.ogg"},{"description":"ch0275_battle_damage_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/kr/ch0275_battle_damage_1.ogg"},{"description":"ch0275_battle_damage_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/kr/ch0275_battle_damage_2.ogg"},{"description":"ch0275_battle_damage_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/kr/ch0275_battle_damage_3.ogg"},{"description":"ch0275_battle_defense_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8B%8D%E6%A3%AE%20%E7%BE%8E%E5%BC%A5/%E5%81%B6%E5%83%8F/kr/ch0275_battle_defense_1.ogg"},{"description":"ch0275_battle_in_1","category":"battle","text":"","text_original":"","file":"//st