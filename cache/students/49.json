.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/rbQR6NNFySbEKDLEHfP2ThDxN8lCSIGS.ogg"},{"description":"CH0177_Cafe_monolog_3.ogg","category":"cafe","text":"今年の初夢……なんだったっけ？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/gVNFjCp5YT6WFsvZqqAUDAypnuoLpA8R.ogg"},{"description":"CH0177_Cafe_monolog_4.ogg","category":"cafe","text":"どうか今年は、穏やかな日々が続きますように……。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/ol1kw4ID5tWPHEje5CYlPgnBriaxNdn0.ogg"},{"description":"CH0177_Cafe_monolog_5.ogg","category":"cafe","text":"ふぅ、ここなら少し休めるかな……？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/ED6dWVUCwn55VV46rz6OViw11Pq53I6l.ogg"},{"description":"CH0177_CommonSkill.ogg","category":"battle","text":"気を付けてください。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/TBCr7ru1D2GOne9wiLfJIW49nrvocUZu.ogg"},{"description":"CH0177_CommonTSASkill.ogg","category":"other","text":"どうでしたか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/KCdVH2bcuEGn9D6CVu5FD6ij7UJXOpq0.ogg"},{"description":"CH0177_EventLobby_1.ogg","category":"event","text":"はい、先生？どうかしましたか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/mRKnz37ryEfaisz708vObHdEyUiKPB0e.ogg"},{"description":"CH0177_EventLobby_2.ogg","category":"event","text":"このスクーターは色々なことに使っているんですよ。 これまで無くなってしまったら…どうしましょう…。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/ClFX1NaUXi2DxjyiEhIs2fiLMGMXOE1j.ogg"},{"description":"CH0177_EventLobby_3.ogg","category":"event","text":"おせち以外のお正月料理にも挑戦してみたいです！ でも、作ったものを全部食べたら…太ってしまいそう…。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/ts30yCFsoPZoRBQl3adorD6dx10XeNp6.ogg"},{"description":"CH0177_EventLobby_4.ogg","category":"event","text":"新年のお願い…ではありませんが、 今年は給食室が無事でありますように…。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/zUDBcIk7ApODsExUMEUXINtUH0XFjDvD.ogg"},{"description":"CH0177_EventLogin_1.ogg","category":"event","text":"こんにちは、先生！新年のお願いは決まりましたか？ 私も隣でお祈りしますね！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/p4oT6oSpvzfDH5rhn7yWkVbt7SgfO2xf.ogg"},{"description":"CH0177_EventLogin_2.ogg","category":"event","text":"寒くありませんか？温かい食事でもいかがでしょう？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/3gejPdmpQhagw7EZFjmx0VOCLOTBjEAd.ogg"},{"description":"CH0177_EventLogin_Season_1.ogg","category":"lobby","text":"はい…今こそ料理の腕前を披露するときですね！ 私、頑張りますから…見守ってくださると嬉しいです。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/abjMkv3vjx5mIYnkdHcuYczwSCQTmLUX.ogg"},{"description":"CH0177_EventLogin_Season_2.ogg","category":"lobby","text":"なんだかすごいことになってしまいましたが、私のやることは変わりません。 ただ最善を尽くす、それだけです。 それに…先生がそばにいてくださりますから百人力です！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/Qfe5kiznklnRHzm8glfJ5t5gy1DQ35kf.ogg"},{"description":"CH0177_EventLogin_Season_End.ogg","category":"lobby","text":"無事に終わって良かったです。 その…私の料理、お口に合いましたか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/amf58rajLVsmX1Rrydjqs7BDLlBqA1DJ.ogg"},{"description":"CH0177_EventShop_1.ogg","category":"event","text":"大丈夫ですよ。心配しないでください。 倉庫の管理でしたら、それなりに自信がありますから。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/8tMoiMAUnRjA8E4dl2qrqDI3hGqxmjzg.ogg"},{"description":"CH0177_EventShop_2.ogg","category":"event","text":"えっ？給食部の特製料理、ですか…？ もしよろしければお作りしましょうか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/rBc9XSgsPyM6RkE1hIEaDr0QhIhQh2n0.ogg"},{"description":"CH0177_EventShop_Buy_1.ogg","category":"event","text":"あ、それでしたら少々お待ちください。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/xo9fSNKPscWHdYLySjc6iD0vT1XZ2ycB.ogg"},{"description":"CH0177_EventShop_Buy_2.ogg","category":"event","text":"そちら、いちおしの商品です！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/1b15xfeTfCzjdIopk4TBKCJbBSeRqQ40.ogg"},{"description":"CH0177_EventShop_Buy_3.ogg","category":"event","text":"えっと…はい、こちらですね？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/qDtcZSeRNviXrhxoQF5vwtHt21x0X6kI.ogg"},{"description":"CH0177_EventShop_Buy_4.ogg","category":"event","text":"気に入っていただけましたか？また来てくださいね！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/anpiW1VTQ0OxyziFwjxAIblitz39N9Fp.ogg"},{"description":"CH0177_EventShop_End.ogg","category":"event","text":"お祭りも料理大会も終わりましたね。 私は明日の下ごしらえが残っていますが…先生はゆっくりしててくださいね。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/Bpyme1ANS2WBS5clsxngVttov73ggjzr.ogg"},{"description":"CH0177_EventShop_Login_1.ogg","category":"event","text":"先生、いらっしゃいませ。商店街の方に色々なものを用意していただきました！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/SuKMS8uv51ajRGYLm3woNrDIjcAPUohV.ogg"},{"description":"CH0177_EventShop_Login_2.ogg","category":"event","text":"売り子さんをするの、初めてなんです。えへへ。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/hg0YS5R50xBbmESn7rLbeumg4BzVOhNm.ogg"},{"description":"CH0177_ExSkill_1.ogg","category":"battle","text":"それでは行きましょうか。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/5WGPmAUTE1pdBE6jw2itPt1j8pHiNrgd.ogg"},{"description":"CH0177_ExSkill_2.ogg","category":"battle","text":"心を込めて作りました！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/tcYVERgnpleD7XSCPKJRoBI7AmX1jCle.ogg"},{"description":"CH0177_ExSkill_3.ogg","category":"battle","text":"出発しますね。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/yxSK2kqVdUYMLO30uva6UeevpNXJYka2.ogg"},{"description":"CH0177_ExSkill_Level_1.ogg","category":"battle","text":"給食部の特製おせちです！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/zLpe2oSKZ8uV2KuV60AKmlW7NrgrKgRt.ogg"},{"description":"CH0177_ExSkill_Level_2.ogg","category":"battle","text":"真心いっぱいですよ！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/17FVM6WiCff79PIA6vOoXXb1oILE6Hvz.ogg"},{"description":"CH0177_ExSkill_Level_3.ogg","category":"battle","text":"おかわりなら、たくさんありますよ。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/kkW4xG9iErGh7KtbAfDLjgCfo0QPkdrV.ogg"},{"description":"CH0177_ExWeapon_Get.ogg","category":"growup","text":"不思議です……先生がそばにいると、何でもできそうな気持ちになるんです。今年も頑張りますから、どうか、見守っていてくださいね。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/geTr6NfLr2sBydUh9K9N2Eq4jh1PSQjb.ogg"},{"description":"CH0177_Formation_In_1.ogg","category":"formation","text":"準備はできています。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/IoFboJma2yKlHThqqLLbWQpQOSNtmQSR.ogg"},{"description":"CH0177_Formation_In_2.ogg","category":"formation","text":"お正月料理をご用意しますね。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/JeEeV8Iox8T8Yry4Yd5X6QohRSJH98Nx.ogg"},{"description":"CH0177_Gachaget.ogg","category":"growup","text":"先生、年越しそばは食べましたか？今年はお互い、穏やかな一年を過ごせますように。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/M9CQrAWFWAgLjRIpIR88rjTAKj7FE2k7.ogg"},{"description":"CH0177_Growup_1.ogg","category":"growup","text":"いつもありがとうございます、先生。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/SaCrrKonCKzDaLfBEdqnFil4bk43aMcO.ogg"},{"description":"CH0177_Growup_2.ogg","category":"growup","text":"これを私に？頂いてもよいのでしょうか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/rikuHcanFnSsKCEPC7eMPty2q0yFXyy1.ogg"},{"description":"CH0177_Growup_3.ogg","category":"growup","text":"どうしましょう、お返しできるものが何も……え？すでにもらっている……？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/KLOIQI1TdOZXrP7zh9H1zYkLWcuenpXT.ogg"},{"description":"CH0177_Growup_4.ogg","category":"growup","text":"こんなに成長できるだなんて……全部、先生のおかげです。ありがとうございます。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/2GN21elkS2CiuKlJAhFAWMc9FH7q59iT.ogg"},{"description":"CH0177_Lobby_1.ogg","category":"lobby","text":"そ、その……着物、どう、でしょうか？気に入っていただけたら、嬉しいのですが……。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/5mGRIGgdaWerVJF0iFfqyLBmNQPreU1b.ogg"},{"description":"CH0177_Lobby_2.ogg","category":"lobby","text":"先生に着物姿を見てもらうのは緊張しましたけど、頑張って良かったです。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/62bjvle15iYEfOXjvfRw0Vv26XvroQWg.ogg"},{"description":"CH0177_Lobby_3.ogg","category":"lobby","text":"知っていましたか？先生の頑張る姿は生徒たちの励みになっているんです。もちろん……私にとってもです、えへへっ。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/PLNovSVI7agXv8vOq1lp0WkASPKBiaZs.ogg"},{"description":"CH0177_Lobby_4.ogg","category":"lobby","text":"おせちは手間のかかる料理ですが、そういうものこそ作り甲斐があるんです。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/D0dlPTplZ6yBl1ZI8OOkt5ezA9uNQWNP.ogg"},{"description":"CH0177_Lobby_5.ogg","category":"lobby","text":"こうして先生と一緒にいると、なんだか気が緩んでしまいます。そろそろ行かないと……えっ？もう少し一緒に、ですか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/nqKYtzlW2TVYkp8v21n2NSLcHLMWPLbX.ogg"},{"description":"CH0177_LogIn_1.ogg","category":"lobby","text":"あ、先生！おかえりなさい。お腹は空いていませんか？何かお作りしましょうか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/rhAqMCOH5c4rY1rBekBiv2p7PbhYlpT1.ogg"},{"description":"CH0177_LogIn_2.ogg","category":"lobby","text":"おかえりなさい！すぐにお食事を温めますね。今日も愛情を込めてご用意しました。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/FbnwLzql9rtwWPZOO2cIbUEqIXYaFv0T.ogg"},{"description":"CH0177_MemorialLobby_1.ogg","category":"lobby","text":"本当に……嬉しいです。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/JU1kzyysul3Ws5ygMKvGqBuIT8QQE2L6.ogg"},{"description":"CH0177_MemorialLobby_2.ogg","category":"lobby","text":"いつもありがとうございます、先生。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/Qi3O9PgiFsgZ6JryDBfmR2pyZ3rIn4bt.ogg"},{"description":"CH0177_MemorialLobby_3_1.ogg","category":"lobby","text":"先生からは、色々といただいてばかりですね。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/WgSy2e4bXCbLZtgW6qRIQkQ3OM5T1oEP.ogg"},{"description":"CH0177_MemorialLobby_3_2.ogg","category":"lobby","text":"私の料理を、誰よりもおいしく食べてくださるのは……いつも先生で……。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/rYVNYb9F0f1DL8FrIRA0A7gvYL0p33TL.ogg"},{"description":"CH0177_MemorialLobby_4.ogg","category":"lobby","text":"それが……私にとって、一番のプレゼントなんです。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/CMTCbTCK2XnTkh2HnQB8xxNqbfyn0rbG.ogg"},{"description":"CH0177_MemorialLobby_5_1.ogg","category":"lobby","text":"なので、その……先生。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/xlYShPN0VDvTVfbkUryVXaDw4xEpp7FI.ogg"},{"description":"CH0177_MemorialLobby_5_2.ogg","category":"lobby","text":"これからも、お願いしますね？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/F7VLam9Jsx296dYV45S4bzwEFZx93pUb.ogg"},{"description":"CH0177_Relationship_Up_1.ogg","category":"growup","text":"何かあったら、いつでも声をかけてくださいね？……いつでも、ですよ？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/eQv0xcrxgoZhPii0HCDigUgKE6znn5TI.ogg"},{"description":"CH0177_Relationship_Up_2.ogg","category":"growup","text":"先生と一緒に過ごす日々は、私にとって、かけがえのない時間なんです。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/JCPUBBqwxXxjUjlaah23vDG3FhFC4V0s.ogg"},{"description":"CH0177_Relationship_Up_3.ogg","category":"growup","text":"せ、先生？えへへっ、呼んでみたかっただけです。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/jMTGKjPAeDcGaqenhiAtG4zWpRaaT7Ln.ogg"},{"description":"CH0177_Relationship_Up_4.ogg","category":"growup","text":"先生に、伝えたい言葉があるんです。……いつか伝えるので、待っていてくれますか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/IXMmji3PgLYEyGzqPs4G56PVD5L77rwI.ogg"},{"description":"CH0177_Season_Birthday.ogg","category":"lobby","text":"わあ……私の誕生日、覚えていてくださったんですね。 ありがとうございます……！ 先生からのお言葉だけで、胸がいっぱいです。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/YYjyRggBZukAAOJJJOkaiSgf7iYihL5T.ogg"},{"description":"CH0177_Season_Birthday_Player.ogg","category":"lobby","text":"先生のお誕生日ですね！おめでとうございます。 私もお祝いできてうれしいです！ 今日はどんな料理がいいですか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/SELs8w7cSaNqH7w1Wa7rT4hdyNd26xzY.ogg"},{"description":"CH0177_Season_Halloween.ogg","category":"lobby","text":"ハロウィーンの季節は活気があって楽しいですね。 飾り用のジャック・オー・ランタンも、後で食べられたら良いのですが……。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/kxPc3UhNirnI0qgpWZRcEEY7ur9uMBtB.ogg"},{"description":"CH0177_Season_NewYear.ogg","category":"lobby","text":"あけましておめでとうございます、先生。 せっかくのお正月なので、着物に袖を通してみました。 おせちも用意してありますよ。一緒にいかがですか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/iOR4TtoPuvYjQTLqsNumx8jRKVIDAmlk.ogg"},{"description":"CH0177_Season_Xmas.ogg","category":"lobby","text":"もうクリスマス……今年も終わりが近づいてきましたね。 ささやかなパーティーの準備をしようと思うのですが、先生もいかがですか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/6vUPk5rBbx6IvI83FTHh4tdX9mpXJRHW.ogg"}],"voice_cn":[{"description":"ch0177_cafe_monolog_1","category":"cafe","text":"烹饪时准确称重 是很重要的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_cafe_monolog_1.ogg"},{"description":"ch0177_cafe_monolog_2","category":"cafe","text":"这件和服…… 好漂亮啊。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_cafe_monolog_2.ogg"},{"description":"ch0177_cafe_monolog_3","category":"cafe","text":"今年的初梦…… 是什么来着？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_cafe_monolog_3.ogg"},{"description":"ch0177_cafe_monolog_4","category":"cafe","text":"祈愿今年风平浪静 的日子可以延续下去……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_cafe_monolog_4.ogg"},{"description":"ch0177_cafe_monolog_5","category":"cafe","text":"啊…… 我可以在这里 休息一会儿吗……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_cafe_monolog_5.ogg"},{"description":"ch0177_commonskill","category":"battle","text":"要小心啊。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_commonskill.ogg"},{"description":"ch0177_commontsaskill","category":"other","text":"怎么样？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_commontsaskill.ogg"},{"description":"ch0177_eventlobby_1","category":"event","text":"嗯？老师？ 有什么事吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventlobby_1.ogg"},{"description":"ch0177_eventlobby_2","category":"event","text":"这辆小摩托用处可多了，如果连这个都没有了…… 我该怎么办……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventlobby_2.ogg"},{"description":"ch0177_eventlobby_3","category":"event","text":"除了御节料理， 我还想做做其他的新年美食。嗯，不过要是把做的 都吃光的话…… 应该会长胖吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventlobby_3.ogg"},{"description":"ch0177_eventlobby_4","category":"event","text":"虽然算不上是…… 新年愿望……但我希望今年食堂 能一切顺利……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventlobby_4.ogg"},{"description":"ch0177_eventlogin_1","category":"event","text":"您好，老师！ 新年愿望已经想好了吗？我会和您一起祈祷的！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventlogin_1.ogg"},{"description":"ch0177_eventlogin_2","category":"event","text":"您不冷吗？ 要不要给您 准备些热腾腾的食物呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventlogin_2.ogg"},{"description":"ch0177_eventlogin_season_1","category":"event","text":"嗯……现在正是 展露我厨艺的时候！我会努力的…… 如果您能给我一些关注， 就更好了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventlogin_season_1.ogg"},{"description":"ch0177_eventlogin_season_2","category":"event","text":"不知道为什么， 事情好像变得很复杂…… 但我要做的事没有变。就是全力以赴，仅此而已。而且……因为有老师陪着我， 我感觉心里十分踏实！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventlogin_season_2.ogg"},{"description":"ch0177_eventlogin_season_end","category":"event","text":"能顺利结束真是太好了。老，老师？ 我做的菜…… 合不合您的胃口？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventlogin_season_end.ogg"},{"description":"ch0177_eventshop_1","category":"event","text":"没关系，别担心。我对自己库存管理的能力 还是有信心的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventshop_1.ogg"},{"description":"ch0177_eventshop_2","category":"event","text":"诶？您问有没有供餐部特制料理？这个嘛…… 您想吃的话，我可以给您做呀？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventshop_2.ogg"},{"description":"ch0177_eventshop_buy_1","category":"event","text":"啊，这个呀， 请稍等一下。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventshop_buy_1.ogg"},{"description":"ch0177_eventshop_buy_2","category":"event","text":"这个， 是我最最推荐的商品！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventshop_buy_2.ogg"},{"description":"ch0177_eventshop_buy_3","category":"event","text":"啊……嗯， 您是说这个吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventshop_buy_3.ogg"},{"description":"ch0177_eventshop_buy_4","category":"event","text":"您喜欢吗？ 欢迎下次再来哦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventshop_buy_4.ogg"},{"description":"ch0177_eventshop_end","category":"event","text":"啊…… 庆典和厨艺大赛都结束啦。我还要为明天做准备…… 老师慢慢逛逛再走吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventshop_end.ogg"},{"description":"ch0177_eventshop_login_1","category":"event","text":"老师，您来了。 商家们准备了各种各样的商品。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventshop_login_1.ogg"},{"description":"ch0177_eventshop_login_2","category":"event","text":"我还是， 第一次看店，嘿嘿嘿。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_eventshop_login_2.ogg"},{"description":"ch0177_exskill_1","category":"battle","text":"那我们走吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_exskill_1.ogg"},{"description":"ch0177_exskill_2","category":"battle","text":"这可是我精心制作的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_exskill_2.ogg"},{"description":"ch0177_exskill_3","category":"battle","text":"我出发了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_exskill_3.ogg"},{"description":"ch0177_exskill_level_1","category":"battle","text":"这是供餐部特制的御节料理。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_exskill_level_1.ogg"},{"description":"ch0177_exskill_level_2","category":"battle","text":"这里面倾注了我全部的真心。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_exskill_level_2.ogg"},{"description":"ch0177_exskill_level_3","category":"battle","text":"放开吃吧，还有很多呢！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_exskill_level_3.ogg"},{"description":"ch0177_exweapon_get","category":"growup","text":"很神奇吧？ 只要有老师在，我就感觉自己无所不能。 今年我也会努力的，请拭目以待吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_exweapon_get.ogg"},{"description":"ch0177_formation_in_1","category":"formation","text":"我准备好了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_formation_in_1.ogg"},{"description":"ch0177_formation_in_2","category":"formation","text":"我来准备新年的食品吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_formation_in_2.ogg"},{"description":"ch0177_gachaget","category":"growup","text":"您吃跨年荞麦面了吗，老师？ 希望老师和我今年都能平安度过。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_gachaget.ogg"},{"description":"ch0177_growup_1","category":"growup","text":"我一直很感谢您，老师。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_growup_1.ogg"},{"description":"ch0177_growup_2","category":"growup","text":"这个是给我的？我真的可以收下吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_growup_2.ogg"},{"description":"ch0177_growup_3","category":"growup","text":"怎么办，我没什么可报答您的……诶，什么？您得到的已经够多了？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_growup_3.ogg"},{"description":"ch0177_growup_4","category":"growup","text":"我居然能成长这么多……这全都是老师的功劳，谢谢您。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_growup_4.ogg"},{"description":"ch0177_lobby_1","category":"lobby","text":"这，这件和服……怎么样？我希望，您能喜欢……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_lobby_1.ogg"},{"description":"ch0177_lobby_2","category":"lobby","text":"虽然穿和服给 老师看感觉很紧张，但是鼓起勇气是值得的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_lobby_2.ogg"},{"description":"ch0177_lobby_3","category":"lobby","text":"老师，您知道吗？ 您努力的样子， 会让学员们也获得力量。当然…… 也包括我，诶嘿嘿。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_lobby_3.ogg"},{"description":"ch0177_lobby_4","category":"lobby","text":"御节料理确实很费功夫。但同样也很有成就感。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_lobby_4.ogg"},{"description":"ch0177_lobby_5","category":"lobby","text":"这样和老师待在一起， 不知道为什么，我感觉心里很放松。如果您不着急走……诶？可以再和我多待一会儿是吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_lobby_5.ogg"},{"description":"ch0177_login_1","category":"lobby","text":"啊，老师！您来了。您饿不饿？ 要不要做点吃的？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_login_1.ogg"},{"description":"ch0177_login_2","category":"lobby","text":"您来了！ 我这就给您热饭。今天的菜我也是精心准备的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_login_2.ogg"},{"description":"ch0177_memoriallobby_1","category":"lobby","text":"我真的……非常开心。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_memoriallobby_1.ogg"},{"description":"ch0177_memoriallobby_2","category":"lobby","text":"老师，我一直都非常感激您。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_memoriallobby_2.ogg"},{"description":"ch0177_memoriallobby_3_1","category":"lobby","text":"……我总是单方面地从老师 那里索取，得到了太多太多。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_memoriallobby_3_1.ogg"},{"description":"ch0177_memoriallobby_3_2","category":"lobby","text":"我做的菜…… 老师也一直……吃得比谁都香。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_memoriallobby_3_2.ogg"},{"description":"ch0177_memoriallobby_4","category":"lobby","text":"那个……对我而言 就是最棒的礼物了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_memoriallobby_4.ogg"},{"description":"ch0177_memoriallobby_5_1","category":"lobby","text":"所以，怎么说好呢……老师。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_memoriallobby_5_1.ogg"},{"description":"ch0177_memoriallobby_5_2","category":"lobby","text":"今后，也请多多关照啦？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_memoriallobby_5_2.ogg"},{"description":"ch0177_relationship_up_1","category":"growup","text":"有任何需要，都请随时告诉我。随时，都可以……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_relationship_up_1.ogg"},{"description":"ch0177_relationship_up_2","category":"growup","text":"和老师一起度过的日子，对我来说，是任何东西都无法替代的宝贵时光。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_relationship_up_2.ogg"},{"description":"ch0177_relationship_up_3","category":"growup","text":"老，老师？嘿嘿，就是想叫您一下。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_relationship_up_3.ogg"},{"description":"ch0177_relationship_up_4","category":"growup","text":"我……有话想对老师说，不过不是今天。……总有一天，我会告诉您。您愿意等我吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_relationship_up_4.ogg"},{"description":"ch0177_season_birthday","category":"lobby","text":"哇啊…… 您记得我的生日啊。谢谢……！光是听到老师祝福的话， 我就很满足了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_season_birthday.ogg"},{"description":"ch0177_season_birthday_player","category":"lobby","text":"原来今天是老师的生日啊！生日快乐。我也很高兴能给老师送上祝福！您喜欢什么料理呢……？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_season_birthday_player.ogg"},{"description":"ch0177_season_chinesenewyear","category":"lobby","text":"老师，我听说山海经新春时吃的饺子， 里面要放枚硬币，是这样吗？ 唔……要不要给老师包的饺子里也塞一枚呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_season_chinesenewyear.ogg"},{"description":"ch0177_season_halloween","category":"lobby","text":"万圣节前后总是充满活力， 感觉很有乐趣呢。装饰用的南瓜灯 之后也能吃掉就好了……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_season_halloween.ogg"},{"description":"ch0177_season_midautumn","category":"lobby","text":"南瓜、芋头、菱角…… 老师，原来中秋不止吃月饼呢！ 就用这些食材来为老师做一顿饭吧~！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_season_midautumn.ogg"},{"description":"ch0177_season_newyear","category":"lobby","text":"新年快乐，老师。我穿了和服哦， 毕竟是新年嘛。我也准备了新年料理， 您要一起吃吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_season_newyear.ogg"},{"description":"ch0177_season_xmas","category":"lobby","text":"圣诞节…… 今年也已经接近尾声了呢。啊，我正在考虑准备一个小型派对…… 您觉得怎么样？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_season_xmas.ogg"},{"description":"ch0177_title","category":"lobby","text":"Blue Archive","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/cn/ch0177_title.ogg"}],"voice_kr":[{"description":"ch0177_eventlobby_3","category":"event","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/%E6%AD%A3%E6%9C%88/ch0177_eventlobby_3.ogg"},{"description":"ch0177_eventlobby_4","category":"event","text":"","text_original":"","file":"//static.kivo.wiki/