{"code":2000,"codename":"Koyuki","data":{"id":554,"skin":"","skin_jp":"","skin_cn":"","skin_zh_tw":"","skin_list":[{"id":554,"avatar":"//static.kivo.wiki/images/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/Student_Portrait_CH0317_Collection.png","skin":"","skin_cn":""}],"family_name":"樱井","given_name":"美代","family_name_jp":"桜井","given_name_jp":"ミヨ","family_name_kr":"사쿠라이","given_name_kr":"미요","family_name_en":"Sakurai","given_name_en":"Miyo","family_name_zh_tw":"","given_name_zh_tw":"","family_name_cn":"","given_name_cn":"","nick_name":"","momo_talk_signature":"一起遵守校规吧……。","main_relation":143,"relation":[140],"age":16,"grade":"二年生","height":155,"birthday":"08-24","hobby":"收集打字机","designer":"Paruru","illustrator":"Paruru","character_voice":"花岩香奈","character_voice_cn":"","release_date":"2025-09-24","release_date_cn":null,"release_date_global":null,"school":14,"weapon_type":"SR","is_install":true,"is_install_cn":false,"is_install_global":false,"is_npc":false,"show_list":true,"body_shape":"Medium","special_appearance":false,"spine":[1086,1173],"model":[469,472],"voice":[{"description":"ch0317_battle_buffed_1","category":"battle","text":"是、是我吗……！？","text_original":"わ、私にですか……！？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_buffed_1.ogg"},{"description":"ch0317_battle_buffself_1","category":"battle","text":"","text_original":"はぁー","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_buffself_1.ogg"},{"description":"ch0317_battle_covered_1","category":"battle","text":"我已经……动都不想动了……。","text_original":"も、もう動きたくありません……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_covered_1.ogg"},{"description":"ch0317_battle_damage_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_damage_1.ogg"},{"description":"ch0317_battle_damage_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_damage_2.ogg"},{"description":"ch0317_battle_damage_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_damage_3.ogg"},{"description":"ch0317_battle_defense_1","category":"battle","text":"没、没有用的哦……！","text_original":"き、効きませんよ……！","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_defense_1.ogg"},{"description":"ch0317_battle_in_1","category":"battle","text":"不、不能够和平地解决吗……？","text_original":"へ、平和的解決はできないんですか……？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_in_1.ogg"},{"description":"ch0317_battle_in_2","category":"battle","text":"看来是，没有办法呢……。","text_original":"仕方がない、んですね……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_in_2.ogg"},{"description":"ch0317_battle_move_1","category":"battle","text":"请、请等一下！","text_original":"ま、待ってください！","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_move_1.ogg"},{"description":"ch0317_battle_move_2","category":"battle","text":"还没结束吗……？","text_original":"まだあるんですか……？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_move_2.ogg"},{"description":"ch0317_battle_recovery_1","category":"battle","text":"感、感激不尽……！","text_original":"あ、ありがとうございます……！","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_recovery_1.ogg"},{"description":"ch0317_battle_retire","category":"battle","text":"","text_original":"私に構わず、作戦通りにー","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_retire.ogg"},{"description":"ch0317_battle_shout_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_shout_1.ogg"},{"description":"ch0317_battle_shout_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_shout_2.ogg"},{"description":"ch0317_battle_shout_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_shout_3.ogg"},{"description":"ch0317_battle_tacticalaction_1","category":"battle","text":"嘿、咻……！","text_original":"よっ、と……！","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_tacticalaction_1.ogg"},{"description":"ch0317_battle_victory_1","category":"battle","text":"呼……总算收拾完了呢。","text_original":"ふぅ……片づきましたね。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_victory_1.ogg"},{"description":"ch0317_battle_victory_2","category":"battle","text":"诸位，辛苦了。","text_original":"皆さん、お疲れ様でした。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_battle_victory_2.ogg"},{"description":"ch0317_cafe_monolog_1","category":"cafe","text":"（要是能找到个可以悠闲地写原稿的地方……那就好了）","text_original":"（ゆっくり原稿ができそうな場所……ないかな）","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cafe_monolog_1.ogg"},{"description":"ch0317_cafe_monolog_2","category":"cafe","text":"在这里用打字机的话，会不会给大家添麻烦呢……。","text_original":"タイプライターを使ったら迷惑になってしまうでしょうか……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cafe_monolog_2.ogg"},{"description":"ch0317_cafe_monolog_3","category":"cafe","text":"大家都这么悠然自在……和狂猎真是天差地别。","text_original":"皆さん、のびのびと……ワイルドハントとは大違いです。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cafe_monolog_3.ogg"},{"description":"ch0317_cafe_monolog_4","category":"cafe","text":"（老师……会喜欢什么咖啡呢？）","text_original":"（先生……どんなコーヒーがお好きなのでしょう？）","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cafe_monolog_4.ogg"},{"description":"ch0317_cafe_monolog_5","category":"cafe","text":"嗯…从那边进入，然后逃脱路线就……不对、明明在这里根本没必要考虑这些的……。","text_original":"ええと、あそこから進入して、脱出は……って、ここではそんなの探さなくてもいいのに……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cafe_monolog_5.ogg"},{"description":"ch0317_cardpickup_1","category":"event","text":"好厉害！我也是第一次亲眼见到这张卡呢！","text_original":"すごいです！私もこの目で見るのは初めてのカードですよ！","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cardpickup_1.ogg"},{"description":"ch0317_cardpickup_2","category":"event","text":"老师的运气真好！照这个势头，下一张也……！","text_original":"運がいいですね、先生！この流れに乗って、次も……！","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cardpickup_2.ogg"},{"description":"ch0317_cardpickup_3","category":"event","text":"平凡之中，亦有其美学所在。","text_original":"普通には、普通の美学というものがあります。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cardpickup_3.ogg"},{"description":"ch0317_cardpickup_4","category":"event","text":"请不要灰心，老师。物极必反，否极泰来呀。","text_original":"気を落とさないでください、先生。不運は、次の幸運の前兆ですよ。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cardpickup_4.ogg"},{"description":"ch0317_cardshop_1","category":"event","text":"您有什么疑问吗？","text_original":"何か問題でもありましたか？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cardshop_1.ogg"},{"description":"ch0317_cardshop_2","category":"event","text":"有合您心意的卡片吗？","text_original":"お目当てのカードはありますか？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cardshop_2.ogg"},{"description":"ch0317_cardshop_end","category":"event","text":"为了不留下遗憾，还请您亲眼见证……直到故事落幕。","text_original":"物語の結末まで……悔いのないよう、見届けていってください。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cardshop_end.ogg"},{"description":"ch0317_cardshop_login_1","category":"event","text":"欢迎您，老师。请走这边哦。","text_original":"ようこそ、先生。こちらですよ。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cardshop_login_1.ogg"},{"description":"ch0317_cardshop_login_2","category":"event","text":"请您伸手。……要一起抽张卡吗？","text_original":"お手をどうぞ。……一緒にカードを引きませんか？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_cardshop_login_2.ogg"},{"description":"ch0317_commonskill","category":"battle","text":"哇啊……！呵呵呵……。","text_original":"わぁ……！ふふふっ……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_commonskill.ogg"},{"description":"ch0317_eventlobby_1","category":"event","text":"啊……打字的声音打扰到您了吗？","text_original":"あっ……タイピング音、うるさかったですか？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_eventlobby_1.ogg"},{"description":"ch0317_eventlobby_2","category":"event","text":"为什么我会被卷进这种事情里来呢……。","text_original":"どうしてこんなことに巻き込まれてしまったんでしょう……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_eventlobby_2.ogg"},{"description":"ch0317_eventlobby_3","category":"event","text":"这、这么一直盯着我看……呵呵。我很开心。","text_original":"そ、そんなにじっと見つめて……ふふっ。嬉しいです。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_eventlobby_3.ogg"},{"description":"ch0317_eventlobby_4","category":"event","text":"工作结束以后，请您务必来我们宿舍玩哦。","text_original":"お仕事のあとは、ぜひ私たちの寮へ遊びに来てくださいね。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_eventlobby_4.ogg"},{"description":"ch0317_eventlogin_1","category":"event","text":"欢迎光临，老师。我才刚好写完新作的情节大纲呢。","text_original":"いらっしゃいませ、先生。ちょうどプロットを書き終えたところです。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_eventlogin_1.ogg"},{"description":"ch0317_eventlogin_2","category":"event","text":"和老师您见面，我就感到十分安心。","text_original":"先生にお会いできて、すごく安心しました。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_eventlogin_2.ogg"},{"description":"ch0317_eventlogin_season_1","category":"event","text":"当初入学狂猎时，我怎么都想不到日后竟沦落到这般田地。","text_original":"ワイルドハントに入学した時は、まさかこんな事をする羽目になるなんて想像もしていませんでした。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_eventlogin_season_1.ogg"},{"description":"ch0317_eventlogin_season_2","category":"event","text":"形势愈发复杂了……。……但还不是放弃的时候。故事必须有始有终。","text_original":"事態が複雑になってきましたね……。……諦めるわけには。物語は完結させてこそ、です。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_eventlogin_season_2.ogg"},{"description":"ch0317_eventlogin_season_end","category":"event","text":"能顺利结束真是太好了。……哈啊。这样的委托，我已经受够了。","text_original":"無事に終わって良かったです。……はぁ。こんな依頼、もうたくさんです。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_eventlogin_season_end.ogg"},{"description":"ch0317_exskill_1","category":"battle","text":"呜呜……我根本不想写这种东西的……。","text_original":"うう……こんなお話を書きたかったわけじゃないのに……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_exskill_1.ogg"},{"description":"ch0317_exskill_2","category":"battle","text":"这……就有点……。","text_original":"これは……ちょっと。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_exskill_2.ogg"},{"description":"ch0317_exskill_3","category":"battle","text":"我再也不写了……。","text_original":"もう二度と書きません……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_exskill_3.ogg"},{"description":"ch0317_exskill_level_1","category":"battle","text":"看来能平安交付了……。","text_original":"落とさずにすみそうです……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_exskill_level_1.ogg"},{"description":"ch0317_exskill_level_2","category":"battle","text":"这、这是初稿……！","text_original":"こ、こちら初稿です……！","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_exskill_level_2.ogg"},{"description":"ch0317_exskill_level_3","category":"battle","text":"截止日期……总算是赶上了。","text_original":"締切は……守りましたよ。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_exskill_level_3.ogg"},{"description":"ch0317_exweapon_get","category":"growup","text":"若是可以，真想把现在这一刻装订成书。将我们的回忆……化作随时可以重温的篇章。","text_original":"もし叶うなら、この瞬間を本にしたいです。私たちの思い出を……いつでも読み返せるように。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_exweapon_get.ogg"},{"description":"ch0317_formation_in_1","category":"formation","text":"不、不做不行了吧……？","text_original":"や、やらなきゃいけませんよね……？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_formation_in_1.ogg"},{"description":"ch0317_formation_in_2","category":"formation","text":"打、打架是不行的……。","text_original":"け、ケンカは良くないです……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_formation_in_2.ogg"},{"description":"ch0317_formation_select","category":"formation","text":"就我们两个人、吗？……可以哦。","text_original":"私と二人で、ですか？……いいですよ。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_formation_select.ogg"},{"description":"ch0317_gachaget","category":"growup","text":"我、我是狂猎艺术学院的樱井美代。虽、虽然不知道您找我有什么事……还请您多多关照。","text_original":"わ、ワイルドハント芸術学院、桜井ミヨと申します。ど、どうして私が呼ばれたのか分かりませんが……よろしくお願いします。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_gachaget.ogg"},{"description":"ch0317_growup_1","category":"growup","text":"这、这些是从哪里得来的……？","text_original":"ど、どちらで調達してきたんですか……？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_growup_1.ogg"},{"description":"ch0317_growup_2","category":"growup","text":"这些东西都是合法的……没错吧？","text_original":"これは合法のもの……ですよね？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_growup_2.ogg"},{"description":"ch0317_growup_3","category":"growup","text":"想为故事画上句点，力量是必须的……谢谢您，老师。","text_original":"物語を畳むのには、力が必要です……ありがとうございます、先生。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_growup_3.ogg"},{"description":"ch0317_growup_4","category":"growup","text":"托老师的福……我似乎能更多地爱自己了。","text_original":"先生のおかげで……もっと、自分を好きになれそうです。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_growup_4.ogg"},{"description":"ch0317_lobby_1","category":"lobby","text":"那个，请问您遇到什么困难了吗？只要在合法范围内，我都可以帮您……。","text_original":"あの、何か困っていることはありませんか？合法であれば、なんでも……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_lobby_1.ogg"},{"description":"ch0317_lobby_2","category":"lobby","text":"我可以专心地写作吗？毕竟这才是作家的本职工作……？","text_original":"気にせず執筆に集中していいんですか？それが作家の仕事だから……？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_lobby_2.ogg"},{"description":"ch0317_lobby_3","category":"lobby","text":"我想一边看着老师一边写作……没有理由的话……就不行吗？","text_original":"先生を見ながら、お話を書きたいです……理由がなきゃ……だめですか？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_lobby_3.ogg"},{"description":"ch0317_lobby_4","category":"lobby","text":"在写小说的时候，总觉得日常生活中的一切都像是伏笔。就连我来到这里的这件事也……。","text_original":"小説を書いていると、日常の何もかもが伏線に見えてしまうんです。私がここへ来たのも……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_lobby_4.ogg"},{"description":"ch0317_lobby_5","category":"lobby","text":"因为今天老师没有到狂猎去……所以我就跑过来了。","text_original":"今日は、先生がワイルドハントにいらっしゃらないので……来ちゃいました。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_lobby_5.ogg"},{"description":"ch0317_login_1","category":"lobby","text":"啊，老师……不好意思，我看书太入迷了……。","text_original":"あ、先生……すみません、本に夢中で……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_login_1.ogg"},{"description":"ch0317_login_2","category":"lobby","text":"诶，您问我在写什么吗？……敬、敬请期待完结后，再给您看吧！","text_original":"えっ、書いているものですか？……か、完結してからのお楽しみです！","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_login_2.ogg"},{"description":"ch0317_memoriallobby_1_1","category":"lobby","text":"……您在这种地方做什么呢？","text_original":"……こんなところで、何をされているんですか？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_1_1.ogg"},{"description":"ch0317_memoriallobby_1_2","category":"lobby","text":"明明我一直在找老师……。","text_original":"ずっと先生を探していたのに……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_1_2.ogg"},{"description":"ch0317_memoriallobby_2_1","category":"lobby","text":"不过您从刚才起就有点难受的样子……","text_original":"さっきから少し苦しそうですが……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_2_1.ogg"},{"description":"ch0317_memoriallobby_2_2","category":"lobby","text":"难道是身体不太舒服吗……？","text_original":"もしかして、あまり体調が良くないのですか……？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_2_2.ogg"},{"description":"ch0317_memoriallobby_3_1","category":"lobby","text":"原来如此，是做噩梦了啊……。","text_original":"なるほど、悪夢……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_3_1.ogg"},{"description":"ch0317_memoriallobby_3_2","category":"lobby","text":"您肯定是遭报应了哦。","text_original":"きっと、罰が当たったんですよ。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_3_2.ogg"},{"description":"ch0317_memoriallobby_4_1","category":"lobby","text":"明明最近常常来狂猎这边……。","text_original":"最近、よくワイルドハントにいらしてるのに……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_4_1.ogg"},{"description":"ch0317_memoriallobby_4_2","category":"lobby","text":"却一次都没有联系过我。","text_original":"一度も、私に連絡しなかったから。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_4_2.ogg"},{"description":"ch0317_memoriallobby_5_1","category":"lobby","text":"……呵呵，开玩笑的啦。","text_original":"……ふふ、冗談ですよ。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_5_1.ogg"},{"description":"ch0317_memoriallobby_5_2","category":"lobby","text":"不过，能像这样见到老师……我真的很开心。","text_original":"でも、こうやって先生にお会いできて……私、嬉しいです。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_memoriallobby_5_2.ogg"},{"description":"ch0317_relationship_up_1","category":"growup","text":"怎、怎么会……这怎么好意思……非常感谢您。","text_original":"そ、そんな……申し訳ないです……ありがとうございます。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_relationship_up_1.ogg"},{"description":"ch0317_relationship_up_2","category":"growup","text":"那个……可以把老师的名字……写进我的小说里吗？","text_original":"その……先生のお名前を……私の小説に出してもいいですか？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_relationship_up_2.ogg"},{"description":"ch0317_relationship_up_3","category":"growup","text":"老师……我等您好久了。那个……我一直很想见您。","text_original":"先生……お待ちしていました。その……お会いしたかったです。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_relationship_up_3.ogg"},{"description":"ch0317_relationship_up_4","category":"growup","text":"和老师在一起，就仿佛置身幸福的童话故事中。我希望……这个故事能永远持续下去……。","text_original":"先生といると、幸せな物語の中にいるような気分になるんです。どうか、このお話が……ずっと続きますように……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_relationship_up_4.ogg"},{"description":"ch0317_season_birthday","category":"lobby","text":"您问我有什么想要的吗？唔嗯……那么能否占用您两小时左右，陪我聊聊天呢？","text_original":"ほしいもの、ですか？うーん……２時間ほど、お話させていただいてもいいでしょうか？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_season_birthday.ogg"},{"description":"ch0317_season_birthday_player","category":"lobby","text":"您能像这样出现在我的故事里……真的非常感谢您，老师。","text_original":"こうして私の物語に登場してくれて……ありがとうございます、先生。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_season_birthday_player.ogg"},{"description":"ch0317_season_halloween","category":"lobby","text":"这是万圣节糖果，请您张嘴，“啊——”。要是拒绝的话，我可要恶作剧了？","text_original":"キャンディーです。あ～んしてください。断ると……イタズラ、しちゃいますよ？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_season_halloween.ogg"},{"description":"ch0317_season_newyear","category":"lobby","text":"今天是今年的第一页呢。如果您愿意的话，要和我一起读下去吗？","text_original":"今日が、今年の一ページ目ですね。よければ、私と一緒に読み進めませんか？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_season_newyear.ogg"},{"description":"ch0317_season_xmas","category":"lobby","text":"圣诞节就快乐。老师想要的东西……我来为您您筹措吧。","text_original":"メリークリスマスです。先生のほしいもの……調達してきますよ。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_season_xmas.ogg"},{"description":"ch0317_tactic_defeat_1","category":"battle","text":"","text_original":"まだチャンスはあります。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_tactic_defeat_1.ogg"},{"description":"ch0317_tactic_defeat_2","category":"battle","text":"","text_original":"作戦を見直しましょう。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_tactic_defeat_2.ogg"},{"description":"ch0317_tactic_in_1","category":"battle","text":"想、想回到原稿……","text_original":"げ、原稿に戻りたいです……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_tactic_in_1.ogg"},{"description":"ch0317_tactic_in_2","category":"battle","text":"为、为什么要做这种没有意义的事情……","text_original":"ど、どうしてこんな無意味なことを……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_tactic_in_2.ogg"},{"description":"ch0317_tactic_victory_1","category":"battle","text":"……赢、赢了。","text_original":"……勝って、しまいました。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_tactic_victory_1.ogg"},{"description":"ch0317_tactic_victory_2","category":"battle","text":"那个，算是……按计划进行吧……。","text_original":"ええと、作戦通り……ですね……。","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/ch0317_tactic_victory_2.ogg"},{"description":"CH0317_Title","category":"lobby","text":"Blue、Archi……ve？","text_original":"ブルー、アーカイ……ブ？","file":"//static.kivo.wiki/voices/students/%E6%A8%B1%E4%BA%95%20%E7%BE%8E%E4%BB%A3/original/jp/CH0317_Title.ogg"}],"voice_cn":[],"voice_kr":[],"gift_data":[{"id":271,"favorability":40},{"id":272,"favorability":40},{"id":54,"favorability":40},{"id":61,"favorability":60},{"id":86,"favorability":40},{"id":55,"favorability":40},{"id":79,"favorability":240},{"id":70,"favorability":40},{"id":76,"favorability":40},{"id":96,"favorability":40},{"id":43,"favorability":40},{"id":87,"favorability":180}],"furniture":[1801],"character_da