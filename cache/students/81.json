oices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/sbnWp85kriQmS5cgbDlr7IvSdM3YQiMZ.ogg"},{"description":"yuzu_cafe_monolog_2","category":"cafe","text":"我想更加正式地……研究游戏。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/nQH0O2KlsbXmzcw5E8cxafpkczXFzRFX.ogg"},{"description":"yuzu_cafe_monolog_3","category":"cafe","text":"这里感觉好舒服啊。我好想在这里睡觉觉。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/MhP1O8XtBC2nLv2aEJ7zk7OTTDfNYfuX.ogg"},{"description":"yuzu_commonskill","category":"battle","text":"我，我会加油。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/KS1zwtdiArh87zSvk5bzs8w7fzBc3Ixy.ogg"},{"description":"yuzu_exskill_1","category":"battle","text":"我要上了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/nYoBYPlnsjLHGrnZ8vYLiQRsmJVclrkY.ogg"},{"description":"yuzu_exskill_2","category":"battle","text":"目标，已瞄准。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/IvNrB0vMBha2pmzlm7fPiHmpg164aPqp.ogg"},{"description":"yuzu_exskill_3","category":"battle","text":"我觉得，这个还挺好玩。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/SOzYBtUrvAyefK0VwFAWVhhx13Yh2jVF.ogg"},{"description":"yuzu_exskill_level_1","category":"battle","text":"复古游戏啊，成为永恒吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/tzk2eTOED6I2GcveG0QjxffOtRFM7tal.ogg"},{"description":"yuzu_exskill_level_2","category":"battle","text":"请做好觉悟吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/BZkBvfTUBmMaPM0de17vUANANHsmFJac.ogg"},{"description":"yuzu_exskill_level_3","category":"battle","text":"这，就是创作的痛苦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/YH8ELAbCbjs44wsNKQDft6LdaAloQtYz.ogg"},{"description":"yuzu_exweapon_get","category":"growup","text":"身体里……有种力量涌动的感觉。这就是……勇气吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/ioucG8IxwansVqAJV9pOSk6Er5T0nIAt.ogg"},{"description":"yuzu_formation_in_1","category":"formation","text":"如，如果老师需要的话，我也……","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/x6iQL6s7cxZDDp02D1wd437H8Lp854BY.ogg"},{"description":"yuzu_formation_in_2","category":"formation","text":"我会努力和大家成为好朋友的……应该吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/SaLjR2I9SXdlaTFWtP3fwUCV73znZjXL.ogg"},{"description":"yuzu_formation_select","category":"formation","text":"选，选我吗……我，我试试看……","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/fCdLddfYToLjoM5CfnVFZpIDifI9TYpu.ogg"},{"description":"yuzu_gachaget","category":"growup","text":"我是……游戏开发部部长……柚，柚子。真的……要带上我吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/DHxOfaKVTdGLF3j4ivZY2GOCDS57TCjz.ogg"},{"description":"yuzu_growup_1","category":"growup","text":"多亏了老师，可以稍微放心一点了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/izbNXBkn7XWJXbrS6vzJzj7tw4pE8JpY.ogg"},{"description":"yuzu_growup_2","category":"growup","text":"我……想变得更有自信！","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/EQr2QqAskML78bBcG13RcbgjbLO93ZI7.ogg"},{"description":"yuzu_growup_3","category":"growup","text":"什么时候会害怕？嗯唔……老师不在身边，的时候吧？","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/MO4WP098zr23Bn87UYp6KhKmC3jQ5UgF.ogg"},{"description":"yuzu_growup_4","category":"growup","text":"我，我真的，一点也不强……但我会努力的！因为我真的很喜欢大家。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/KKDUppX2Mawx4fEG2k997jQXezDKyGLZ.ogg"},{"description":"yuzu_lobby_1","category":"lobby","text":"只要是老师的请求……我都会欣然接受。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/fZG0Oc1FIaVq1ALcPnSUjiTgisXVzp6u.ogg"},{"description":"yuzu_lobby_2","category":"lobby","text":"嗯，不管是什么事，您尽管说就好了。 我都会……尽力而为！","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/AgpIh2aB9V6HT8R1JVzzx0yJipYwxWDA.ogg"},{"description":"yuzu_lobby_3","category":"lobby","text":"啊，我也想养猫。 只要有游戏和猫咪，我就能在这个世界上活下去。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/l7lUtrLk54Y1pSa1usDHWO4RkcUBIcCF.ogg"},{"description":"yuzu_lobby_4","category":"lobby","text":"嗯，老师。我……也会变强的。 就像老师和大家保护我一样……我也想为大家尽一份力。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/YtLHXcb6jzgpA2wsJuqI0LD057NwXMFi.ogg"},{"description":"yuzu_lobby_5","category":"lobby","text":"（我想变得……配得上这个人。）","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/CKhCSsrVxPmDG2KS05SJwyyfla6REGgS.ogg"},{"description":"yuzu_login_1","category":"lobby","text":"老，老师，您来了。我正等着您呢。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/aLLLsusInIx8pjMDQzgL8xc8sVeaQvVe.ogg"},{"description":"yuzu_login_2","category":"lobby","text":"老师……欢迎回来。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/mEqCZZWxvR8J0mze5MWTOLWQKEjr8Lw1.ogg"},{"description":"yuzu_memoriallobby_1","category":"lobby","text":"如果没有老师……我肯定做不到这些。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/MzQLYF4LYQ1DuQzREn8sHGbKatfoGqmc.ogg"},{"description":"yuzu_memoriallobby_2","category":"lobby","text":"多亏了老师……我才能顺利地给大家送礼物……","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/LmUQgVhVW25hssy7nwmUmAkqO4NwNt3m.ogg"},{"description":"yuzu_memoriallobby_3_1","category":"lobby","text":"老师帮助了我……","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/wMHsevq65boMRpviI4YpwedSuLUmVOcM.ogg"},{"description":"yuzu_memoriallobby_3_2","category":"lobby","text":"所以，老师在需要我的时候，还请尽管开口哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/36DpcrYM3JLFY3AHoshn2PRTndfYzLMr.ogg"},{"description":"yuzu_memoriallobby_4","category":"lobby","text":"……我一定，会报答您的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/bEgoVFV8b7tKwplTGS8oSsEXDz9f3zPH.ogg"},{"description":"yuzu_relationship_up_1","category":"growup","text":"没，没给您添麻烦吧？嘿嘿嘿，那就好。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/yvjEbcKNYmGuLXO2nuw96sQrQd6qrRsq.ogg"},{"description":"yuzu_relationship_up_2","category":"growup","text":"我不太明白，真的不太明白现在的心情究竟是什么。但是我很开心。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/lHy8jxdaZPIfuASz6IvTlqw2UXWyUkHF.ogg"},{"description":"yuzu_relationship_up_3","category":"growup","text":"总觉得，老师担任顾问和指挥的时候，真的很帅。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/nYVbqZGwSPvuh6ggfKVA0IIQrtxs0mqB.ogg"},{"description":"yuzu_relationship_up_4","category":"growup","text":"我，我也对老师，呃……嗯……羞死人了！","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/JGe4lZFxYJIIspRqkRHpbuC6KFnokAeU.ogg"},{"description":"yuzu_season_birthday","category":"lobby","text":"今，今天是我的生日。 也是基沃托斯的文化日……所以不可以忘记哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/rVLOO19nilPAN7TYv3WWqrToKDN9KVi7.ogg"},{"description":"yuzu_season_birthday_player","category":"lobby","text":"老师，祝您生日快乐！ 我……我是真心的……！","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/tnb77NkaIjlTtEescUSGbXDqxZrgJ9Zz.ogg"},{"description":"yuzu_season_chinesenewyear","category":"lobby","text":"老师，新春快乐。今年，我想做出更有趣的游戏……还，还想和老师更，更亲近一点……","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/GVIMCPZxZnaCObJZVQ6tIJTpezLjw7zy.ogg"},{"description":"yuzu_season_halloween","category":"lobby","text":"街上到处都是闪闪发光的南瓜和糖果诶。 我，我也想去看看。跟老师一起……","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/ORqGQ8Bat17v8ebupuutXRcQvrFJf0ho.ogg"},{"description":"yuzu_season_midautumn","category":"lobby","text":"中，中秋节快乐。真，真的要和我一起过节吗？不，不是的！我当然很开心。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/7fES9jJqzgQGySLuyOTlebJXR0f4Fcse.ogg"},{"description":"yuzu_season_newyear","category":"lobby","text":"新年快乐！ 我会让您看到，我更加成熟的样子。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/WQz8aDmE4eSYUly8D9vnjUBOOCPJaPQn.ogg"},{"description":"yuzu_season_xmas","category":"lobby","text":"圣，圣诞快乐……老师。 圣诞老人跟游戏……有着相似之处。因为两者……都会让人心跳加速。","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/9twhkUsrUmeF19Q3mdZ43OzcGS4PlutP.ogg"},{"description":"yuzu_tactic_defeat_1","category":"battle","text":"对不起……","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/n58Cl6XFk8dgtSBCRSJ8eyGFMYMtsE3O.ogg"},{"description":"yuzu_tactic_defeat_2","category":"battle","text":"不行了……","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/40ARiZIOSNroGbwXVfZaStydtLeHODcm.ogg"},{"description":"yuzu_tactic_in_1","category":"battle","text":"和，和其他人一起……我，我会加油的！","text_original":"","file":"//static.kivo.wiki/voices/students/%E8%8A%B1%E5%86%88%20%E6%9F%9A%E5%AD%90/2ywVX2c3v