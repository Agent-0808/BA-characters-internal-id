{"code":2000,"codename":"Koyuki","data":{"id":559,"skin":"","skin_jp":"","skin_cn":"","skin_zh_tw":"","skin_list":[{"id":559,"avatar":"//static.kivo.wiki/images/students/%E6%A2%AF%20%E6%98%B4/original/Student_Portrait_CH0309_Collection.png","skin":"","skin_cn":""}],"family_name":"梯","given_name":"昴","family_name_jp":"梯","given_name_jp":"スバル","family_name_kr":"카케하시","given_name_kr":"스바루","family_name_en":"Kakehashi","given_name_en":"Subaru","family_name_zh_tw":"","given_name_zh_tw":"","family_name_cn":"","given_name_cn":"","nick_name":"","momo_talk_signature":"每日一小步","main_relation":144,"relation":[5,42,10],"age":17,"grade":"三年生","height":166,"birthday":"03-09","hobby":"口琴演奏","designer":"nemoga","illustrator":"nemoga","character_voice":"天海由梨奈","character_voice_cn":"","release_date":"2025-11-12","release_date_cn":null,"release_date_global":null,"school":10,"weapon_type":"AR","is_install":true,"is_install_cn":false,"is_install_global":false,"is_npc":false,"show_list":true,"body_shape":"Medium","special_appearance":false,"spine":[1164,1186,1163,1169,1187],"model":[482,487],"voice":[{"description":"ch0309_battle_buffed_1","category":"battle","text":"非常感谢。我会继续精进。","text_original":"ありがとうございます。精進いたします。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_buffed_1.ogg"},{"description":"ch0309_battle_buffself_1","category":"battle","text":"那就这样上吧。","text_original":"これで行きましょう。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_buffself_1.ogg"},{"description":"ch0309_battle_covered_1","category":"battle","text":"进入掩体。请求支援。","text_original":"遮蔽します。支援をお願いします。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_covered_1.ogg"},{"description":"ch0309_battle_damage_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_damage_1.ogg"},{"description":"ch0309_battle_damage_2","category":"battle","text":"痛——","text_original":"いたっー","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_damage_2.ogg"},{"description":"ch0309_battle_damage_3","category":"battle","text":"好痛……","text_original":"痛いです……","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_damage_3.ogg"},{"description":"ch0309_battle_defense_1","category":"battle","text":"还没完呢！","text_original":"まだまだです！","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_defense_1.ogg"},{"description":"ch0309_battle_in_1","category":"battle","text":"开始突入。请跟紧我。","text_original":"突入します。私に続いてください。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_in_1.ogg"},{"description":"ch0309_battle_in_2","category":"battle","text":"没事的。相信我。","text_original":"大丈夫です。私を信じて。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_in_2.ogg"},{"description":"ch0309_battle_move_1","category":"battle","text":"区域安全。","text_original":"クリア。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_move_1.ogg"},{"description":"ch0309_battle_move_2","category":"battle","text":"前进。","text_original":"前進します。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_move_2.ogg"},{"description":"ch0309_battle_recovery_1","category":"battle","text":"谢谢，帮大忙了。","text_original":"ありがとうございます、助かりました。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_recovery_1.ogg"},{"description":"ch0309_battle_retire","category":"battle","text":"还、还不能倒下……！","text_original":"まだ、倒れるわけには……！","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_retire.ogg"},{"description":"ch0309_battle_shout_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_shout_1.ogg"},{"description":"ch0309_battle_shout_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_shout_2.ogg"},{"description":"ch0309_battle_shout_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_shout_3.ogg"},{"description":"ch0309_battle_tacticalaction_1","category":"battle","text":"开始移动。","text_original":"移動します。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_tacticalaction_1.ogg"},{"description":"ch0309_battle_victory_1","category":"battle","text":"您满意了吗？那就再好不过了。","text_original":"ご満足いただけたでしょうか？それなら何よりです。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_victory_1.ogg"},{"description":"ch0309_battle_victory_2","category":"battle","text":"压制完成。希望能就此解决吧。","text_original":"制圧完了です。これで解決してほしいのですが。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_battle_victory_2.ogg"},{"description":"ch0309_cafe_monolog_1","category":"cafe","text":"咖啡厅……总有种高档场所的感觉。","text_original":"カフェ……なんだか高そうな場所。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_cafe_monolog_1.ogg"},{"description":"ch0309_cafe_monolog_2","category":"cafe","text":"（总感觉……让人想起了补水休息的时间）","text_original":"（なんだか……ウォータータイムを思い出す）","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_cafe_monolog_2.ogg"},{"description":"ch0309_cafe_monolog_3","category":"cafe","text":"那是……什么东西？","text_original":"あれは……なんだろう。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_cafe_monolog_3.ogg"},{"description":"ch0309_cafe_monolog_4","category":"cafe","text":"（以前没什么机会来这种地方呢……）","text_original":"（あまりこういうところには来られなかったなぁ……）","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_cafe_monolog_4.ogg"},{"description":"ch0309_cafe_monolog_5","category":"cafe","text":"咖啡厅的兼职……有在招人吗？","text_original":"カフェのアルバイト……募集してたりするかな？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_cafe_monolog_5.ogg"},{"description":"ch0309_commonskill","category":"battle","text":"满分是多少，我又能得几分呢？老师。","text_original":"何点満点中、どのくらいでしょうか？先生。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_commonskill.ogg"},{"description":"ch0309_exskill_1","category":"battle","text":"……大家，都在等着我呢。","text_original":"……みんなが、待っているんです。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_exskill_1.ogg"},{"description":"ch0309_exskill_2","category":"battle","text":"……这是，工作。","text_original":"……仕事、ですから。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_exskill_2.ogg"},{"description":"ch0309_exskill_3","category":"battle","text":"……快点解决吧。","text_original":"……早く終わらせましょうか。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_exskill_3.ogg"},{"description":"ch0309_exskill_level_1","category":"battle","text":"装填，完毕。","text_original":"リロード、完了。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_exskill_level_1.ogg"},{"description":"ch0309_exskill_level_2","category":"battle","text":"继续战斗。","text_original":"戦闘を続けます。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_exskill_level_2.ogg"},{"description":"ch0309_exskill_level_3","category":"battle","text":"压制射击，开始。","text_original":"制圧射撃、開始。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_exskill_level_3.ogg"},{"description":"ch0309_exweapon_get","category":"growup","text":"我到现在还完全没有实感……甚至每次早上醒来，我都会惴惴不安，怀疑这些会不会都是一场梦……真的，非常感谢您，老师。我会好好珍惜的。","text_original":"まだ、全然実感が湧きません……。朝、目が覚めるたびに夢だったんじゃないかと不安になるほどに……。本当に、ありがとうございます、先生。大切にします。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_exweapon_get.ogg"},{"description":"ch0309_formation_in_1","category":"formation","text":"是，老师。","text_original":"はい、先生。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_formation_in_1.ogg"},{"description":"ch0309_formation_in_2","category":"formation","text":"明白，这就准备。","text_original":"分かりました、準備します。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_formation_in_2.ogg"},{"description":"ch0309_formation_select","category":"formation","text":"哇！？我、我才没被吓到……真、真的。","text_original":"わあっ！？お、驚いてなんかいません……ほ、本当です。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_formation_select.ogg"},{"description":"ch0309_gachaget","category":"growup","text":"我是梯昴。有困难时，让我来助您一臂之力吧。不过……是以\"阿里乌斯流\"的方式就是了。","text_original":"梯スバルです。お困りの際には、あなたの力になりましょう。まぁ、……あくまで、「アリウス流」ですが。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_gachaget.ogg"},{"description":"ch0309_growup_1","category":"growup","text":"有种奇妙的感觉……这就是外面所说的“成长”吗。","text_original":"不思議な感覚がします……。これが外でいうところの「成長」なのでしょうか。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_growup_1.ogg"},{"description":"ch0309_growup_2","category":"growup","text":"这就是成长的实感吗。原来我也能这样不断前进啊。","text_original":"これが成長の実感、なのでしょうか。私もこうして前に進むことができるのですね。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_growup_2.ogg"},{"description":"ch0309_growup_3","category":"growup","text":"我，想要改变自己。……请对其他各位保密哦？","text_original":"私、変わりたいと思っているんです。……他のみんなには、内緒にしててくださいね？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_growup_3.ogg"},{"description":"ch0309_growup_4","category":"growup","text":"“相信我，跟我来”……？哈啊……这自信到底是从哪来的？不过嘛……就一次的话，信您一回也无妨。","text_original":"「私を信じてついてきて」……？はぁ……その自信は一体どこから湧いて来るんですか？まぁでも……一回くらいなら、信じても構いませんが。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_growup_4.ogg"},{"description":"ch0309_lobby_1_1","category":"lobby","text":"点心也能随便吃……？","text_original":"お菓子も自由に食べていい……？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_1_1.ogg"},{"description":"ch0309_lobby_1_2","category":"lobby","text":"那、那怎么行！就算是值日生也不能……","text_original":"そ、そういうわけにはいきません！いくら当番といっても……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_1_2.ogg"},{"description":"ch0309_lobby_1_3","category":"lobby","text":"……","text_original":"……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_1_3.ogg"},{"description":"ch0309_lobby_1_4","category":"lobby","text":"那……就吃一点点……","text_original":"では、少しだけ……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_1_4.ogg"},{"description":"ch0309_lobby_2_1","category":"lobby","text":"这话我只在这里说——","text_original":"これはここだけの話ですが――","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_2_1.ogg"},{"description":"ch0309_lobby_2_2","category":"lobby","text":"我其实……不太喜欢阿里乌斯被称为“分校”。","text_original":"アリウス「分校」と呼ばれるの……あまり好きではないんです。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_2_2.ogg"},{"description":"ch0309_lobby_2_3","category":"lobby","text":"被称为分校，总觉得比本校低一等……像是被隔离的地方，不是吗。","text_original":"「分校」と言われると、本校よりも格下というか……隔離された場所、という印象になるじゃないですか。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_2_3.ogg"},{"description":"ch0309_lobby_3_1","category":"lobby","text":"……抱歉，我在想阿里乌斯的大家。","text_original":"……すみません、アリウスにいるみんなのことを考えていました。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_3_1.ogg"},{"description":"ch0309_lobby_3_2","category":"lobby","text":"为了她们，我也必须努力才行。","text_original":"あの子たちのためにも、頑張らないと。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_3_2.ogg"},{"description":"ch0309_lobby_3_3","category":"lobby","text":"……欸？“也要为了自己而努力？”","text_original":"……えっ？「自分のためにも頑張って」？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_3_3.ogg"},{"description":"ch0309_lobby_3_4","category":"lobby","text":"谢……谢谢……","text_original":"あ……ありがとう、ございます……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_3_4.ogg"},{"description":"ch0309_lobby_4_1","category":"lobby","text":"诶？学习……？我、我当然有好好学啦。","text_original":"へっ？勉強……？ちゃ、ちゃんとやってますよ。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_4_1.ogg"},{"description":"ch0309_lobby_4_2","category":"lobby","text":"哈啊……但是，为什么我要学这些根本用不上的东西……","text_original":"はぁ……でも、何でこんな役に立ちそうにもないものを……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_4_2.ogg"},{"description":"ch0309_lobby_4_3","category":"lobby","text":"“即使现在无法理解，也总有一天会派上用场”……吗。","text_original":"「今は理解できなくても、いつか役に立つ時がくる」……ですか。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_4_3.ogg"},{"description":"ch0309_lobby_4_4","category":"lobby","text":"啊真是……好好好，我知道了！","text_original":"ああ、もう……はいはい、分かりましたから！","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_4_4.ogg"},{"description":"ch0309_lobby_5_1","category":"lobby","text":"那个……一见到老师，我心里就会有种奇妙的感觉。","text_original":"その……先生に会うと、不思議な気持ちになります。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_5_1.ogg"},{"description":"ch0309_lobby_5_2","category":"lobby","text":"因为至今为止，从来沒有过……对我这么好的大人。","text_original":"今まで、こんなに良くしてくださった大人は……いなかったので。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_lobby_5_2.ogg"},{"description":"ch0309_login_1","category":"lobby","text":"欢迎回来，老师。今日值班的是我，梯昴。","text_original":"おかえりなさい、先生。　今日の当番を務めます、梯スバルです。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_login_1.ogg"},{"description":"ch0309_login_2_1","category":"lobby","text":"恭候多时了。有什么指示吗？","text_original":"待機しておりました。ご指示はありますか？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_login_2_1.ogg"},{"description":"ch0309_login_2_2","category":"lobby","text":"诶？“先放松一点……？”","text_original":"えっ？「まずは力を抜いて」……？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_login_2_2.ogg"},{"description":"ch0309_memoriallobby_1_1","category":"lobby","text":"总觉得，这一切都很新鲜。","text_original":"なんだか、新鮮な気持ちです。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_1_1.ogg"},{"description":"ch0309_memoriallobby_1_2","category":"lobby","text":"我还是第一次，为某个人单独演奏……","text_original":"こうして誰か一人のために演奏するのは初めてで……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_1_2.ogg"},{"description":"ch0309_memoriallobby_2_1","category":"lobby","text":"感觉……怎么样？","text_original":"どう、でしたでしょうか？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_2_1.ogg"},{"description":"ch0309_memoriallobby_2_2","category":"lobby","text":"不奇怪吧……？","text_original":"変じゃ、なかったですか……？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_2_2.ogg"},{"description":"ch0309_memoriallobby_3_1","category":"lobby","text":"那个……我可以认为，这是您的真心话，对吧？","text_original":"それって……その、本心、と受け取っていいんですよね？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_3_1.ogg"},{"description":"ch0309_memoriallobby_3_2","category":"lobby","text":"……谢谢。","text_original":"……ありがとうございます。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_3_2.ogg"},{"description":"ch0309_memoriallobby_4_1","category":"lobby","text":"其实，要是能为您做点别的什么就好了……","text_original":"本当は、他に何かできることがあればよかったのですが……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_4_1.ogg"},{"description":"ch0309_memoriallobby_4_2","category":"lobby","text":"但现在的我，也就只会这点东西了……","text_original":"今の私には、これくらいしかなくて……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_4_2.ogg"},{"description":"ch0309_memoriallobby_5_1","category":"lobby","text":"诶？“如果以后还会练习，我还想再听……？”","text_original":"えっ？「また練習したら聞かせてほしい」……？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_5_1.ogg"},{"description":"ch0309_memoriallobby_5_2","category":"lobby","text":"\"还买了很多乐谱？\"","text_original":"「楽譜もたくさん買ったから」……？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_5_2.ogg"},{"description":"ch0309_memoriallobby_6_1","category":"lobby","text":"那、那个……","text_original":"そ、それは……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_6_1.ogg"},{"description":"ch0309_memoriallobby_6_2","category":"lobby","text":"等……到时候再说吧，请让我考虑一下。","text_original":"また……その時になったら、考えさせてください。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_memoriallobby_6_2.ogg"},{"description":"ch0309_relationship_up_1","category":"growup","text":"事到如今再说出口有点难为情呢。我犹豫过该怎么表达才好……果然还是简单直接点最好吧。那个……能有老师在，真的太好了。","text_original":"改めて言葉にするのは少し照れ臭いですね。どう伝えるのが一番良いのか、迷ったのですが……やっぱり、シンプルなものが一番かな、と。その……先生が居てくださって、本当に良かったです。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_relationship_up_1.ogg"},{"description":"ch0309_relationship_up_2","category":"growup","text":"其实，我也并不是100%地信任老师。不过……95%左右还是信任的哦。","text_original":"本当は、まだ先生のことを100％信用しているわけじゃないんです。でも……95％くらいは、信じていますよ。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_relationship_up_2.ogg"},{"description":"ch0309_relationship_up_3","category":"growup","text":"您说过，每个学生对您都是重要的存在吧。一开始我不太明白……但最近，我好像渐渐明白那句话的意思了。同时，又感到了些许的……失落。","text_original":"どの生徒も、先生にとっては大切な存在だと言っていましたよね。はじめはよく理解できてなかったのですが……最近、その意味が分かるようになったんです。同時に、少しだけ残念にも思ってしまうのですが……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_relationship_up_3.ogg"},{"description":"ch0309_relationship_up_4","category":"growup","text":"老师您常说希望我能多依赖您……但我总觉得光是那样有点过意不去……或者说不够满足。我没、没别的意思！只是……我也想回报您地恩情。受多少恩就回报多少，这就是阿里乌斯流。","text_original":"よく先生は頼ってほしい、と言ってくださりますが……私としてはそれだけではなんだか申し訳ないというか……物足りないというか。ふ、深い意味はないです！ただ、その……私も恩返しがしたいな、と。助けてもらった分だけ返すのがアリウス流ですから。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_relationship_up_4.ogg"},{"description":"ch0309_season_birthday_1","category":"lobby","text":"感谢……您的生日祝福，老师。","text_original":"誕生日……祝ってくださって、ありがとうございます。先生。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_birthday_1.ogg"},{"description":"ch0309_season_birthday_2","category":"lobby","text":"在阿里乌斯，大家都很重视生日。","text_original":"アリウスでは、誕生日を大切にしているんです。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_birthday_2.ogg"},{"description":"ch0309_season_birthday_3","category":"lobby","text":"互相庆祝彼此的生日……我总觉得，如果连这件事都放弃了，就会失去真正重要的东西。","text_original":"お互いの誕生日を祝いあう……それさえやめてしまったら本当に大切な何かまで、なくなってしまうような気がして。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_birthday_3.ogg"},{"description":"ch0309_season_birthday_4","category":"lobby","text":"不过嘛……因为会被骂，所以庆祝也没法搞得太盛大就是了。","text_original":"まあでも……怒られるので、あまり盛大に祝ったりはできなかったんですけどね。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_birthday_4.ogg"},{"description":"ch0309_season_birthday_player_1","category":"lobby","text":"生日快乐，老师。","text_original":"お誕生日おめでとうございます、先生。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_birthday_player_1.ogg"},{"description":"ch0309_season_birthday_player_2","category":"lobby","text":"那个，我能做的事情不多，所以只能送上祝福的话语了……","text_original":"その、私にできることがあまりないので、お祝いの言葉だけになってしまうんですが……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_birthday_player_2.ogg"},{"description":"ch0309_season_birthday_player_3","category":"lobby","text":"诶？下次想听我吹口琴……？那、那个……","text_original":"えっ？今度ハーモニカを聞かせてほしい……？そ、それは……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_birthday_player_3.ogg"},{"description":"ch0309_season_birthday_player_4","category":"lobby","text":"哈啊……我知道了。只给老师一个人听哦？","text_original":"はぁ……分かりました。先生にだけ、ですよ？","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_birthday_player_4.ogg"},{"description":"ch0309_season_halloween_1","category":"lobby","text":"我不太了解万圣节……","text_original":"ハロウィンのことはよく知らないのですが……","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_halloween_1.ogg"},{"description":"ch0309_season_halloween_2","category":"lobby","text":"但如果不借着节日的由头去讨要糖果，那也就是个普通的日子吧。","text_original":"お祭りに乗じてお菓子をねだらなかったら、特に何もない日ですよね。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_halloween_2.ogg"},{"description":"ch0309_season_halloween_3","category":"lobby","text":"总觉得有点像以前的阿里斯。……只留下了恐惧的，那些日子。","text_original":"なんだか昔のアリウスみたいだなって思いました。……恐怖しか残っていなかった、あの頃の。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_halloween_3.ogg"},{"description":"ch0309_season_newyear_1","category":"lobby","text":"一年结束，新年伊始的日子——","text_original":"一年が終わり、新しい年が始まる日――","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_newyear_1.ogg"},{"description":"ch0309_season_newyear_2","category":"lobby","text":"以前我希望这样的日子永远不要到来。真是不可思议……现在我倒觉得，这样也不坏。","text_original":"昔は、こんな日なんて来なければいいと思っていたのに。不思議なものです……今は、悪くないと思っているんですよ。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_newyear_2.ogg"},{"description":"ch0309_season_newyear_3","category":"lobby","text":"新年快乐，老师。","text_original":"あけましておめでとうございます、先生。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_newyear_3.ogg"},{"description":"ch0309_season_xmas_1","category":"lobby","text":"圣诞节啊。我也姑且是知道的。","text_original":"クリスマスですね。一応、知ってますよ。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_xmas_1.ogg"},{"description":"ch0309_season_xmas_2","category":"lobby","text":"在很久以前——对圣三一和格赫娜……","text_original":"その昔――トリニティとゲヘナに……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_xmas_2.ogg"},{"description":"ch0309_season_xmas_3","category":"lobby","text":"我曾半开玩笑地说过，要成为给他们送去枪林弹雨作礼物的圣诞老人呢。","text_original":"銃弾の雨をプレゼントするサンタにでもなろうか、と冗談めかして言ったことがあるので。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_season_xmas_3.ogg"},{"description":"ch0309_tactic_defeat_1","category":"battle","text":"怎么会？明明一切都很完美……","text_original":"どうして？全ては完璧だったのに……","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_tactic_defeat_1.ogg"},{"description":"ch0309_tactic_defeat_2","category":"battle","text":"下次……一定要……","text_original":"次こそ……必ず……","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_tactic_defeat_2.ogg"},{"description":"ch0309_tactic_in_1","category":"battle","text":"那么，会是个什么样的地方呢。","text_original":"さて、どのような場所なのでしょうか。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_tactic_in_1.ogg"},{"description":"ch0309_tactic_in_2","category":"battle","text":"原来如此，是这种感觉啊。","text_original":"なるほど、こういう感じなのですね。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_tactic_in_2.ogg"},{"description":"ch0309_tactic_victory_1","category":"battle","text":"真是一场酣畅淋漓的战斗。","text_original":"手ごたえのある戦いでした。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_tactic_victory_1.ogg"},{"description":"ch0309_tactic_victory_2","category":"battle","text":"这就是阿里乌斯流。","text_original":"これがアリウス流、です。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/ch0309_tactic_victory_2.ogg"},{"description":"CH0309_Title","category":"lobby","text":"蔚蓝档案。呵呵。","text_original":"ブルーアーカイブ、です。ふふ。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/CH0309_Title.ogg"},{"description":"main_63000_001","category":"other","text":"真的是，发生了各种各样的事情呢。","text_original":"……本当に、色々なことがありましたね。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/main_63000_001.ogg"},{"description":"main_63000_002","category":"other","text":"回过头来一想，还会觉得这一切是不是只是一场梦。","text_original":"今振り返ると、全てが夢だったんじゃないかと思うほどですが……。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/main_63000_002.ogg"},{"description":"main_63000_003","category":"other","text":"不过，我还是想再次感谢您为我们做过的一切。","text_original":"でも、すべてのことに改めて感謝の気持ちを伝えたいと思っています。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/main_63000_003.ogg"},{"description":"main_63000_004","category":"other","text":"——这一点感谢，是我的真心话。","text_original":"——これだけは、私の本心です。","file":"//static.kivo.wiki/voices/students/%E6%A2%AF%20%E6%98%B4/original/jp/main_63000_004.ogg"}],"voice_cn":[],"voice_kr":[],"gift_data":[{"id":270,"favorability":40},{"id":43,"favorability":60},{"id":70,"favorability":60},{"id":76,"favorability":40},{"id":96,"favorability":40},{"id":87,"favorability":180},{"id":31,"favorability":40},{"id":58,"favorability":40},{"id":17,"favorability":40},{"id":92,"favorability":60},{"id":150,"favorability":240}],"furniture":null,"character_datas":[{"character_id":10130,"dev_name":"CH0309","combat_style":"default","type":"Dealer","attack_attribute":"Mystic","defensive_attributes":"Special","is_groupc_control":false,"team_position":"MIDDLE","battlefield_position":"STRIKER","rarity":3,"limited":false,"outdoor_adaptability":"D","indoor_adaptability":"B","street_adaptability":"S","favorite_equipment":0,"weapons":{"name":"Anomoios","name_cn":""}}],"info_declare_uuid":"693f6424-c2c7-4ad6-9844-0a0a956c72ac","skill_declare_uuid":"880f33f8-e639-4398-b1b5-7f3d57507c42","supplementary_uuid":"7fe79abb-414e-4a46-a673-96dc50d9179f","supplementary_declare_uuid":"73c81106-d33f-4ec7-8839-a50f013b4bee","created_at":1758099125,"updated_at":1768588997},"message":"OK","success":true,"time":1768764901,"version":"1.0.0-beta.42"}