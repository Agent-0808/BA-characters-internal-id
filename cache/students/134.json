iginal/jp/ch0166_battle_damage_1.ogg"},{"description":"ch0166_battle_damage_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_damage_2.ogg"},{"description":"ch0166_battle_damage_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_damage_3.ogg"},{"description":"ch0166_battle_defense_1","category":"battle","text":"头盔可不只是装饰！","text_original":"ヘルメットは飾りじゃないのよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_defense_1.ogg"},{"description":"ch0166_battle_in_1","category":"battle","text":"奉陪到底！","text_original":"受けて立つわよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_in_1.ogg"},{"description":"ch0166_battle_in_2","category":"battle","text":"一个个上，排好队！我可没空陪你们磨蹭！","text_original":"順番にかかってきなさい！こっちはヒマじゃないのよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_in_2.ogg"},{"description":"ch0166_battle_move_1","category":"battle","text":"让路让路！","text_original":"どいたどいた！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_move_1.ogg"},{"description":"ch0166_battle_move_2","category":"battle","text":"干净利落地解决掉吧！","text_original":"ちゃっちゃと終わらせるわよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_move_2.ogg"},{"description":"ch0166_battle_recovery_1","category":"battle","text":"呼——好险啊...谢谢！","text_original":"ひゅ～っ、ギリギリだったわ……ありがとう！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_recovery_1.ogg"},{"description":"ch0166_battle_retire","category":"battle","text":"都说了排队一个个来啊！哎哟！","text_original":"だから順番にかかってきなさいって言ったでしょう！ぎゃー！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_retire.ogg"},{"description":"ch0166_battle_shout_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_shout_1.ogg"},{"description":"ch0166_battle_shout_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_shout_2.ogg"},{"description":"ch0166_battle_shout_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_shout_3.ogg"},{"description":"ch0166_battle_tacticalaction_1","category":"battle","text":"去那边吧！","text_original":"あっちに行くわよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_tacticalaction_1.ogg"},{"description":"ch0166_battle_victory_1","category":"battle","text":"下次把你同伴也带来！","text_original":"次は仲間も連れてきなさいよね！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_victory_1.ogg"},{"description":"ch0166_battle_victory_2","category":"battle","text":"嘛……你们的表现大概也勉强算跟我们差不多吧？","text_original":"ま、うちらと同じくらいの働きはしてるんじゃない？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_battle_victory_2.ogg"},{"description":"ch0166_cafe_monolog_1","category":"cafe","text":"没有挂头盔的地方吗？","text_original":"ヘルメットをかけるとこってないかしら？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_cafe_monolog_1.ogg"},{"description":"ch0166_cafe_monolog_2","category":"cafe","text":"好像...在哪里见过...？","text_original":"どこかで……見たことがあるような……？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_cafe_monolog_2.ogg"},{"description":"ch0166_cafe_monolog_3","category":"cafe","text":"（不知道能不能上去搭话...？）","text_original":"（話しかけてもいいのかしら……？）","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_cafe_monolog_3.ogg"},{"description":"ch0166_cafe_monolog_4","category":"cafe","text":"这里还蛮不错的嘛。也能挡雨。","text_original":"ここ、なかなかいいじゃない。雨もしのげるし。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_cafe_monolog_4.ogg"},{"description":"ch0166_cafe_monolog_5","category":"cafe","text":"要是把头盔团的大家也带来就好了呢……","text_original":"ヘルメット団のみんなも連れてきてあげればよかったわね……。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_cafe_monolog_5.ogg"},{"description":"ch0166_commonskill","category":"battle","text":"上吧！粉碎他们吧！","text_original":"行け！嚙みちぎってきなさい！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_commonskill.ogg"},{"description":"ch0166_eventmission_1_1","category":"event","text":"...喂，你在干嘛呢！快去做自己的事情！","text_original":"……って、何やってんのよ！さっさと自分の仕事しなさいっての！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_1_1.ogg"},{"description":"ch0166_eventmission_1_2","category":"event","text":"（真是的...老师唯一的缺点就是人太好了...）","text_original":"（まったくもう……先生って人が良すぎるのが玉にキズなのよね……）","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_1_2.ogg"},{"description":"ch0166_eventmission_2_1","category":"event","text":"唉...你应该不知道所以话说在前头。","text_original":"はぁ……知らないだろうから一応言っとくけど。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_2_1.ogg"},{"description":"ch0166_eventmission_2_2","category":"event","text":"触碰头盔的话，回音会很吵。...只能碰一下哦...真是的。","text_original":"ヘルメットを触られると、音が反響してすごくうるさいの。……ちょっとだけよ……まったく。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_2_2.ogg"},{"description":"ch0166_eventmission_day_end_1","category":"event","text":"好，今天的指标完成！小菜一碟。","text_original":"はいっ、今日のノルマ終了！楽勝だったわね。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_day_end_1.ogg"},{"description":"ch0166_eventmission_day_end_2","category":"event","text":"这种程度，交给我的话分分钟的事♪","text_original":"この程度、うちにかかれば朝飯前よ♪","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_day_end_2.ogg"},{"description":"ch0166_eventmission_get_1","category":"event","text":"不拿到这个程度的话，可是划不来的呢！","text_original":"これくらいもらわないと、割に合わないわよね！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_get_1.ogg"},{"description":"ch0166_eventmission_get_2","category":"event","text":"挺厉害的嘛！等的就是这个！","text_original":"すごいじゃない！こういうのを待ってたのよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_get_2.ogg"},{"description":"ch0166_eventmission_login_1","category":"event","text":"哈啊…哈啊….等下，你们到底是什么人啊！？","text_original":"はぁっ、はぁっ……ちょっと、あんたら何者なのよ！？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_login_1.ogg"},{"description":"ch0166_eventmission_login_2","category":"event","text":"魔法少女...该不会真的说会用魔法吧？","text_original":"魔法少女って……まさかホントに魔法を使えるとか言わないでしょうね！？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_eventmission_login_2.ogg"},{"description":"ch0166_exskill1_1","category":"battle","text":"头盔团！准备好了吗？","text_original":"ヘルメット団！準備はいい？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill1_1.ogg"},{"description":"ch0166_exskill1_2","category":"battle","text":"好好看着吧！","text_original":"ちゃーんと、見てなさいよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill1_2.ogg"},{"description":"ch0166_exskill1_3","category":"battle","text":"头盔团也被小看得够可以的嘛，有意思！!","text_original":"ヘルメット団もナメられたものね、面白いじゃないの！！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill1_3.ogg"},{"description":"ch0166_exskill1_level_1","category":"battle","text":"过肩投球！","text_original":"オーバーハンド！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill1_level_1.ogg"},{"description":"ch0166_exskill1_level_2","category":"battle","text":"瞧好了！轰——！","text_original":"いくわよ！ドッカーン！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill1_level_2.ogg"},{"description":"ch0166_exskill1_level_3","category":"battle","text":"看我一招解决！","text_original":"スパッと決めてやるわよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill1_level_3.ogg"},{"description":"ch0166_exskill2_1","category":"battle","text":"头盔团，突击！","text_original":"ヘルメット団、突撃！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill2_1.ogg"},{"description":"ch0166_exskill2_2","category":"battle","text":"头盔图！准备好了吗？","text_original":"ヘルメット団！準備はいい？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill2_2.ogg"},{"description":"ch0166_exskill2_3","category":"battle","text":"彻底击溃他们吧！","text_original":"ぶっ潰してやるわよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill2_3.ogg"},{"description":"ch0166_exskill2_level_1","category":"battle","text":"把敌人打得落花流水也没问题！但是别受伤了哦！","text_original":"敵はボコボコにしていいわよ！でもケガすんじゃないわよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill2_level_1.ogg"},{"description":"ch0166_exskill2_level_2","category":"battle","text":"不用手下留情，全力上吧！","text_original":"手加減なんかしないで思いっきり行きなさいよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill2_level_2.ogg"},{"description":"ch0166_exskill2_level_3","category":"battle","text":"相信我！","text_original":"うちを信じなさい！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exskill2_level_3.ogg"},{"description":"ch0166_exweapon_get","category":"growup","text":"哎呀，我一直想要这个！谢谢你，老师♪","text_original":"あら！これほしかったのよ！ありがとね、先生♪","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_exweapon_get.ogg"},{"description":"ch0166_formation_in_1","category":"formation","text":"嗯...也就是说可以大闹一通对吧？","text_original":"ふーん、暴れてもいいってことよね？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_formation_in_1.ogg"},{"description":"ch0166_formation_in_2","category":"formation","text":"和你们是同伴了，有种奇怪的感觉呢...啊哈哈...","text_original":"あんた達が味方なのって、なんか変な感じするわね……あはは……。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_formation_in_2.ogg"},{"description":"ch0166_formation_select","category":"formation","text":"喂，都说了放我下来——！周围还有人呢！","text_original":"ちょっ、降ろしなさいってばー！周りに人がいるでしょ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_formation_select.ogg"},{"description":"ch0166_gachaget","category":"growup","text":"哗啦哗啦头盔团的团长，河驹风兰舞哟。等等，老师！！太近了！离远一点！","text_original":"ジャブジャブヘルメット団のリーダー、河駒風ラブよ。ちょ、先生！！近いってば！離れて！！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_gachaget.ogg"},{"description":"ch0166_growup_1","category":"growup","text":"诶，这个给我吗？这样啊...谢谢啦！","text_original":"えっ、これをうちに？そう……ありがとね！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_growup_1.ogg"},{"description":"ch0166_growup_2","category":"growup","text":"真的要给我吗...？就算一会要我还给你也不还哦！","text_original":"ほんとにくれるの……？後から返せって言われてもダメだからね！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_growup_2.ogg"},{"description":"ch0166_growup_3","category":"growup","text":"让我变得这么强是要怎么样？大闹一通无法收拾的时候可别怪我哦！","text_original":"うちをこんなに強くしてどうすんのよ？取り返しがつかなくなっても知らないわよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_growup_3.ogg"},{"description":"ch0166_growup_4","category":"growup","text":"呼呼，成长真好啊♪","text_original":"ふふっ、成長っていいものよね♪","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_growup_4.ogg"},{"description":"ch0166_lobby_1_1","category":"lobby","text":"对头盔有兴趣吗？","text_original":"ヘルメットに興味はないかしら？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_1_1.ogg"},{"description":"ch0166_lobby_1_2","category":"lobby","text":"老师的话，我觉得会很合适哦？","text_original":"先生なら、きっと似合うと思うわよ？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_1_2.ogg"},{"description":"ch0166_lobby_2_1","category":"lobby","text":"头盔不仅很酷还很实用哦！","text_original":"ヘルメットってかっこいい上に実用的なのよ？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_2_1.ogg"},{"description":"ch0166_lobby_2_2","category":"lobby","text":"能保护头部又好看，简直最棒了对吧！","text_original":"頭を守ってくれて見た目も良いの。最高でしょ？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_2_2.ogg"},{"description":"ch0166_lobby_3_1","category":"lobby","text":"（...来夏莱的人，几乎没有戴头盔的呢）","text_original":"（……シャーレに来る人、ほとんどヘルメット被ってないのよね）","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_3_1.ogg"},{"description":"ch0166_lobby_3_2","category":"lobby","text":"（看得我自己都开始坐立不安了……总觉感觉冷静不下来！）","text_original":"（見てるうちまでそわそわしてきちゃう……なんだか落ち着かないわ！）","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_3_2.ogg"},{"description":"ch0166_lobby_4_1","category":"lobby","text":"老师…这么忙的吗","text_original":"先生って……そんなに忙しいの？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_4_1.ogg"},{"description":"ch0166_lobby_4_2","category":"lobby","text":"总是在各种地方来回奔波，还以为是个闲人。","text_original":"いつも色んなところに駆けつけてくるから、暇人なのかと思ってたわ。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_4_2.ogg"},{"description":"ch0166_lobby_5_1","category":"lobby","text":"哼哼，哼哼——，哼哼哼——...。","text_original":"ふふん、ふふーん、んふふふーん……。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_5_1.ogg"},{"description":"ch0166_lobby_5_2","category":"lobby","text":"哼——，头盔最棒！！","text_original":"んふーん、ヘルメットさいっこー！！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_lobby_5_2.ogg"},{"description":"ch0166_login_1_1","category":"lobby","text":"哎呀，老师。呀吼。","text_original":"あら、先生。やっほー。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_login_1_1.ogg"},{"description":"ch0166_login_1_2","category":"lobby","text":"今天该做什么呢？打棒球吗？","text_original":"今日は何をするのかしら？野球？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_login_1_2.ogg"},{"description":"ch0166_login_2_1","category":"lobby","text":"欢迎回来，老师。","text_original":"いらっしゃい、先生。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_login_2_1.ogg"},{"description":"ch0166_login_2_2","category":"lobby","text":"有什么有趣的话题之类的吗？","text_original":"なんか面白い話とか、ないの？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_login_2_2.ogg"},{"description":"ch0166_memoriallobby_1_1","category":"lobby","text":"一，二，三，四，五，六。很好！","text_original":"いち、に、さん、し、ご、ろく。よしっ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_1_1.ogg"},{"description":"ch0166_memoriallobby_1_2","category":"lobby","text":"六只全都到齐了！","text_original":"六羽ともちゃんと全員いるわね！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_1_2.ogg"},{"description":"ch0166_memoriallobby_1_3","category":"lobby","text":"要好好地听妈妈的话哦，你们几个。","text_original":"ママの言うことはちゃんと聞いときなさいよ、あんたたち。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_1_3.ogg"},{"description":"ch0166_memoriallobby_2_1","category":"lobby","text":"鸭妈妈看起来也没事。","text_original":"母アヒルももう大丈夫そうね。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_2_1.ogg"},{"description":"ch0166_memoriallobby_2_2","category":"lobby","text":"这样就告一段落了！","text_original":"これで一件落着、っと！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_2_2.ogg"},{"description":"ch0166_memoriallobby_3_1","category":"lobby","text":"你你你，你在说什么啊！！","text_original":"な、ななな……なに言ってんのよ！！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_3_1.ogg"},{"description":"ch0166_memoriallobby_3_2","category":"lobby","text":"老师，你这样是不是有点失礼？","text_original":"先生、それってちょっと失礼じゃない？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_3_2.ogg"},{"description":"ch0166_memoriallobby_3_3","category":"lobby","text":"诶？...啊！？那个...","text_original":"え？……あっ！？えっと……","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_3_3.ogg"},{"description":"ch0166_memoriallobby_4_1","category":"lobby","text":"啊，啊啊！原来是这么回事啊！？","text_original":"あ、ああっ！そ、そういうことね！？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_4_1.ogg"},{"description":"ch0166_memoriallobby_4_2","category":"lobby","text":"那，那是当然！毕竟我是团长，这种程度都做不到的话就当不成了！","text_original":"も、もちろん！リーダーだもの！この程度できないとダメじゃない！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_4_2.ogg"},{"description":"ch0166_memoriallobby_5_1","category":"lobby","text":"（老师真的只是说错话了吗？还是故意这么说的...？）","text_original":"（先生ってば、ホントに言い間違えただけ？それともワザと……？）","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_5_1.ogg"},{"description":"ch0166_memoriallobby_5_2","category":"lobby","text":"（不管哪种都让人火大！要是故意的就更烦人了！！）","text_original":"（どっちにしろ腹立つわね！わざとだったらもっとムカつくし！！）","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_5_2.ogg"},{"description":"ch0166_memoriallobby_5_3","category":"lobby","text":"（难不成，真的是故意这样的...？）","text_original":"（まさか、わざとだったり……するのかしら……？）","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_memoriallobby_5_3.ogg"},{"description":"ch0166_omikuji_1","category":"other","text":"旁边贴着的这幅画……不是和那群孩子穿的一样吗","text_original":"横に貼ってあるこの絵……あの子たちと同じ服じゃない？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikuji_1.ogg"},{"description":"ch0166_omikuji_2_1","category":"other","text":"不会从里面突然跳出来偷袭我吧……？","text_original":"まさか中から不意打ちされたりとかしないわよね……？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikuji_2_1.ogg"},{"description":"ch0166_omikuji_end","category":"other","text":"啊呀，好像要打烊了。把剩下的全都用了吧！","text_original":"あら、閉店時間みたい。残ってるやつは全部使っちゃいましょ。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikuji_end.ogg"},{"description":"ch0166_omikuji_login_1_1","category":"event","text":"那个，老师，知道这是什么吗？","text_original":"ねぇ先生、これって何かわかる？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikuji_login_1_1.ogg"},{"description":"ch0166_omikuji_login_1_2","category":"event","text":"......自动贩卖机，看起来像是。","text_original":"……自販機、に見えるんだけど。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikuji_login_1_2.ogg"},{"description":"ch0166_omikuji_login_2_1","category":"event","text":"除了专用的货币以外都不能用的样子。","text_original":"専用のやつしか使えないみたいね。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikuji_login_2_1.ogg"},{"description":"ch0166_omikuji_login_2_2","category":"event","text":"嘛，反正除了这个以外都不能用...试着投入一个看看吧。","text_original":"まあ、これにしか使わないだろうし……試しに一回入れてみなさいよ。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikuji_login_2_2.ogg"},{"description":"ch0166_omikujipickup_1","category":"other","text":"哇，闪闪发光...是超稀有的吗？","text_original":"うわ、キラキラしてる……これって超レアってことかしら？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikujipickup_1.ogg"},{"description":"ch0166_omikujipickup_2","category":"other","text":"没怎么见过这样的。很稀有吗？","text_original":"あんまり見かけないヤツね。レアなのかしら？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikujipickup_2.ogg"},{"description":"ch0166_omikujipickup_3","category":"other","text":"金色...呼呼，有种中奖的感觉！还有更多吗？","text_original":"金色……ふふっ、なんか当たりっぽいわね！もっとあるかしら？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikujipickup_3.ogg"},{"description":"ch0166_omikujipickup_4","category":"other","text":"嗯...哪种是稀有的哪种是常见的...完全搞不懂。","text_original":"うぅ〜ん、どれがレアでどれがハズレなのか……全然分からないわ。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikujipickup_4.ogg"},{"description":"ch0166_omikujipickup_5","category":"other","text":"啊，黑色！是咱喜欢的颜色！","text_original":"あっ、黒！うちの好きな色よ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_omikujipickup_5.ogg"},{"description":"ch0166_relationship_up_1","category":"growup","text":"那个...咱是问题儿童的事情，不是早就知道了吗？","text_original":"ちょっと……うちが問題児なことくらい、分かってたんじゃないの？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_relationship_up_1.ogg"},{"description":"ch0166_relationship_up_2","category":"growup","text":"别太跟我套近乎…...我会有点不知所措的","text_original":"あんまり馴れ馴れしくしないでよね……ちょっと困るのよ。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_relationship_up_2.ogg"},{"description":"ch0166_relationship_up_3","category":"growup","text":"被当学生对待……实在太久没有过了……真是的……","text_original":"生徒扱いなんて、久しぶりすぎて……もう……。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_relationship_up_3.ogg"},{"description":"ch0166_relationship_up_4","category":"growup","text":"等等！边上不是还有人吗！现在先别摸我的头！","text_original":"ちょっと！周りに人がいるでしょうが！今は頭撫でないで！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_relationship_up_4.ogg"},{"description":"ch0166_season_birthday_1","category":"lobby","text":"总觉得...昨天开始手下的孩子们就一直鬼鬼祟祟的。","text_original":"なんか……昨日からうちの子たちがずっとコソコソしてるのよね。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_birthday_1.ogg"},{"description":"ch0166_season_birthday_2","category":"lobby","text":"说是有重要的事情要谈...究竟是做什么呢。","text_original":"真面目な話があるから来てくれって……何をするつもりなのかしら。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_birthday_2.ogg"},{"description":"ch0166_season_birthday_player_1","category":"lobby","text":"哎呀，今天不是老师的生日吗？","text_original":"あら、今日って先生の誕生日じゃない？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_birthday_player_1.ogg"},{"description":"ch0166_season_birthday_player_2","category":"lobby","text":"生日快乐！要多吃点好吃的喔！","text_original":"お誕生日おめでとう！美味しいもの、いっぱい食べなさいよね！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_birthday_player_2.ogg"},{"description":"ch0166_season_halloween_1","category":"lobby","text":"哈啊...哈啊...好，好累啊...","text_original":"はぁっはぁっ……つ、疲れたわ……。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_halloween_1.ogg"},{"description":"ch0166_season_halloween_2","category":"lobby","text":"那几个孩子一边喊着不给糖就捣蛋，一边就跑过来了……","text_original":"お菓子くれなきゃイタズラするって言いながら来るのよ、あいつら……。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_halloween_2.ogg"},{"description":"ch0166_season_halloween_3","category":"lobby","text":"但是我又没带糖果...这样一来就只有被恶作剧了！真是的！！","text_original":"でもうち、お菓子なんか持ってないし……そうしたら、イタズラばっかして！もう！！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_halloween_3.ogg"},{"description":"ch0166_season_newyear","category":"lobby","text":"新的一年到来了！希望今年大家也要健健康康的，还要赚的满满的！","text_original":"新しい年がやってきたわね！今年もみんなが健康でいて、いっぱい稼げますように！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_newyear.ogg"},{"description":"ch0166_season_xmas_1","category":"lobby","text":"圣诞节快乐，老师！","text_original":"メリークリスマス、先生！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_xmas_1.ogg"},{"description":"ch0166_season_xmas_2","category":"lobby","text":"嘛，虽然说圣诞老人不会来到坏孩子身边...享受一下气氛不也挺好的吗？","text_original":"まぁ、悪い子にはサンタなんてこないんだけど……気分くらいは楽しんでもいいじゃない？","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_season_xmas_2.ogg"},{"description":"ch0166_tactic_defeat_1","category":"battle","text":"刚才只是状态还没完全上来而已。","text_original":"まだ本調子じゃなかっただけよ。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_tactic_defeat_1.ogg"},{"description":"ch0166_tactic_defeat_2","category":"battle","text":"可别以为这样就结束了！","text_original":"これで終わりってなんで思ってんじゃないわよ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_tactic_defeat_2.ogg"},{"description":"ch0166_tactic_in_1","category":"battle","text":"交给我吧！","text_original":"うちに任せなさい！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_tactic_in_1.ogg"},{"description":"ch0166_tactic_in_2","category":"battle","text":"也就是个轻松的热身运动吧。","text_original":"軽い準備運動ってとこかしらね。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_tactic_in_2.ogg"},{"description":"ch0166_tactic_victory_1","category":"battle","text":"别得意忘形了！还差得远呢！","text_original":"調子乗ってんじゃないわよ！一昨日来なさいっての！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_tactic_victory_1.ogg"},{"description":"ch0166_tactic_victory_2","category":"battle","text":"什么嘛，完全不堪一击嘛。","text_original":"なにこれ、手ごたえがないわねぇ。","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/ch0166_tactic_victory_2.ogg"},{"description":"CH0166_Title","category":"lobby","text":"蔚蓝档案！","text_original":"ブルーアーカイブ！","file":"//static.kivo.wiki/voices/students/%E6%B2%B3%E9%A9%B9%E9%A3%8E%20%E5%85%B0%E8%88%9E/original/jp/CH0166_Title.ogg"}],"voice_cn":[],"voice_kr":[],"gift_data":[{"id":76,"favorability":40},{"id":67,"favorability":40},{"id":70,"favorability":40},{"id":96,"favorability":40},{"id":43,"favorability":40},{"id":38,"favorability":40},{"id":58,"favorability":40},{"id":59,"favorability":40},{"id":92,"favorability":40},{"id":268,"favorability":60},{"id":87,"favorability":180},{"id":107,"favorability":180},{"id":156,"favorability":240}],"furniture":[1807],"character_datas":[{"character_id":16018,"dev_name":"CH0166","combat_style":"default","type":"Dealer","attack_attribute":"Vibration","defensive_attributes":"Special","is_groupc_control":true,"team_position":"FRONT","battlefield_position":"STRIKER","rarity":1,"limited":true,"outdoor_adaptability":"B","indoor_adaptability":"C","street_adaptability":"A","favorite_equipment":0,"weapons":{"name":"替补击球手","name_cn":""}}],"info_declare_uuid":"3c3bbba7-07ef-493d-98d4-b25fe442f034","skill_declare_uuid":"f9efc215-708a-407e-82a6-7be1dddf6cc7","supplementary_uuid":"84a47e33-f8ab-412e-90a5-549b0ea6745b","supplementary_declare_uuid":"f7e3e4c3-40d2-49fe-bca5-61d90aa315fe","created_at":1685460145,"updated_at":1768585421},"message":"OK","success":true,"time":1768763542,"version":"1.0.0-beta.42"}