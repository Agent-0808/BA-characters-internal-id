s/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/YyMsDQVw3RPrakUkv3GMHtkDgYJgbUae.ogg"},{"description":"ch0155_memoriallobby_3_2","category":"lobby","text":"抱歉，抱歉。感觉突然松了一口气呢。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/cRlwjp9bvuUvfIzNvqXYpHb1EeBdR3qr.ogg"},{"description":"ch0155_memoriallobby_4_1","category":"lobby","text":"谢啦，老师。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/pHGfLjgmlJ9uE0tWWP28yuqhqUk7yQz7.ogg"},{"description":"ch0155_memoriallobby_4_2","category":"lobby","text":"能这样陪着我，","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/k8OlIRjyoyxJP4QtREHulDFQYFXdNca6.ogg"},{"description":"ch0155_memoriallobby_5_1","category":"lobby","text":"真的很感谢。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/6HVJfaYRTDHm3dXzJ0XD7w1bmLm8iZj4.ogg"},{"description":"ch0155_memoriallobby_5_2","category":"lobby","text":"跟老师在一起，我真的好开心啊。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/KIQNmvYIaPBeV2XQ4UTzM0yfGegRusZV.ogg"},{"description":"ch0155_relationship_up_1","category":"growup","text":"和老师在一起真——的很舒服。嗯？老师你觉得呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/WTGbnqJIrz8PGqq7m3hp8ORUZkM3yfUn.ogg"},{"description":"ch0155_relationship_up_2","category":"growup","text":"不管什么话题都可以，我想跟老师聊更多更多。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/6omsesfeQlyB7vLSfo31sxAlHRfy3xf7.ogg"},{"description":"ch0155_relationship_up_3","category":"growup","text":"别担心，我会尽我所能回报你的。嗯，没错，用各种方式。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/v93z1QwUXTKW25HJTBktz7mYDe7ocmVV.ogg"},{"description":"ch0155_relationship_up_4","category":"growup","text":"嗯……感觉……好特别啊。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/u9i8Kd2MEnhzJlN8R8bXuSfat0cycnJV.ogg"},{"description":"ch0155_season_birthday","category":"lobby","text":"老师老师。你知道今天是什么日子吧？ 我非常期待哦~？","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/OYzKqv9hWz8ax5orDXKUEflfs8DWAKm8.ogg"},{"description":"ch0155_season_birthday_player","category":"lobby","text":"老师的生日…… 没办法了，今天我请客！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/IrNOLNiSE1yv5ebA6gMG0vnCeVB1mgeW.ogg"},{"description":"ch0155_season_chinesenewyear","category":"lobby","text":"新春快乐，老师。新年可是甜点爱好者的大日子啊。快一起去外面探店吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/xgLS5rTtM3dqmd30vWgopQRuOXArOhoV.ogg"},{"description":"ch0155_season_halloween_1_1","category":"lobby","text":"今天是可以收到好多糖果的日子……！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/4PJrnXnjsymkISC49ct9YKSe7wwSykXg.ogg"},{"description":"ch0155_season_halloween_1_2","category":"lobby","text":"要上咯，老师！口袋的容量足够吗？今天老师的口袋要用来放很多很多糖果哦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/XDpm9KBdiM0EJJ0kPvDGwIIXsJuoFpb8.ogg"},{"description":"ch0155_season_midautumn","category":"lobby","text":"老师知道月饼中蕴含的哲学吗？我也不太清楚，那就一起研究一下吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/jJ0GSRpKiZX2RIHW6Z7kA10rzKlad27s.ogg"},{"description":"ch0155_season_newyear","category":"lobby","text":"今年会出什么新品呢？ 老师，我们一起去买吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/mG0CGsjVvx73ah7qTnhykyJOrcG69oo7.ogg"},{"description":"ch0155_season_xmas","category":"lobby","text":"圣诞老人今年也会抛弃我吗！ 不对，说不定老师就是我的圣诞老人！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/xRtgXROTcyP2Mmx3G6eVd6pKbf9aCECN.ogg"},{"description":"ch0155_tactic_defeat_1","category":"battle","text":"嗯……欸？","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/sED1YwMeTXbKPRciGAbZ70lhjlV804Bg.ogg"},{"description":"ch0155_tactic_defeat_2","category":"battle","text":"对不起，老师……糖分不足……","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/LF2TdQNvCgG3RJIHDmZr0jqAuKHS5piE.ogg"},{"description":"ch0155_tactic_in_1","category":"battle","text":"嗯，这场战斗的尽头究竟是什么呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/d2Gw2hP8iKDdMLqMUkcQWm5ORAdWo591.ogg"},{"description":"ch0155_tactic_in_2","category":"battle","text":"那就……开始吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/HjRVkSREL1XZbcwtvPyg8d3ywVF8gHJJ.ogg"},{"description":"ch0155_tactic_victory_1","category":"battle","text":"好打完啦。甜点~甜点！","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/wzyVcmhVGlFJUZhoywKQis1g0atHqSXb.ogg"},{"description":"ch0155_tactic_victory_2","category":"battle","text":"回去吃点好吃的吧~","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/4LeYMuPONJfLON9Vg6J0QyyHgPmPAEPh.ogg"},{"description":"ch0155_title","category":"lobby","text":"Blue Archive","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/eW4pSABfPtWdElAfV7qQUKRVCgaCSmla.ogg"}],"voice_kr":[{"description":"ch0155_battle_shout_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/original/ch0155_battle_shout_3.ogg"},{"description":"ch0155_battle_tacticalaction_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/original/ch0155_battle_tacticalaction_1.ogg"},{"description":"ch0155_battle_victory_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%9F%9A%E9%B8%9F%20%E5%A4%8F/original/ch0155_battle_victory_1.ogg"},{"description":"ch0