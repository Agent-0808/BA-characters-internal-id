voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Battle_Recovery_1.ogg"},{"description":"CH0274_Battle_Retire","category":"battle","text":"都是，我的不足……","text_original":"私が、至らないばかりに......","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Battle_Retire.ogg"},{"description":"CH0274_Battle_Shout_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Battle_Shout_1.ogg"},{"description":"CH0274_Battle_Shout_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Battle_Shout_2.ogg"},{"description":"CH0274_Battle_Shout_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Battle_Shout_3.ogg"},{"description":"CH0274_Battle_TacticalAction_1","category":"battle","text":"哈！","text_original":"はっ！","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Battle_TacticalAction_1.ogg"},{"description":"CH0274_Battle_Victory_1","category":"battle","text":"真是一段美妙的时光。不知大家是否有享受这个舞台呢？","text_original":"素晴らしい時間でした。ステージは楽しんでいただけたでしょうか？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Battle_Victory_1.ogg"},{"description":"CH0274_Battle_Victory_2","category":"battle","text":"这样……就能与大家拉近距离了吧？","text_original":"これで……皆様に少しは近づけたのでしょうか？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Battle_Victory_2.ogg"},{"description":"CH0274_Cafe_monolog_1","category":"cafe","text":"难，难道说我被认出来了……？","text_original":"も、もしかして私だと気づかれているのでしょうか……？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Cafe_monolog_1.ogg"},{"description":"CH0274_Cafe_monolog_2","category":"cafe","text":"是不是干脆唱一首比较好呢……？","text_original":"歌ってしまったほうが良いのでしょうか……？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Cafe_monolog_2.ogg"},{"description":"CH0274_Cafe_monolog_3","category":"cafe","text":"总感觉，有些心浮气躁，静不下心来。","text_original":"なんだか、浮足立って落ち着かない心地です。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Cafe_monolog_3.ogg"},{"description":"CH0274_Cafe_monolog_4","category":"cafe","text":"呵呵……稍微轻松了些。","text_original":"ふふ……少しスッキリしますね。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Cafe_monolog_4.ogg"},{"description":"CH0274_Cafe_monolog_5","category":"cafe","text":"该不会……有人在看着我？","text_original":"もしかして……見られているのでしょうか？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Cafe_monolog_5.ogg"},{"description":"CH0274_CommonSkill","category":"battle","text":"那，那个……这样对吧！哇哔~！","text_original":"え、えっと……こうですね！わっぴ～！","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_CommonSkill.ogg"},{"description":"CH0274_EventLobby_1","category":"event","text":"老师，请问有什么事吗？……握，握手……是吗？","text_original":"先生、何か御用でしょうか？……あ、握手……でしょうか？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventLobby_1.ogg"},{"description":"CH0274_EventLobby_2","category":"event","text":"和穿修女服的时候相比，感觉现在我和大家更亲近了些。呵呵，这身打扮也不错呢。","text_original":"シスター服の時よりも、皆さんと親密になれた気がします。ふふっ、この服装も良いものですね。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventLobby_2.ogg"},{"description":"CH0274_EventLobby_3","category":"event","text":"那个……请问有什么事吗？总是被叫到的话……那个，我有点不知所措了。","text_original":"その……何か御用があるのでしょうか？何度も呼ばれると…その、何をすれば良いのか分かりません。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventLobby_3.ogg"},{"description":"CH0274_EventLobby_4","category":"event","text":"我最近在练习一段特别的编舞……如，如果您方便的话，您愿意看看吗？","text_original":"練習中のとっておきの振り付けがあるのですが……よ、よろしければご覧になりますか？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventLobby_4.ogg"},{"description":"CH0274_EventLogin_1","category":"event","text":"啊——啊——啊——啊——啊……老，老师？","text_original":"あーあーあーあーあっ……せ、先生！？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventLogin_1.ogg"},{"description":"CH0274_EventLogin_2","category":"event","text":"感谢您的到来，老师。樱、樱子，很开心！","text_original":"お越し下さりありがとうございます、先生。さ、サクラコ、嬉しいです！","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventLogin_2.ogg"},{"description":"CH0274_EventLogin_Season_1","category":"event","text":"已经过了一半了吗……。","text_original":"もう半分が過ぎてしまったのですね……。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventLogin_Season_1.ogg"},{"description":"CH0274_EventLogin_Season_2","category":"event","text":"虽说，美好的时光总是稍纵即逝……但现在还是不禁感到，时间一下子便消逝了。","text_original":"素晴らしい時間はあっという間とは申しますが…あまりにも一瞬で過ぎ去ってしまったような心地です。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventLogin_Season_2.ogg"},{"description":"CH0274_EventLogin_Season_End","category":"event","text":"呵呵，很不舍吗？……真巧，我也是。","text_original":"ふふっ、名残惜しいのですか？…偶然ですね、私もです。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventLogin_Season_End.ogg"},{"description":"CH0274_EventMission_1","category":"event","text":"说起来，老师……现在，我们两人独处呢。诶？不，不是那个意思……只是字面意思而已……","text_original":"そういえば、先生……いま、二人きりですね。え？い、いえ…言葉通りで、特に深い意味はないのです…が…。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventMission_1.ogg"},{"description":"CH0274_EventMission_2","category":"event","text":"这身衣服很适合我……？呵呵，非常感谢。","text_original":"その服、よく似合ってる……？ふふ、ありがとうございます。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventMission_2.ogg"},{"description":"CH0274_EventMission_Day_End","category":"event","text":"辛苦了，老师。为努力的老师，送上奖励……开、开玩笑的。","text_original":"お疲れ様でした、先生。頑張った先生にご、ご褒美を…な、なんちゃって。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventMission_Day_End.ogg"},{"description":"CH0274_EventMission_Get_1","category":"event","text":"好的，这边确认完毕了。","text_original":"はい、こちら確認いたしました。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventMission_Get_1.ogg"},{"description":"CH0274_EventMission_Get_2","category":"event","text":"嗯，做得真好。","text_original":"はい、よくできました。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventMission_Get_2.ogg"},{"description":"CH0274_EventMission_Login_1","category":"event","text":"我已经整理好了老师的工作。","text_original":"先生の業務をまとめておきました。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventMission_Login_1.ogg"},{"description":"CH0274_EventMission_Login_2","category":"event","text":"您来了啊，老师。","text_original":"いらっしゃったのですね、先生。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_EventMission_Login_2.ogg"},{"description":"CH0274_ExSkill_1","category":"battle","text":"我会一直守望着你……诶，诶？","text_original":"いつでも見守っておりますので……あ、あれ！？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_ExSkill_1.ogg"},{"description":"CH0274_ExSkill_2","category":"battle","text":"来，看向这边……诶！？","text_original":"さあ、こちらへ……ふえっ！？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_ExSkill_2.ogg"},{"description":"CH0274_ExSkill_3","category":"battle","text":"呵……呵呵……诶，欸！？","text_original":"ふふっ……うふふっ…………え、ええっ！？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_ExSkill_3.ogg"},{"description":"CH0274_ExSkill_Level_1","category":"battle","text":"为，为什么！？怎么会这样……？","text_original":"な、何故！？どうしてですか……？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_ExSkill_Level_1.ogg"},{"description":"CH0274_ExSkill_Level_2","category":"battle","text":"到底什么地方搞错了……？","text_original":"なにか間違えてしまったのでしょうか……？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_ExSkill_Level_2.ogg"},{"description":"CH0274_ExSkill_Level_3","category":"battle","text":"怎么会变成这样……。","text_original":"こんな事になるだなんて……。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_ExSkill_Level_3.ogg"},{"description":"CH0274_ExWeapon_Get","category":"growup","text":"这是，给我的吗……？没有，不管穿着怎样的衣服，我就是我。您说得很对。真是受宠若惊，衷心感谢您，老师。","text_original":"私に、それを……？いえ、どのような格好でも私は私。仰るとおりですね。謹んで頂戴いたします。ありがとうございます、先生。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_ExWeapon_Get.ogg"},{"description":"CH0274_Formation_In_1","category":"formation","text":"时候到了。","text_original":"時が来たのですね。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Formation_In_1.ogg"},{"description":"CH0274_Formation_In_2","category":"formation","text":"上吧。","text_original":"参りましょう。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Formation_In_2.ogg"},{"description":"CH0274_Formation_Select","category":"formation","text":"敬请期待吧。……啊……演、演出……我是说在说演出的事……。","text_original":"期待していてくださいね。……あっ……こ、公演の……話です……。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Formation_Select.ogg"},{"description":"CH0274_Gachaget","category":"growup","text":"呵呵，吓到您了吗？如何……是不是与之前的我，不太一样了？","text_original":"ふふっ、驚きましたか？いかがでしょう……これまでの私とは、違うのですよ？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Gachaget.ogg"},{"description":"CH0274_Growup_1","category":"growup","text":"我明明应该时刻警醒自己……但在老师身边时，却总是不自觉地放松下来。","text_original":"自身を戒めなければならないのに……先生といると、つい気が緩んでしまうのです。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Growup_1.ogg"},{"description":"CH0274_Growup_2","category":"growup","text":"非常感谢，老师。这份恩情……我真不知该何以为报。","text_original":"感謝いたします、先生。このご恩……どのようにお返ししていけば良いのでしょう。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Growup_2.ogg"},{"description":"CH0274_Growup_3","category":"growup","text":"我感觉充满了力量。不过……这种说可能会引起误会呢。","text_original":"力が溢れてくるような気がします。その……この言い方は語弊を生むかもしれませんが。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Growup_3.ogg"},{"description":"CH0274_Growup_4","category":"growup","text":"虽然我每天都在努力精进，但……偶尔像这样得到老师的帮助，感觉也不错呢。","text_original":"日々、精進していくものではありますが……たまにはこのようにお力添えいただくのも良いものですね。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Growup_4.ogg"},{"description":"CH0274_Lobby_1","category":"lobby","text":"虽说人生无常，但真没想到有一天我还会穿上这样的衣服……","text_original":"様々な出来事があるものですが、まさかこのような服に袖を通すことになるとは……","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Lobby_1.ogg"},{"description":"CH0274_Lobby_2","category":"lobby","text":"最近，每次见到老师时，我好像都是这副打扮。","text_original":"最近、先生とお会いする時は、いつもこの格好な気がしております。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Lobby_2.ogg"},{"description":"CH0274_Lobby_3","category":"lobby","text":"那个……如果老师不介意的话……以后……也一直这样见面行吗……？","text_original":"その……先生がよろしければ……これからも……こうしてお会いできれば……","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Lobby_3.ogg"},{"description":"CH0274_Lobby_4","category":"lobby","text":"这就是歌姬吗……？","text_original":"これが歌姫……なのでしょうか？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Lobby_4.ogg"},{"description":"CH0274_Lobby_5","category":"lobby","text":"那个……请，请问您要签名吗？","text_original":"その……さ、サインなどいかがでしょう？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Lobby_5.ogg"},{"description":"CH0274_LogIn_1","category":"lobby","text":"欢迎回来，老师。怎，怎样？这身合适吗……？","text_original":"おかえりなさいませ、先生。い、いかがでしょう？似合っていますか……？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_LogIn_1.ogg"},{"description":"CH0274_LogIn_2","category":"lobby","text":"我正等着您呢，老师。愿今天您能有所收获。","text_original":"お待ちしておりました、先生。本日が実りあるものでありますよう。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_LogIn_2.ogg"},{"description":"CH0274_MemorialLobby_1_1","category":"lobby","text":"这，这是……！？","text_original":"こ、これは……！？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_1_1.ogg"},{"description":"CH0274_MemorialLobby_1_2","category":"lobby","text":"到底是，怎么回事……！？","text_original":"い、一体何ですか……！？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_1_2.ogg"},{"description":"CH0274_MemorialLobby_2_1","category":"lobby","text":"我的……海报？","text_original":"私の……ポスター？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_2_1.ogg"},{"description":"CH0274_MemorialLobby_2_2","category":"lobby","text":"不，不是……这个看一眼就知道了……！","text_original":"い、いえ……それは見れば分かるのですが……！","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_2_2.ogg"},{"description":"CH0274_MemorialLobby_3_1","category":"lobby","text":"修女会的大家，和老师……？","text_original":"シスターの皆様と、先生が……？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_3_1.ogg"},{"description":"CH0274_MemorialLobby_3_2","category":"lobby","text":"我，我该说些什么才好……。","text_original":"な……なんと申し上げればよいのでしょう……。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_3_2.ogg"},{"description":"CH0274_MemorialLobby_4_1","category":"lobby","text":"那个……没有，抱歉。我没有责怪您的意思。","text_original":"その……いえ、申し訳ございません。責めているわけではなくて……","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_4_1.ogg"},{"description":"CH0274_MemorialLobby_4_2","category":"lobby","text":"只是我的话很难用言语表达……","text_original":"言葉にするのが難しいだけで……","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_4_2.ogg"},{"description":"CH0274_MemorialLobby_5_1","category":"lobby","text":"不过……有一点我可以清楚地说出口。","text_original":"でも、そうですね……これだけはハッキリと伝えられます。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_5_1.ogg"},{"description":"CH0274_MemorialLobby_5_2","category":"lobby","text":"我真的……打从心底里觉得","text_original":"本当に……心の底から","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_5_2.ogg"},{"description":"CH0274_MemorialLobby_5_3","category":"lobby","text":"非常、非常的开心。","text_original":"とても、嬉しく思っております。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_MemorialLobby_5_3.ogg"},{"description":"CH0274_Relationship_Up_1","category":"growup","text":"那个……要是老师不介意的话，我们一起合唱……如何？","text_original":"その……もし先生がよろしければデュエットなど……いかがでしょう？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Relationship_Up_1.ogg"},{"description":"CH0274_Relationship_Up_2","category":"growup","text":"究竟该怎样表达才能不让大家误解呢……？","text_original":"どのように伝えれば皆様に誤解を与えずに済むのでしょう……？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Relationship_Up_2.ogg"},{"description":"CH0274_Relationship_Up_3","category":"growup","text":"这份感情实在难以言说……但再这样下去可不行……","text_original":"この感情の説明が難しく……このままではいけないと思っているのですが……。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Relationship_Up_3.ogg"},{"description":"CH0274_Relationship_Up_4","category":"growup","text":"让我为老师您祈祷吧。……不，应该说“为老师您歌唱”才对吧？","text_original":"先生のために祈りましょう。……「歌いましょう」が正しいのでしょうか？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Relationship_Up_4.ogg"},{"description":"CH0274_Season_Birthday","category":"lobby","text":"我的生日……您还记得啊。呵呵，您开口时我就音乐感觉到了。我随时都能为您献上歌声哦。","text_original":"私の誕生日……覚えていてくださったのですね。ふふっ、お声がけくださった時からなんとなくそんな気がしておりました。いつでも歌う準備はできておりますよ。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Season_Birthday.ogg"},{"description":"CH0274_Season_Birthday_Player","category":"lobby","text":"生日快乐，老师。为了庆祝您的生日，今天我特意穿了这身衣服来。","text_original":"お誕生日おめでとうございます、先生。お祝いのためにこの衣装で馳せ参じました。ええ、先生のために。一曲捧げさせてください。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Season_Birthday_Player.ogg"},{"description":"CH0274_Season_Halloween","category":"lobby","text":"虽然万圣节其实并不是扮装的节日……呵呵，不过若是老师想试试，我也不介意。要不要，让我来给您恶作剧一下？","text_original":"ハロウィーンは仮装の日ではありませんが……ふふ、でも先生がやってみたいのでしたら構いません。いたずら、して差し上げましょうか？","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Season_Halloween.ogg"},{"description":"CH0274_Season_NewYear","category":"lobby","text":"新年快乐，老师。今年我也会为您献上歌声。","text_original":"新年あけましておめでとうございます、先生。今年も先生に歌を捧げましょう。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Season_NewYear.ogg"},{"description":"CH0274_Season_Xmas","category":"lobby","text":"老师，要一起演唱圣歌吗？呵呵，我就是为此而这身衣服来的。","text_original":"先生、共に聖歌を捧げませんか？ふふ、そのための衣装ですから。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Season_Xmas.ogg"},{"description":"CH0274_Tactic_Defeat_1","category":"battle","text":"咕，练习不足吗……","text_original":"くっ、練習が不足していたのでしょうか......","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Tactic_Defeat_1.ogg"},{"description":"CH0274_Tactic_Defeat_2","category":"battle","text":"非常抱歉。","text_original":"申し訳ございません、","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Tactic_Defeat_2.ogg"},{"description":"CH0274_Tactic_In_1","category":"battle","text":"不过这种程度，不成问题。","text_original":"この程度であれば造作もないこと。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Tactic_In_1.ogg"},{"description":"CH0274_Tactic_In_2","category":"battle","text":"看来有很多客人到场呢。……啊，我是说演出的事。","text_original":"お客様が多くいらっしゃっていますね。……ライブの話です。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Tactic_In_2.ogg"},{"description":"CH0274_Tactic_Victory_1","category":"battle","text":"呵呵……真是轻而易举呢。","text_original":"ふふっ……造作もなかったですね。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Tactic_Victory_1.ogg"},{"description":"CH0274_Tactic_Victory_2","category":"battle","text":"真是一场愉快的演出。真希望能再来一次。","text_original":"楽しい公演でした。是非またやりたいものです。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Tactic_Victory_2.ogg"},{"description":"CH0274_Title","category":"lobby","text":"蔚蓝档案。","text_original":"ブルーアーカイブ。","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/jp/CH0274_Title.ogg"}],"voice_cn":[],"voice_kr":[{"description":"ch0274_battle_buffed_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/kr/ch0274_battle_buffed_1.ogg"},{"description":"ch0274_battle_buffself_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/kr/ch0274_battle_buffself_1.ogg"},{"description":"ch0274_battle_covered_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/kr/ch0274_battle_covered_1.ogg"},{"description":"ch0274_battle_damage_1","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/kr/ch0274_battle_damage_1.ogg"},{"description":"ch0274_battle_damage_2","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%BD%8F%20%E6%A8%B1%E5%AD%90/%E5%81%B6%E5%83%8F/kr/ch0274_battle_damage_2.ogg"},{"description":"ch0274_battle_damage_3","category":"battle","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E6%AD%8C%E4%