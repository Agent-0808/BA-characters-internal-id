%A6%99/JpA0ObQY3R0r9iNVEOdBAo2iHSti2A5U.ogg"},{"description":"Fuuka_Battle_TSA_1.ogg","category":"battle","text":"大変お待たせしました！給食部の配送者が到着しましたよ！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/OUFWDq5p87Or4pG0o6LJwZeqTX43FftO.ogg"},{"description":"Fuuka_Battle_TSA_2.ogg","category":"battle","text":"お待たせしました！給食部の到着です！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/6c19piYONdYQRGlV2hrEJZp71tL5DkUu.ogg"},{"description":"Fuuka_Cafe_Act_1.ogg","category":"cafe","text":"スーパーに寄らなきゃかも…。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/6OVzqdvcu0rar1logYsx8bIBtQSNKhPV.ogg"},{"description":"Fuuka_Cafe_Act_2.ogg","category":"cafe","text":"料理を始めましょうか。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/8Ds54hiQdZ1kWv4iesKZvbRvk4KDJvG4.ogg"},{"description":"Fuuka_Cafe_monolog_1.ogg","category":"cafe","text":"ここでも料理ができるかな？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/oYaXQ0notOoOgcfZO6CvbMZOeuoWDkDH.ogg"},{"description":"Fuuka_Cafe_monolog_2.ogg","category":"cafe","text":"今日の夕食は何にしよう…。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/6kdrMR55omyWvIsncvH20Ih5yFA7T56p.ogg"},{"description":"Fuuka_Cafe_monolog_3.ogg","category":"cafe","text":"このままじゃ、食材が足りないかも。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/xATQdkXRuTsqJlHLgYdRqLEBqGNnvjxV.ogg"},{"description":"Fuuka_CommonSkill.ogg","category":"battle","text":"食事の効果ですね！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/dJfX8KazhFeA0qJZ2TKTCjoMsZG7ubhw.ogg"},{"description":"Fuuka_ExSkill_1.ogg","category":"battle","text":"よーし！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/2xJH5hc1AfIihWKCNIljePQgMQ0dXgGQ.ogg"},{"description":"Fuuka_ExSkill_2.ogg","category":"battle","text":"うんっ！完璧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/9vtD6OkzjPrdDz1YVe0CUQCQ7MDpyUst.ogg"},{"description":"Fuuka_ExSkill_3.ogg","category":"battle","text":"これは…すてきな出来！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/llAGUwwUbgcTE8n2mRhhy0wx57M3HlvK.ogg"},{"description":"Fuuka_ExSkill_Level_1.ogg","category":"battle","text":"栄養満点の料理です！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/PXmmCC13igND8RHJixkWkTBF5DctT7Wl.ogg"},{"description":"Fuuka_ExSkill_Level_2.ogg","category":"battle","text":"食事の時間ですよ！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/E8Mhn3OrdCHE1V91IHfETrB3aenEZsno.ogg"},{"description":"Fuuka_ExSkill_Level_3.ogg","category":"battle","text":"おいしく召し上がれ。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/RnNyRE639Ao2OyaHMRO23kdA9eOprU5B.ogg"},{"description":"Fuuka_ExWeapon_Get.ogg","category":"growup","text":"あはは……こういった支援には慣れていませんが、先生のお役に立てるよう、最善を尽くします。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/27mP6t4YLexAphYavyczddpJoXO9LH5S.ogg"},{"description":"Fuuka_Formation_In_1.ogg","category":"formation","text":"はい！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/pVwokVLrz1JqfM826GrIpFBIqZzgIyb8.ogg"},{"description":"Fuuka_Formation_In_2.ogg","category":"formation","text":"準備完了です","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/33om735JbSYaCNgaHO0uF2zuJzrVGpHs.ogg"},{"description":"Fuuka_Gachaget.ogg","category":"growup","text":"給食部のフウカです。食べたいものがあったら、いつでも仰ってください。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/ehttPSSSsIFrzd7dxD99zQmKx7XjBKGv.ogg"},{"description":"Fuuka_Growup_1.ogg","category":"growup","text":"ありがとうございます、先生。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/ExuFfQZ8D2hQO6nKztTe0A2IHdfqNELo.ogg"},{"description":"Fuuka_Growup_2.ogg","category":"growup","text":"料理の実力もさらに上がったのでしょうか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/nuBF1moaOAgiuDDEZLqPgBR7kSnnWRYU.ogg"},{"description":"Fuuka_Growup_3.ogg","category":"growup","text":"これでもう少しお役に立てるように。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/0YDAx4IhPOywIN2XUWKcYE0LgnZ9uBjn.ogg"},{"description":"Fuuka_Growup_4.ogg","category":"growup","text":"え？私でいいのですか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/DaACmI2dLJAfa74IUBC6G5DWahpZiBpx.ogg"},{"description":"Fuuka_Lobby_1.ogg","category":"lobby","text":"ご飯はちゃんと食べてますか？何か作りましょうか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/Ttz7SDB6bGX58TLtNiAqkuHzGyv6EuED.ogg"},{"description":"Fuuka_Lobby_2.ogg","category":"lobby","text":"皆のために料理を作るのは大変ですが、大丈夫です。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/k3O5tL3gzrKUNwPH4C6ENO6Z06MBtRQK.ogg"},{"description":"Fuuka_Lobby_3.ogg","category":"lobby","text":"あはは…。心配してくださるのですか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/d1duuj7m5nCYQNbp8IAUQ1Ai2rNyFhOU.ogg"},{"description":"Fuuka_Lobby_4.ogg","category":"lobby","text":"好きな食べ物、気になります。 ん？何でか、ですって？ 秘密です！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/kjsNxFC6WVesu7reTEUwHL71NBflR7fC.ogg"},{"description":"Fuuka_Lobby_5.ogg","category":"lobby","text":"うーん…,先生がもっと元気になるような料理、何が良いかな…。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/I6kAmEnNX6k3Qjhj9VdOGb3Estp6MSLU.ogg"},{"description":"Fuuka_LogIn_1.ogg","category":"lobby","text":"お疲れ様です！温かい食事をご用意しましたけど、今召し上がりますか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/MYPGt7XLXpKDKqYWqwsQ1PaNwup1Vhof.ogg"},{"description":"Fuuka_LogIn_2.ogg","category":"lobby","text":"先生、卵は半熟のままがいいですか？サニーサイドアップ？それとも卵焼き？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/cG9JTLCvkKKplI6hIy1PrTjHgWICUVhi.ogg"},{"description":"Fuuka_MemorialLobby_1.ogg","category":"lobby","text":"こうなっていると思っていました…。またインスタントばかり食べてましたね？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/SOIuVKqq19nGJcTXzwiELCFIwzxuWPok.ogg"},{"description":"Fuuka_MemorialLobby_2.ogg","category":"lobby","text":"ダメですよ、食事はちゃんと取らないと。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/a4g21WI5562Pls7nHxTGEUqbkCM7dmh6.ogg"},{"description":"Fuuka_MemorialLobby_3.ogg","category":"lobby","text":"私がすぐ作りますから、ちょっと待っててください。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/4Ea5jT3Jv7bXp0PMFNgn1MnGo3VUzHjq.ogg"},{"description":"Fuuka_MemorialLobby_4.ogg","category":"lobby","text":"もう、健康に気を付けないのは先生の悪い癖ですよ。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/XSh2yAR7VjPCMAy5fG16va5mTj3rTbew.ogg"},{"description":"Fuuka_MemorialLobby_5_1.ogg","category":"lobby","text":"はい？ま、毎日私の作った料理が食べたい、ですか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/iuteRpX0CkqFqul3hb86kmTHNUR2HYHt.ogg"},{"description":"Fuuka_MemorialLobby_5_2.ogg","category":"lobby","text":"あ、あはは… せ、先生さえよろしければ…。 もちろん、私は構わないのですが…。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/imyuosoVIyCgcDain7FMvxfjbwUJbDcP.ogg"},{"description":"Fuuka_Relationship_Up_1.ogg","category":"growup","text":"先生に美味しい料理を作って差し上げたいです。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/ci4lu0dlsNJq3KMQRahiJ6PyF8ekniVh.ogg"},{"description":"Fuuka_Relationship_Up_2.ogg","category":"growup","text":"食事はちゃんと摂れてますか、先生？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/L4X5YcP44AYF01PZhyPg9hU71wKES8ds.ogg"},{"description":"Fuuka_Relationship_Up_3.ogg","category":"growup","text":"どんな料理がお好きなのか、気になります。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/jlluClQrAdAeWYuNJjM4OT4IGZJsv0Ic.ogg"},{"description":"Fuuka_Relationship_Up_4.ogg","category":"growup","text":"先生に、その…朝ごはんを作ってさしあげたいのですが…","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/jtRYDIoLqXMLLnqnoytOEvFpd2nvfr3H.ogg"},{"description":"Fuuka_Season_Birthday.ogg","category":"lobby","text":"あれ…。私の誕生日ですか？ あ、あはは…。いつも他の方のお誕生日ばかり気にしていたので…。 …嬉しいです。ありがとうございます。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/NYnwy4gY85b6eLlJTlcFXhaD9xD2taLX.ogg"},{"description":"Fuuka_Season_Birthday_Player.ogg","category":"lobby","text":"先生。お誕生日おめでとうございます。 今日みたいな日にはきっと、すごく特別なものを召し上がるかと思うのですが…。 えっと、よ…よろしければ、私がお誕生日のお料理を作ってもいいでしょうか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/8rxFnkeYUItjLQ8f4Bo40ormIpp3ukjI.ogg"},{"description":"Fuuka_Season_Halloween.ogg","category":"lobby","text":"カボチャのスープとか、カボチャパイとか、カボチャのグラタンとか、 作れそうなものは全部作ってみようかと思いまして。 ハロウィーンですからね。先生はどんなのが好きですか？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/wcn2GbSvws1KXinGbC7mmjeXp0WkejvT.ogg"},{"description":"Fuuka_Season_NewYear.ogg","category":"lobby","text":"新しい一年が始まりますね！ お雑煮を作ろうかと思うのですが、いかがでしょう？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/iJEP9bTaU40YsZi62DIB4ZlRM9GM5lhs.ogg"},{"description":"Fuuka_Season_Xmas.ogg","category":"lobby","text":"クリスマス…。 特別な夕食を作ろうかと思っているのですが…。 も、もちろん、先生がよろしければ！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/mpNozmISpstVl7BVuOPoHXvrKMVxL5e4.ogg"}],"voice_cn":[{"description":"fuuka_battle_in_1","category":"battle","text":"供餐部，开始提供支援。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/lGDcCUKDWuJqu5NzpxQsjpqKpoCAtv4b.ogg"},{"description":"fuuka_battle_in_2","category":"battle","text":"我准备好了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/hBUcXG38X07FDdALLowXNrr8VHcY3dDr.ogg"},{"description":"fuuka_battle_tsa_1","category":"battle","text":"非常感谢您的耐心等待，后勤部的送货车已经到了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/Ry8VzxJAzBG6eSAmgzdJh3DuYgvh4X93.ogg"},{"description":"fuuka_battle_tsa_2","category":"battle","text":"让各位久等了，后勤部来了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/1bDbOP2YXVxYBmhtATWujEKwNgO5UCF5.ogg"},{"description":"fuuka_cafe_act_1","category":"cafe","text":"说不定还得去趟超市……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/0i02Wk96Y0Pu0BG9tlg9Ur4uicYPufMa.ogg"},{"description":"fuuka_cafe_act_2","category":"cafe","text":"那就开始做饭吧。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/bXv7jDvl5g2gG12OVYCkevIOV2fqFFpf.ogg"},{"description":"fuuka_cafe_monolog_1","category":"cafe","text":"这个地方能不能做饭呀？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/pC5rkCFr7WQPyryawHSZ5FYoDbRMwQXX.ogg"},{"description":"fuuka_cafe_monolog_2","category":"cafe","text":"今天的晚饭做什么好呢……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/pomFEy7Mpgtwt64OIvhImjvpMWXagOi3.ogg"},{"description":"fuuka_cafe_monolog_3","category":"cafe","text":"这样下去，食材就要不够了啊。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/VFaoyYh4qkvhYprcsZZBj1uKDr1HgxoH.ogg"},{"description":"fuuka_commonskill","category":"battle","text":"这就是用餐的效果哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/NGCuCeSnE4zBfw4qAbrK2ZtrsbhfExG1.ogg"},{"description":"fuuka_exskill_1","category":"battle","text":"不错。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/YJoC16v79azJdKrQttsgGAMUNU9IJjti.ogg"},{"description":"fuuka_exskill_2","category":"battle","text":"嗯，完美！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/bjGFy7XsPdSwFidBL2Ax638NYyTh8DZf.ogg"},{"description":"fuuka_exskill_3","category":"battle","text":"味道很棒！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/4s8o0T0veJd5O6zoQW2FcnSSceOjDaVs.ogg"},{"description":"fuuka_exskill_level_1","category":"battle","text":"这道菜营养丰富哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/LDUQIAA1mo8ntO35wp18kdmXgwjxitY0.ogg"},{"description":"fuuka_exskill_level_2","category":"battle","text":"该吃饭了哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/KGh0TC2Iirb7f2YFgi5mMQKYZkIzjCBR.ogg"},{"description":"fuuka_exskill_level_3","category":"battle","text":"尽情享用吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/XbdMs7q7vS9Vssvof6FpMlbBJ1PveLrn.ogg"},{"description":"fuuka_exweapon_get","category":"growup","text":"啊哈哈……我还真不习惯被这样支持呢，我会尽我所能帮助老师的。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/bjYmu3AB4svlLIRzFiUPxGR4InISYqW8.ogg"},{"description":"fuuka_formation_in_1","category":"formation","text":"到。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/ANt7I0fTSQZ64xUYwQZC7Op9ys8vvdEl.ogg"},{"description":"fuuka_formation_in_2","category":"formation","text":"准备完毕！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/VQaKqXUQAuCKigaVT8EcBq0Q6hpr7aqN.ogg"},{"description":"fuuka_gachaget","category":"growup","text":"我是供餐部的风香。有什么想吃的东西，请随时吩咐。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/dfcNdPT1nojco51kWFHgmsSwTtuzs0gu.ogg"},{"description":"fuuka_growup_1","category":"growup","text":"老师，非常感谢您！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/XxxJakMhLMzjwNHSPMEogSpPB4tvdkcJ.ogg"},{"description":"fuuka_growup_2","category":"growup","text":"不知道烹饪水平是不是也提高了呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/G3dElNKyBSq8i7vzUGGe1557d8BNPbWa.ogg"},{"description":"fuuka_growup_3","category":"growup","text":"希望，能再多给您帮上一点忙。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/sTSE4k2Go0KdhcPFA4dGQT2BjE59QASm.ogg"},{"description":"fuuka_growup_4","category":"growup","text":"啊，把这些都给我，这样合适吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/qW34ZmJExOB7cQhaXq09m4zHR1fMHXGq.ogg"},{"description":"fuuka_lobby_1","category":"lobby","text":"您有好好按时吃饭吗？要不要给您做点什么？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/4VlU6lewR2DRaVdNbHXZTjMu3Ls2tFQH.ogg"},{"description":"fuuka_lobby_2","category":"lobby","text":"给大家做饭是很辛苦，不过没关系。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/KYUx2VO43sjNpu7oz6Hwm1yvwsJxKEHc.ogg"},{"description":"fuuka_lobby_3","category":"lobby","text":"啊哈哈哈……您这是在担心我吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/2XLz6m9ft4M5lOTzQAK9IpVd3Nw2v2VD.ogg"},{"description":"fuuka_lobby_4","category":"lobby","text":"我想知道您到底喜欢吃什么样的食物。 嗯？为什么想知道？ 诶嘿，这是秘密哦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/C6gbYtL1pURtTzOj5PCvbSTIluTQWNz1.ogg"},{"description":"fuuka_lobby_5","category":"lobby","text":"嗯……有没有什么好吃的能给老师补补身子呢……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/0DD2m2zTwZW1Poxf2XF8Dm2sQoojmK2c.ogg"},{"description":"fuuka_login_1","category":"lobby","text":"辛苦了！我为您准备了热气腾腾的饭菜，您要现在就吃吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/QQL66qnHOmwjakRiZ6jfnAFq6EolQrns.ogg"},{"description":"fuuka_login_2","category":"lobby","text":"老师，您喜欢这样的半熟蛋呢？还是太阳蛋？或者说玉子烧？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/IQMKai84gxdH3EjAIlDFUnBZ0MpiocKG.ogg"},{"description":"fuuka_memoriallobby_1","category":"lobby","text":"我就知道会变成这个样子……您是不是又整天吃方便食品了呀？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/C31lDSL9juW8KOm0GtsnGyyaGwg9iFnv.ogg"},{"description":"fuuka_memoriallobby_2","category":"lobby","text":"唉，这样可不行，饭一定要按时好好吃哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/jhuX2jsiLV1fQiEqvsShXSrO3QlwGjsi.ogg"},{"description":"fuuka_memoriallobby_3","category":"lobby","text":"我这就去给您好好做顿饭，请您在这里稍微等一下。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/q0eXCelrQBW9l7U1mzNOSYdoFDbbRSOe.ogg"},{"description":"fuuka_memoriallobby_4","category":"lobby","text":"哎呀，老师，您一直这样不注意自己的健康可是不好的哦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/bIit1zd3b7YnJ4agHc5ciybwXXXqkLBn.ogg"},{"description":"fuuka_memoriallobby_5_1","category":"lobby","text":"啊？您，您说您想每天都能够吃上……我做的饭？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/RKWvz0LjPFh9Di50HybmHLofqbrUAljv.ogg"},{"description":"fuuka_memoriallobby_5_2","category":"lobby","text":"啊，啊哈哈……只，只要老师愿意的话……我，我当然完全不会介意的啦……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/HqLucUcdlYxmBAGYCRJlgoHbVLiuyQEF.ogg"},{"description":"fuuka_relationship_up_1","category":"growup","text":"我想为老师做些美味的料理！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/LZA1mKB6P0GNDRiGvv6ndhw2Zgb9dchA.ogg"},{"description":"fuuka_relationship_up_2","category":"growup","text":"老师，您有没有好好吃饭呀？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/8xxEgXS7uuSP7iwqZyTOGKWAqP5HPCPI.ogg"},{"description":"fuuka_relationship_up_3","category":"growup","text":"我想知道，老师最喜欢吃什么？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/bfsl4SwTKrev0I8ysEP45C5WG0GfrocD.ogg"},{"description":"fuuka_relationship_up_4","category":"growup","text":"我在想。可不可以……那个，给老师做早饭。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/FtnROTTNKyQDjI3rfBQQ6ufrbhACl85Z.ogg"},{"description":"fuuka_season_birthday","category":"lobby","text":"咦……我的生日？ 啊，啊哈哈……我平时净是去注意别人的生日了…… ……我很开心。非常感谢您。","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/keQJrts4fxScNeCVNkgTDKvzdKl6FHlm.ogg"},{"description":"fuuka_season_birthday_player","category":"lobby","text":"老师。祝您生日快乐。 我想，您在今天这样的日子，一定想吃一顿不同于往日的大餐…… 嗯，如……如果不介意的话，可以让我为您准备生日餐吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/aJ6BNUSH0VxKIxj3864ipVfHPAub6xEP.ogg"},{"description":"fuuka_season_halloween","category":"lobby","text":"南瓜汤呀，南瓜派呀，南瓜焗菜呀， 能做的东西我全都想试着做一做。 因为今天可是万圣节哦。老师，您喜欢什么样的饭菜呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/4UJS5Uk4di9RowxJjCbZlKZzguBSBi27.ogg"},{"description":"fuuka_season_newyear","category":"lobby","text":"新的一年开始了哦！ 我在想要不要做些年糕汤，您意下如何呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/TNmBiuBN2PgsRknOT54xnp7ydyPfWNa6.ogg"},{"description":"fuuka_season_xmas","category":"lobby","text":"圣诞节…… 我在想要不要做一顿特别的晚餐…… 当，当然，前提是老师觉得可以的话！","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/b3P2DxVqS8VF2KLLjpYzVEXcqzOqhwMO.ogg"},{"description":"fuuka_season_chinesenewyear","category":"lobby","text":"我准备了一桌年夜饭……不嫌弃的话，老师，来尝尝吧？","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/7sQAxo4K6Scd0lbslbJIgKBUd2H9tHYg.ogg"},{"description":"fuuka_season_midautumn","category":"lobby","text":"歌赫娜的大家，会喜欢我做的月饼吗？哎，您，您说您喜欢？真，真是太好了……","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/sH2JeVf9ZSPJJKA1i3RBYSSqD8DbwoDw.ogg"},{"description":"fuuka_title","category":"lobby","text":"Blue Archive","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/cKDfNd85ipIRtvkjTTtnNY4iVyELHAVg.ogg"}],"voice_kr":[{"description":"Fuuka_Title","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/original/Fuuka_Title.ogg"},{"description":"fuuka_cafe_act_1","category":"cafe","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E7%88%B1%E6%B8%85%20%E6%9E%AB%E9%A6%99/original/fuuka_cafe_act_1.ogg"},{"description":"fuuka_cafe_act_2","category":"cafe","text":"","text_original":"","file":"