kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/THbhSisUDgaduEHPwXL7gSj9Jn2VAYmx.ogg"},{"description":"moe_growup_2","category":"growup","text":"还不够，还能继续！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/FuxvghTPdGRoOZQP8qilSdbVWPyBe2II.ogg"},{"description":"moe_growup_3","category":"growup","text":"老师，给了我这么多，肚子都撑圆了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/yeX5UT1fN54yBGguKcDGniTyrJDwpMVA.ogg"},{"description":"moe_growup_4","category":"growup","text":"好兴奋啊，不错，感觉有意思起来了！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/LBX9M5QNUT4XFBJIn3gGRCyJ1risb89v.ogg"},{"description":"moe_lobby_1","category":"lobby","text":"差不多要补充RABBIT小队的备用库存了……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/2IpKh1BClOKFpUd7jNfj9OqOcztNQYyI.ogg"},{"description":"moe_lobby_2","category":"lobby","text":"啊唔……糖分补给可是很重要的，这个我不能让步！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/OUDSBORXFJCNjGJTyHqLwUtyKX8oeyGT.ogg"},{"description":"moe_lobby_3","category":"lobby","text":"啊……好想吃以前前辈给我做过的稻荷寿司啊。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/rC0jMvX1uWOxfoZuo2RDEUiFvpGxTMll.ogg"},{"description":"moe_lobby_4","category":"lobby","text":"真是的，为什么糖果不算最基本的补给品呢？ 对于我们通信员来说，糖分就是燃料啊！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/yPArxp6HNqUKgYrH1k68amiH458L6O4q.ogg"},{"description":"moe_lobby_5","category":"lobby","text":"工作看起来很忙嘛，需要我帮把手吗？ 哎呀，就交给我试试吧。嘻嘻嘻……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/Y5M57xMr9KSz2jqujpNHwKJw6LsNTFzO.ogg"},{"description":"moe_login_1","category":"lobby","text":"啊，老师欢迎回来。你今天也是老样子啊，还是那么忙，嘻嘻嘻……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/iSdboHdBgbZ89w00UpiXudwebvfTjgVG.ogg"},{"description":"moe_login_2","category":"lobby","text":"噢，这不是老师吗？最近一直很忙的样子嘛。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/R5hSaEQwt7Vp4WTijpKNv53qJLNoh4tc.ogg"},{"description":"moe_memoriallobby_1_1","category":"lobby","text":"老师啊……这个世界上有着各种各样的禁忌。比如不能按下的按钮，比如不能越过的那条线……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/pU54W7lu86XKkOiICbi01PiVqOa0WDKR.ogg"},{"description":"moe_memoriallobby_1_2","category":"lobby","text":"在这些禁忌里，有些一旦被打破，就会导致毁灭，再也无法回头。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/n6dXcLiGhkJZYgwX32sQtPztKjnn2c1j.ogg"},{"description":"moe_memoriallobby_2_1","category":"lobby","text":"只要走错一步就会坠入深渊 。但如果，你能因此满足自己内心的欲望……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/nyz03jUk7XQGDU1LhtIo55KQx4cwkJPk.ogg"},{"description":"moe_memoriallobby_2_2","category":"lobby","text":"这种时候……老师会怎么做？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/ZostfrkqEK6S8z0yJvL2au7CdKFsqeBi.ogg"},{"description":"moe_memoriallobby_3","category":"lobby","text":"我也知道这个问题没什么意义。毕竟老师是个规矩人嘛。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/C647oXirsFUmnLKVPGDPbg03Vf71mK4L.ogg"},{"description":"moe_memoriallobby_4_1","category":"lobby","text":"可是我就不一样了，我可能会越过那条线。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/UmMJnxXK4QhD8xER6XN5Gs5nrt7VlJzU.ogg"},{"description":"moe_memoriallobby_4_2","category":"lobby","text":"因为迎来毁灭的那个瞬间，正是我证明自己的机会。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/G9gWqKY0oSjKPsLGufeJ2Y6lYADu7yEG.ogg"},{"description":"moe_memoriallobby_5_1","category":"lobby","text":"所以，老师……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/uW19EiNIZgGY8rbJYBYrDfIYMfgMn0yQ.ogg"},{"description":"moe_memoriallobby_5_2","category":"lobby","text":"你愿意……和我一起，越过那条线吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/SmZr2APll8XTeVWlbSuq1EpxbHlsaUbY.ogg"},{"description":"moe_relationship_up_1","category":"growup","text":"感觉老师一直在帮助我呢，欸嘿嘿~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/RozEYnizfcYXNBg5QFVKNouOgJwsFfuS.ogg"},{"description":"moe_relationship_up_2","category":"growup","text":"总觉得……好像要越界了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/G5R1hWKrNiBMcHY3sgzlA0s9R8uNculC.ogg"},{"description":"moe_relationship_up_3","category":"growup","text":"要吃糖吗？虽然我全都舔过了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/ZQgdjpjr5VZgXVer6hrMxTDGYYSdhKA3.ogg"},{"description":"moe_relationship_up_4","category":"growup","text":"只要和老师在一起，就算迎来华丽的毁灭也……呼嘿嘿~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/WGM1p2NPkLvDPY4gsWX6bv9EFiIa2nGA.ogg"},{"description":"moe_season_birthday","category":"lobby","text":"生日蛋糕？啊不用，给我一发盛大的烟花就好了…… 嗯，难得有机会，就找老师要一个超级华丽的……嘻嘻嘻。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/ruWFJZbDrl7aQ8XWkOfgT1iUuoBayHnI.ogg"},{"description":"moe_season_birthday_player","category":"lobby","text":"老师，生日快乐。那么…… 要来一发华丽的生日烟花吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/gQODD0mM4rDRwulxyjPY81BYpqzX0XLi.ogg"},{"description":"moe_season_chinesenewyear","category":"lobby","text":"咕嘻嘻……老师，既然新春到了，那想不想看一场灿烂的烟花秀呢~","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/jrv41JFiCZKSDC7oezQBVlDsZ7y8vrZg.ogg"},{"description":"moe_season_halloween","category":"lobby","text":"这个南瓜灯……要是给它撒上白磷粉，一定会燃烧得更漂亮吧…… 哈啊，哈啊……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/08poHPw3o0nxy8bJVe6luXXczdnrTdxs.ogg"},{"description":"moe_season_midautumn","category":"lobby","text":"飞到月亮上，再也回不来~？这也是一种自寻毁灭吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/ZCwB7xGywgJaaQdpG2zxP08d2hqwZ9JS.ogg"},{"description":"moe_season_newyear","category":"lobby","text":"听说山海经新年有放烟花除旧迎新的风俗…… 这可真是个好风俗呀……嘻嘻嘻。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/JRGAvd4SsuqtACqSbsBqMqrXsCMHwkhj.ogg"},{"description":"moe_season_xmas_1","category":"lobby","text":"今年圣诞节，我们RABBIT小队的队员要一起吃火鸡。 嗯？当然是在我们一直待的那个公园里吃呀。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/S0EOeFkJyMRdEzK6jrVWEpRUv7xytFmf.ogg"},{"description":"moe_season_xmas_2","category":"lobby","text":"嗯？消防安全法……？那是什么？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/pNjQNB0065kjopSarqtNI9MLQW1BA2nv.ogg"},{"description":"moe_title","category":"lobby","text":"Blue Archive","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/pywoJu9rAkjRNS2IxmC8jvQKTayOqxVU.ogg"},{"description":"moe_cafe_act_1","category":"cafe","text":"这里……是不是少了什么重要的发射按钮？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/BtBJ179I9HU92n6Hdg79MqaIfEYtveyv.ogg"},{"description":"moe_cafe_act_2","category":"cafe","text":"嘻嘻嘻……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/AalxyT38uCM7WtunLp9CAyUwPAyNQXdo.ogg"},{"description":"moe_cafe_monolog_1","category":"cafe","text":"要不要把这里当成新的据点呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/xzSYXiudn3UbmOCK2lLvvs2Rxakr8Zl6.ogg"}],"voice_kr":[{"description":"moe_growup_4","category":"growup","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/original/moe_growup_4.ogg"},{"description":"moe_lobby_1","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/original/moe_lobby_1.ogg"},{"description":"moe_lobby_2","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/original/moe_lobby_2.ogg"},{"description":"moe_lobby_3","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/original/moe_lobby_3.ogg"},{"description":"moe_lobby_4","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/original/moe_lobby_4.ogg"},{"description":"moe_lobby_5","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/original/moe_lobby_5.ogg"},{"description":"moe_login_1","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/original/moe_login_1.ogg"},{"description":"moe_login_2","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/original/moe_login_2.ogg"},{"description":"moe_memoriallobby_1_1","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98/original/moe_memoriallobby_1_1.ogg"},{"description":"moe_memoriallobby_1_2","category":"lobby","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%A3%8E%E4%BB%93%20%E8%90%8C%E7%BB%98