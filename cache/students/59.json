o.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Cafe_monolog_3.ogg"},{"description":"CH0189_Cafe_monolog_4","category":"cafe","text":"……要不打扫一下。","text_original":"……掃除でもしよっかな。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Cafe_monolog_4.ogg"},{"description":"CH0189_Cafe_monolog_5","category":"cafe","text":"嗯……好舒服啊。","text_original":"ふう……気持ち良い。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Cafe_monolog_5.ogg"},{"description":"CH0189_CommonSkill","category":"battle","text":"接招吧！","text_original":"受け取りなさい! ","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_CommonSkill.ogg"},{"description":"CH0189_EventLobby_1","category":"event","text":"嗯？怎么了？有什么活要干吗？","text_original":"ん？どうしたの？なにかやることある？","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_EventLobby_1.ogg"},{"description":"CH0189_EventLobby_2","category":"event","text":"老师……你在干什么。","text_original":"先生……何してんの。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_EventLobby_2.ogg"},{"description":"CH0189_EventLobby_3","category":"event","text":"你不会觉得那样很有趣吧？","text_original":"それ、面白いと思ってんの？ねぇ？","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_EventLobby_3.ogg"},{"description":"CH0189_EventLobby_4","category":"event","text":"别净做奇怪的事了，快做点正事去！快点！","text_original":"変なことばっかしてないでやることやって！早く！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_EventLobby_4.ogg"},{"description":"CH0189_EventLogin_1","category":"event","text":"快点老师！时间不多了哦，快点走吧！","text_original":"さあ、先生！時間なんて無いわよ！早く行きましょう！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_EventLogin_1.ogg"},{"description":"CH0189_EventLogin_2","category":"event","text":"啊，老师！这边这边！","text_original":"あ、先生！こっち、こっち！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_EventLogin_2.ogg"},{"description":"CH0189_ExSkill_1","category":"battle","text":"啊，真好玩，呜哇啊啊啊啊啊！","text_original":"あ、楽しっ、うっ、うわぁぁぁぁぁ! ","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_ExSkill_1.ogg"},{"description":"CH0189_ExSkill_2","category":"battle","text":"老师——！诶——？！","text_original":"先生ー！エー！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_ExSkill_2.ogg"},{"description":"CH0189_ExSkill_3","category":"battle","text":"出乎意料得还不错……呜哇啊啊啊！","text_original":"意外と悪くないかっ…うわぁぁぁぁぁ！ ","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_ExSkill_3.ogg"},{"description":"CH0189_ExSkill_Level_1","category":"battle","text":"我没抓住！小心！","text_original":"逃しちゃった！気をつけて！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_ExSkill_Level_1.ogg"},{"description":"CH0189_ExSkill_Level_2","category":"battle","text":"飞过来了！","text_original":"飛んでくわよ！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_ExSkill_Level_2.ogg"},{"description":"CH0189_ExSkill_Level_3","category":"battle","text":"快避开！","text_original":"避けて！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_ExSkill_Level_3.ogg"},{"description":"CH0189_ExWeapon_Get","category":"growup","text":"光顾着玩真的好吗……是，是老师说可以的啦，你可得负起责任！","text_original":"こんなに遊んでばっかで良いのかな……せ、先生が良いって言ったんだからね！ちゃんと責任とってよ！？","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_ExWeapon_Get.ogg"},{"description":"CH0189_Gachaget","category":"growup","text":"我要让这次成为「最棒的假期」！绝不会妥协！","text_original":"「最高の休暇」にするんだから！妥協はしないわよ！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Gachaget.ogg"},{"description":"CH0189_Growup_1","category":"growup","text":"那个……虽然光是玩也很好，但真的这样就行了吗？","text_original":"その…遊ぶのはいいんだけど、本当にこれでいいんだよね？","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Growup_1.ogg"},{"description":"CH0189_Growup_2","category":"growup","text":"太好了太好了！那我这次就不客气了哦！","text_original":"いいねいいねー！今回は遠慮しないんだからね！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Growup_2.ogg"},{"description":"CH0189_Growup_3","category":"growup","text":"果然老师也想来玩啊。就算你不说我也明白的！","text_original":"やっぱ先生も遊びたいんだよね。言わなくても分かってるって。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Growup_3.ogg"},{"description":"CH0189_Growup_4","category":"growup","text":"想办水枪比赛吗？明白了！我会全部搞定的！","text_original":"水鉄砲大会でも開くつもり？分かった！私が全部やっつけてあげる！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Growup_4.ogg"},{"description":"CH0189_Lobby_1","category":"lobby","text":"大海果然凉快啊！","text_original":"やっぱ海って涼しいわね！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Lobby_1.ogg"},{"description":"CH0189_Lobby_2","category":"lobby","text":"和大家一起来玩……真的好开心。","text_original":"みんなで遊びにこれて……すっごく楽しい。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Lobby_2.ogg"},{"description":"CH0189_Lobby_3","category":"lobby","text":"我要拼尽全力去玩，不会留下遗憾！","text_original":"全力で遊んだら後悔なんてないんだから！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Lobby_3.ogg"},{"description":"CH0189_Lobby_4","category":"lobby","text":"哈……好累……。不，不行！不能浪费休息的时间！","text_original":"はぁ……疲れた……だ、ダメ！休憩する時間がもったいない！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Lobby_4.ogg"},{"description":"CH0189_Lobby_5","category":"lobby","text":"老师……那个……这件泳装，怎么样？","text_original":"先生……その……この水着、どう思う？","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Lobby_5.ogg"},{"description":"CH0189_LogIn_1","category":"lobby","text":"欢迎，老师！这里很凉快哦！","text_original":"ようこそ、先生！ここは涼しいわね！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_LogIn_1.ogg"},{"description":"CH0189_LogIn_2","category":"lobby","text":"太慢了，老师！你要让我等多久啊？","text_original":"遅いよ、先生！どれだけ待たせる気なの？","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_LogIn_2.ogg"},{"description":"CH0189_MemorialLobby_1_1","category":"lobby","text":"这，这样可以了吧？快让我下去啦……","text_original":"こ、これでもう良くない？そろそろ降りようよ……","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_1_1.ogg"},{"description":"CH0189_MemorialLobby_1_2","category":"lobby","text":"倒也不是想放弃了……","text_original":"もうやめたいとか、そういうんじゃないんだけど……","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_1_2.ogg"},{"description":"CH0189_MemorialLobby_2_1","category":"lobby","text":"等、等下！！老师！你在干嘛！很晃的！","text_original":"ちょ、ちょっと！！先生！何すんのよ！揺れるでしょ！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_2_1.ogg"},{"description":"CH0189_MemorialLobby_2_2","category":"lobby","text":"这艘小艇很容易翻的！！快停下！","text_original":"このボート、ひっくり返りやすいんだから！！やめて！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_2_2.ogg"},{"description":"CH0189_MemorialLobby_3_1","category":"lobby","text":"不是，看着很有趣才怪呢。","text_original":"いや、面白そうだからじゃないわよ。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_3_1.ogg"},{"description":"CH0189_MemorialLobby_3_2","category":"lobby","text":"老师，不要拿别人开玩笑。","text_original":"先生、人で遊ばないで。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_3_2.ogg"},{"description":"CH0189_MemorialLobby_4_1","category":"lobby","text":"……哈。也无所谓啦。毕竟老师就是那样的人呢。","text_original":"……はあ。もういいわよ。先生はそういう人だったわね。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_4_1.ogg"},{"description":"CH0189_MemorialLobby_4_2","category":"lobby","text":"我早该预料到老师会这么做的……。","text_original":"こういう事するって予想できてたはずなのに……","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_4_2.ogg"},{"description":"CH0189_MemorialLobby_5_1","category":"lobby","text":"那好吧。我也刚好想到一个好点子。","text_original":"まぁいいわ。私もちょっと思いついたことがあるから。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_5_1.ogg"},{"description":"CH0189_MemorialLobby_5_2","category":"lobby","text":"来吧，老师！交换！！该老师上来了哦！","text_original":"さあ、先生！交代よ！！今度は先生の番よ！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_MemorialLobby_5_2.ogg"},{"description":"CH0189_Relationship_Up_1","category":"growup","text":"嗯。我现在，非常开心哦，老师。","text_original":"うん。今、すごく楽しいよ、先生。 ","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Relationship_Up_1.ogg"},{"description":"CH0189_Relationship_Up_2","category":"growup","text":"我要拼尽全力地去玩，要是出了什么问题老师要阻止哦！","text_original":"全力で楽しんでやるんだから、何かあったら先生が止めてよね！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Relationship_Up_2.ogg"},{"description":"CH0189_Relationship_Up_3","category":"growup","text":"好像还是第一次有这样的感觉。","text_original":"この感じ、なんだか初めてかも。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Relationship_Up_3.ogg"},{"description":"CH0189_Relationship_Up_4","category":"growup","text":"老，老师，那个，这个……一，一起游泳去吧？","text_original":"せ、先生、あの、その…いっ、一緒に、水泳でもする？","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Relationship_Up_4.ogg"},{"description":"CH0189_Season_Birthday_1_1","category":"lobby","text":"我的生日……？这样啊……今天一整天都一起……！","text_original":"私の誕生日……？そうね……今日1日ずっと一緒に……！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Season_Birthday_1_1.ogg"},{"description":"CH0189_Season_Birthday_1_2","category":"lobby","text":"……干些什么呢？","text_original":"……何しようかしらね？","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Season_Birthday_1_2.ogg"},{"description":"CH0189_Season_Birthday_Player","category":"lobby","text":"Happy Birthday！一起去玩吧！","text_original":"ハッピーバースデー！一緒に遊びましょう！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Season_Birthday_Player.ogg"},{"description":"CH0189_Season_Halloween","category":"lobby","text":"万圣节！？泳装可不是扮装！？虽然根据看法也可能是啦……！","text_original":"ハロウィーン！？水着は仮装じゃないわよ！？見方によってはそうかもしれないけど……！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Season_Halloween.ogg"},{"description":"CH0189_Season_NewYear","category":"lobby","text":"虽然我也有新年的服装……算了无所谓。新年快乐，老师！","text_original":"新年の格好もあった気がするけど……まぁいっか。あけましておめでとう、先生。","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Season_NewYear.ogg"},{"description":"CH0189_Season_Xmas","category":"lobby","text":"今年我有没有当个好孩子呢……老、老师……你觉得呢？","text_original":"今年一年、私は良い子だったかな…………せ、先生……どう？","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Season_Xmas.ogg"},{"description":"CH0189_Title","category":"lobby","text":"蔚蓝档案！","text_original":"ブルーアーカイブ！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/CH0189_Title.ogg"},{"description":"ch0189_formation_in_2","category":"formation","text":"","text_original":"さっさと行くわよ！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/jp/ch0189_formation_in_2.ogg"},{"description":"ch0189_formation_in_1","category":"formation","text":"","text_original":"迷っている暇は無いわよ！","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/jp/ch0189_formation_in_1.ogg"}],"voice_cn":[{"description":"ch0189_cafe_monolog_1","category":"cafe","text":"嗯……大家看起来都很忙啊。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_cafe_monolog_1.ogg"},{"description":"ch0189_cafe_monolog_2","category":"cafe","text":"突然好想玩水枪大战啊。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_cafe_monolog_2.ogg"},{"description":"ch0189_cafe_monolog_3","category":"cafe","text":"想吃点烤串吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_cafe_monolog_3.ogg"},{"description":"ch0189_cafe_monolog_4","category":"cafe","text":"……先打扫一下吧？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_cafe_monolog_4.ogg"},{"description":"ch0189_cafe_monolog_5","category":"cafe","text":"呼……好凉快。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_cafe_monolog_5.ogg"},{"description":"ch0189_commonskill","category":"battle","text":"接着——！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_commonskill.ogg"},{"description":"ch0189_eventlobby_1","category":"event","text":"嗯？怎么了？还有什么事情要做吗？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_eventlobby_1.ogg"},{"description":"ch0189_eventlobby_2","category":"event","text":"老师……你在干嘛呀？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_eventlobby_2.ogg"},{"description":"ch0189_eventlobby_3","category":"event","text":"我说……你玩得好像很开心嘛，嗯","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_eventlobby_3.ogg"},{"description":"ch0189_eventlobby_4","category":"event","text":"……别整这些没用的了！看看时间，干正事吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_eventlobby_4.ogg"},{"description":"ch0189_eventlogin_1","category":"event","text":"快，老师！没时间耽误了！赶紧出发吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_eventlogin_1.ogg"},{"description":"ch0189_eventlogin_2","category":"event","text":"啊，老师！这边这边~！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_eventlogin_2.ogg"},{"description":"ch0189_exskill_1","category":"battle","text":"呼，好开心……呃，呃啊？！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_exskill_1.ogg"},{"description":"ch0189_exskill_2","category":"battle","text":"老师~！咿啊？！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_exskill_2.ogg"},{"description":"ch0189_exskill_3","category":"battle","text":"没想到还不……错呜哇啊啊啊？！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_exskill_3.ogg"},{"description":"ch0189_exskill_level_1","category":"battle","text":"脱手了，小心啊——！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_exskill_level_1.ogg"},{"description":"ch0189_exskill_level_2","category":"battle","text":"要飞出去了呀——！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_exskill_level_2.ogg"},{"description":"ch0189_exskill_level_3","category":"battle","text":"闪开——！！\"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_exskill_level_3.ogg"},{"description":"ch0189_exweapon_get","category":"growup","text":"光顾着玩也没关系吗……既，既然老师说了没问题！那你可要负责到底啊！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_exweapon_get.ogg"},{"description":"ch0189_gachaget","category":"growup","text":"我要把它变成“最棒的假期”！决不妥协！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_gachaget.ogg"},{"description":"ch0189_growup_1","category":"growup","text":"那个……玩得是挺开心的……但是真的可以吗……？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_growup_1.ogg"},{"description":"ch0189_growup_2","category":"growup","text":"好啦好啦~那这次我就不客气啦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_growup_2.ogg"},{"description":"ch0189_growup_3","category":"growup","text":"老师其实也想玩吧？不用说我也知道！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_growup_3.ogg"},{"description":"ch0189_growup_4","category":"growup","text":"想玩水枪大战是吗？我知道了！看我的吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_growup_4.ogg"},{"description":"ch0189_lobby_1","category":"lobby","text":"还是海边凉快啊！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_lobby_1.ogg"},{"description":"ch0189_lobby_2","category":"lobby","text":"大家一起来玩……真是太开心了。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_lobby_2.ogg"},{"description":"ch0189_lobby_3","category":"lobby","text":"既然要玩，就要玩得尽兴才不会后悔！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_lobby_3.ogg"},{"description":"ch0189_lobby_4","category":"lobby","text":"哈啊……累死了……不，不行！时间用来休息就太浪费了！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_lobby_4.ogg"},{"description":"ch0189_lobby_5","category":"lobby","text":"老师……那个……我穿这身泳装，老师觉得怎么样？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_lobby_5.ogg"},{"description":"ch0189_login_1","category":"lobby","text":"老师快进来！这里可凉快啦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_login_1.ogg"},{"description":"ch0189_login_2","category":"lobby","text":"也太慢了吧，老师！知道我等了多久嘛？！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_login_2.ogg"},{"description":"ch0189_memoriallobby_1_1","category":"lobby","text":"测试到这个程度","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_1_1.ogg"},{"description":"ch0189_memoriallobby_1_2","category":"lobby","text":"测，测试到这个程度就可以了吧？我差不多也该下船了……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_1_2.ogg"},{"description":"ch0189_memoriallobby_2_1","category":"lobby","text":"等，等一下！！老师干什么！这样很晃诶！！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_2_1.ogg"},{"description":"ch0189_memoriallobby_2_2","category":"lobby","text":"再，再这样下去，这船很容易侧翻的！！呜哇！别闹啦！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_2_2.ogg"},{"description":"ch0189_memoriallobby_3_1","category":"lobby","text":"不是，有趣个头啦。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_3_1.ogg"},{"description":"ch0189_memoriallobby_3_2","category":"lobby","text":"老师，不要把别人当玩具耍好不好。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_3_2.ogg"},{"description":"ch0189_memoriallobby_4_1","category":"lobby","text":"……哎，算了。反正老师本来就是这种人。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_4_1.ogg"},{"description":"ch0189_memoriallobby_4_2","category":"lobby","text":"我早该想到会变成这样的……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_4_2.ogg"},{"description":"ch0189_memoriallobby_5_1","category":"lobby","text":"哼，可以。我也有的是办法来治你。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_5_1.ogg"},{"description":"ch0189_memoriallobby_5_2","category":"lobby","text":"好了，老师！交换时间到！！这回轮到老师了！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_memoriallobby_5_2.ogg"},{"description":"ch0189_relationship_up_1","category":"growup","text":"……嗯，我现在超级开心，老师。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_relationship_up_1.ogg"},{"description":"ch0189_relationship_up_2","category":"growup","text":"我会玩个痛快的！但要是过头了，老师可得拦着我啊！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_relationship_up_2.ogg"},{"description":"ch0189_relationship_up_3","category":"growup","text":"这种感觉……仔细想想还是第一次呢。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_relationship_up_3.ogg"},{"description":"ch0189_relationship_up_4","category":"growup","text":"老，老师……那，那个……要，要不要……一起游泳……？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_relationship_up_4.ogg"},{"description":"ch0189_season_birthday_1_1","category":"lobby","text":"我的，生日……？对哦……那今天一整天都要陪我哦……！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_season_birthday_1_1.ogg"},{"description":"ch0189_season_birthday_1_2","category":"lobby","text":"……玩点什么好呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_season_birthday_1_2.ogg"},{"description":"ch0189_season_birthday_player","category":"lobby","text":"生日快乐！老师！一起来玩吧！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_season_birthday_player.ogg"},{"description":"ch0189_season_chinesenewyear","category":"lobby","text":"这么多！哪来的钱？！——压岁钱呀，谢谢老师！太好了……这样学院的债再过多少年能还清呢……算了，还不如不算……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_season_chinesenewyear.ogg"},{"description":"ch0189_season_halloween","category":"lobby","text":"万圣节？！我这可不是万圣节的衣服呀！呃……好像也可以是……！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_season_halloween.ogg"},{"description":"ch0189_season_midautumn","category":"lobby","text":"……嗯……老师……今天晚上有空的话，来一下度假村的海边吧。别乱想哦！没什么特别的事情！真的！就，就是看看月亮……散散步……","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_season_midautumn.ogg"},{"description":"ch0189_season_newyear","category":"lobby","text":"其实我本来还准备了新年的衣服来着……算了没事，新年快乐噢，老师。","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_season_newyear.ogg"},{"description":"ch0189_season_xmas","category":"lobby","text":"过去这一年，我算是个好孩子吗…………老，老师……觉得呢？","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_season_xmas.ogg"},{"description":"ch0189_title","category":"lobby","text":"blue archive！","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/cn/ch0189_title.ogg"}],"voice_kr":[{"description":"ch0189_cafe_monolog_1","category":"cafe","text":"","text_original":"","file":"//static.kivo.wiki/voices/students/%E9%BB%91%E8%A7%81%20%E8%8A%B9%E9%A6%99/%E6%B3%B3%E8%A3%85/kr/ch0189_cafe_monolog_1.ogg"},{"description":"ch0189_cafe_monolog_2","category":"cafe","text":"","text_original":"","file":"//static.kivo.wiki/vo